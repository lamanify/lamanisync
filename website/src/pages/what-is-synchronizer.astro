---
import Layout from '../layouts/Layout.astro';
import CtaBanner from '../components/CtaBanner.astro';
---

<Layout
  title="What is Synchronizer? | LamaniSync Universal Healthcare Bridge"
  description="Learn how LamaniSync functions as a universal translation layer connecting any Clinic Management System (Dentrix, eClinicalWorks, LamaniPulse) to LamaniHub and Sara AI WhatsApp automation."
>
  <!-- Hero Section -->
  <section class="sync-hero">
    <div class="bg-grid-pattern"></div>
    <div class="hero-glow"></div>
    <div class="container hero-content">
      <div class="attio-badge crimson">
        <svg style="width:12px; height:12px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
        <span>The Universal Translation Layer</span>
      </div>
      <h1 class="hero-title">
        <span class="heading-dark">What is LamaniSync?</span><br />
        <span class="heading-muted">The universal translation layer for modern clinics.</span>
      </h1>
      <p class="hero-subtitle">
        LamaniSync connects your existing Clinic Management System (Dentrix, eClinicalWorks, LamaniPulse) directly to LamaniHub and Sara AI WhatsApp booking automation in real time. Zero local server installation, zero open firewall ports, and 100% readback-verified.
      </p>

      <div class="hero-actions">
        <a href="#architecture" class="btn-primary">
          <span>Explore Architecture</span>
          <svg style="width:14px; height:14px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="#domains" class="btn-secondary">
          <span>The 4 Data Domains</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Interactive Topology Canvas -->
  <section class="canvas-section" id="architecture">
    <div class="container">
      <div class="sync-canvas">
        <div class="sync-canvas-header">
          <div class="sync-canvas-dots">
            <span class="mac-dot red"></span>
            <span class="mac-dot yellow"></span>
            <span class="mac-dot green"></span>
          </div>
          <div class="sync-canvas-title">
            <svg style="width:14px; height:14px; color: var(--primary);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            <span>Universal End-to-End Execution Pipeline</span>
          </div>
          <div class="sync-canvas-status">
            <span class="ping-circle"></span>
            <span>Real-time Active Bridge</span>
          </div>
        </div>

        <div class="pipeline-flow">
          <!-- Stage 1 -->
          <div class="flow-card">
            <div class="step-num">01</div>
            <div class="flow-icon wa">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
            </div>
            <h4>Patient Chat</h4>
            <p>Patient requests appointment with Sara AI on WhatsApp 24/7</p>
            <span class="flow-tag">Natural Language</span>
          </div>

          <div class="flow-arrow">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>

          <!-- Stage 2 -->
          <div class="flow-card">
            <div class="step-num">02</div>
            <div class="flow-icon ai">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a10 10 0 1 0 10 10H12V2z"/><path d="M12 12 2.1 12.05"/></svg>
            </div>
            <h4>Sara AI Engine</h4>
            <p>Triages symptoms, chooses treatment, queries real-time availability</p>
            <span class="flow-tag">LamaniHub Cloud</span>
          </div>

          <div class="flow-arrow">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>

          <!-- Stage 3 -->
          <div class="flow-card highlight">
            <div class="step-num">03</div>
            <div class="flow-icon bridge">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
            </div>
            <h4>LamaniSync MV3</h4>
            <p>Translates canonical slot intent into native CMS DOM / RPC recipe</p>
            <span class="flow-tag active">Workstation Bridge</span>
          </div>

          <div class="flow-arrow">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>

          <!-- Stage 4 -->
          <div class="flow-card">
            <div class="step-num">04</div>
            <div class="flow-icon cms">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
            </div>
            <h4>Primary CMS</h4>
            <p>Writes booking directly into Dentrix, eCW, or LamaniPulse calendar</p>
            <span class="flow-tag">Staff Authenticated</span>
          </div>

          <div class="flow-arrow">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>

          <!-- Stage 5 -->
          <div class="flow-card verified">
            <div class="step-num">05</div>
            <div class="flow-icon check">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <h4>Readback Verified</h4>
            <p>Reads back record from calendar; delivers confirmed WhatsApp receipt</p>
            <span class="flow-tag verified">100% Guaranteed</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Deep Architecture Breakdown: MV3 vs Local Server -->
  <section class="section">
    <div class="container">
      <div class="section-head text-center">
        <div class="attio-badge crimson">
          <span>Architectural Paradigm</span>
        </div>
        <h2 class="section-title">
          <span class="heading-dark">Workstation MV3 Bridge</span>
          <span class="heading-muted">vs Legacy On-Premise Server.</span>
        </h2>
        <p class="section-desc">
          Why running in-browser with Chrome Manifest V3 isolation outperforms fragile Windows background services, open firewall ports, and direct SQL connectors.
        </p>
      </div>

      <div class="comparison-grid">
        <!-- Legacy Way -->
        <div class="comparison-card legacy">
          <div class="card-status-badge bad">Legacy On-Premise Integrations</div>
          <h3 class="card-heading">The Fragile Local Server Approach</h3>
          <p class="card-sub">Used by 20-year-old integrators: installs heavy Windows services with elevated system privileges.</p>

          <ul class="spec-list">
            <li>
              <div class="spec-icon bad">✕</div>
              <div>
                <strong>Invasive Administrator Privileges</strong>
                <p>Requires running as NT AUTHORITY\SYSTEM with full machine disk and network permissions.</p>
              </div>
            </li>
            <li>
              <div class="spec-icon bad">✕</div>
              <div>
                <strong>Dangerous Open Inbound Ports</strong>
                <p>Demands router port forwarding (e.g. 1433/3306) and static IP configuration, exposing clinic LANs to ransomware.</p>
              </div>
            </li>
            <li>
              <div class="spec-icon bad">✕</div>
              <div>
                <strong>Silent Service Crashes</strong>
                <p>Windows updates, anti-virus quarantines, and sleep states silently terminate background sync without notice.</p>
              </div>
            </li>
            <li>
              <div class="spec-icon bad">✕</div>
              <div>
                <strong>Unchecked Direct SQL Injection</strong>
                <p>Writing directly to raw database tables bypasses CMS business validation and risks corrupting patient ledgers.</p>
              </div>
            </li>
          </ul>
        </div>

        <!-- LamaniSync Modern Way -->
        <div class="comparison-card modern">
          <div class="card-status-badge good">The LamaniSync Standard</div>
          <h3 class="card-heading">The Ambient Workstation Bridge (MV3)</h3>
          <p class="card-sub">Runs inside Google Chrome on the exact workstation your reception team already uses every day.</p>

          <ul class="spec-list">
            <li>
              <div class="spec-icon good">✓</div>
              <div>
                <strong>Sandboxed User-Space Execution</strong>
                <p>Zero admin rights needed. Runs in Chrome's sandboxed environment with strict origin boundaries.</p>
              </div>
            </li>
            <li>
              <div class="spec-icon good">✓</div>
              <div>
                <strong>Zero Inbound Firewall Ports</strong>
                <p>All traffic is strictly outbound encrypted TLS / WSS. Fully invisible to external network port scanners.</p>
              </div>
            </li>
            <li>
              <div class="spec-icon good">✓</div>
              <div>
                <strong>Ephemeral Service Worker Architecture</strong>
                <p>Consumes zero memory when idle. Auto-resumes instantaneously on incoming sync leases or calendar mutations.</p>
              </div>
            </li>
            <li>
              <div class="spec-icon good">✓</div>
              <div>
                <strong>Native Application Layer Writes</strong>
                <p>Executes through your CMS's validated frontend layer, preserving all internal billing, doctor, and operatory rules.</p>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- The 4 Core Data Domains -->
  <section class="section bg-light" id="domains">
    <div class="container">
      <div class="section-head">
        <div class="attio-badge blue">
          <span>Data Taxonomy</span>
        </div>
        <h2 class="section-title">
          <span class="heading-dark">The 4 Core Data Domains</span>
          <span class="heading-muted">orchestrated by LamaniSync.</span>
        </h2>
        <p class="section-desc">
          LamaniSync standardizes messy, proprietary clinic software records into four canonical operational data streams.
        </p>
      </div>

      <div class="domains-grid">
        <!-- Domain 1 -->
        <div class="domain-card">
          <div class="domain-icon-box">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <span class="domain-number">Domain 01</span>
          <h3 class="domain-title">Operatory & Chair Logistics</h3>
          <p class="domain-text">
            Physical clinics are constrained by surgical chairs, room equipment, and doctor rosters. LamaniSync continuously models room capacity, chair suction/laser tooling capabilities, doctor shifts, and sanitization intervals.
          </p>
          <div class="domain-pills">
            <span>Operatory Mapping</span>
            <span>Chair Constraints</span>
            <span>Turnaround Buffers</span>
          </div>
        </div>

        <!-- Domain 2 -->
        <div class="domain-card">
          <div class="domain-icon-box">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </div>
          <span class="domain-number">Domain 02</span>
          <h3 class="domain-title">Real-Time Slot Availability</h3>
          <p class="domain-text">
            Sub-second availability querying without polling lag. LamaniSync queries the live calendar grid directly from your staff-authenticated CMS tab, instantly accounting for walk-ins, emergency holds, and sudden schedule changes.
          </p>
          <div class="domain-pills">
            <span>Sub-Second Probing</span>
            <span>Zero Double-Booking</span>
            <span>Dynamic Gap Filling</span>
          </div>
        </div>

        <!-- Domain 3 -->
        <div class="domain-card">
          <div class="domain-icon-box">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          </div>
          <span class="domain-number">Domain 03</span>
          <h3 class="domain-title">Sara AI WhatsApp Bookings</h3>
          <p class="domain-text">
            Sara AI on LamaniHub handles patient conversations 24/7 on WhatsApp in natural English, Bahasa Malaysia, and Chinese. Patient intake, triage questionnaires, and slot selections are converted automatically into verified CMS calendar writes.
          </p>
          <div class="domain-pills">
            <span>24/7 Autonomous Triage</span>
            <span>Multilingual Intake</span>
            <span>WhatsApp Confirmation</span>
          </div>
        </div>

        <!-- Domain 4 -->
        <div class="domain-card">
          <div class="domain-icon-box">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
          </div>
          <span class="domain-number">Domain 04</span>
          <h3 class="domain-title">Readback Verification</h3>
          <p class="domain-text">
            The unbreakable guarantee. LamaniSync never confirms a booking to a patient until an independent probe reads the appointment back from the primary CMS calendar. No ghost bookings, zero dropped writes, 100% confidence.
          </p>
          <div class="domain-pills">
            <span>Read-After-Write</span>
            <span>Signed Audit Receipts</span>
            <span>Zero Ghost Appointments</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Supported CMS Deployments -->
  <section class="section">
    <div class="container">
      <div class="section-head text-center">
        <div class="attio-badge crimson">
          <span>Universal Deployment</span>
        </div>
        <h2 class="section-title">
          <span class="heading-dark">Works with Any Web-Based CMS</span><br />
          <span class="heading-muted">Cloud SaaS, Local Intranets, and Legacy Web Portals.</span>
        </h2>
        <p class="section-desc">
          Because LamaniSync bridges at the browser presentation layer, it seamlessly supports every architecture style.
        </p>
      </div>

      <div class="deploy-grid">
        <div class="deploy-card">
          <div class="deploy-tag">Architecture 01</div>
          <h3>Modern Cloud SaaS EHRs</h3>
          <p>Dentrix Ascend, eClinicalWorks Cloud, Curve Dental, and modern cloud healthcare platforms.</p>
          <ul class="check-items">
            <li>Immediate DOM / RPC recipe injection</li>
            <li>Zero local IT infrastructure</li>
            <li>Works from any clinic Mac or PC</li>
          </ul>
        </div>

        <div class="deploy-card">
          <div class="deploy-tag">Architecture 02</div>
          <h3>Local On-Premise Web Servers</h3>
          <p>Clinic systems hosted on local clinic server boxes (e.g. <code>http://192.168.1.100:8080</code>).</p>
          <ul class="check-items">
            <li>No public IP or port forwarding required</li>
            <li>Bridges via receptionist's Chrome browser</li>
            <li>Zero external firewall configuration</li>
          </ul>
        </div>

        <div class="deploy-card">
          <div class="deploy-tag">Architecture 03</div>
          <h3>Hybrid Portals & LamaniPulse</h3>
          <p>Custom proprietary web portals, regional EHRs, and LamaniPulse EHR native clinical modules.</p>
          <ul class="check-items">
            <li>Custom adapter generated in under 48 hours</li>
            <li>Multi-branch workstation lease failover</li>
            <li>Zero-PHI in-memory compliance</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <CtaBanner />
</Layout>

<style>
  .sync-hero {
    position: relative;
    padding: 5rem 0 3.5rem 0;
    overflow: hidden;
    background: #ffffff;
  }

  .hero-glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: min(700px, 100%);
    max-width: 100%;
    height: 380px;
    background: radial-gradient(circle, rgba(15, 23, 42, 0.025) 0%, rgba(255, 255, 255, 0) 70%);
    pointer-events: none;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .hero-title {
    font-size: clamp(1.9rem, 4.5vw, 3.8rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-top: 1.25rem;
    margin-bottom: 1.25rem;
    max-width: 900px;
    overflow-wrap: break-word;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 720px;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  /* Topology Canvas */
  .canvas-section {
    padding: 1.5rem 0 4rem 0;
  }

  .sync-canvas {
    background: #ffffff;
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-container);
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
    overflow: hidden;
  }

  .sync-canvas-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1.25rem;
    background: #fafafa;
    border-bottom: 1px solid var(--border-hairline);
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .sync-canvas-dots {
    display: flex;
    gap: 6px;
  }

  .mac-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .mac-dot.red { background: #ff5f56; }
  .mac-dot.yellow { background: #ffbd2e; }
  .mac-dot.green { background: #27c93f; }

  .sync-canvas-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: #334155;
  }

  .sync-canvas-status {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.74rem;
    font-weight: 600;
    color: #10b981;
    background: #ecfdf5;
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    border: 1px solid #d1fae5;
  }

  .ping-circle {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10b981;
  }

  .pipeline-flow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 2.5rem 1.5rem;
    gap: 0.75rem;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .flow-card {
    flex: 1;
    min-width: 180px;
    background: #ffffff;
    border: 1px solid var(--border-hairline);
    border-radius: 14px;
    padding: 1.25rem 1rem;
    text-align: center;
    position: relative;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
  }

  .flow-card.highlight {
    border-color: var(--primary);
    background: #ffffff;
    box-shadow: 0 4px 16px rgba(233, 36, 81, 0.08);
  }

  .flow-card.verified {
    border-color: #10b981;
    background: #f0fdf4;
  }

  .step-num {
    position: absolute;
    top: 8px;
    left: 10px;
    font-size: 0.7rem;
    font-weight: 800;
    color: #94a3b8;
  }

  .flow-icon {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0.25rem auto 0.75rem auto;
    background: #f8fafc;
    border: 1px solid var(--border-hairline);
    color: var(--text-main);
  }

  .flow-icon svg {
    width: 22px;
    height: 22px;
  }

  .flow-icon.wa { background: #f8fafc; color: #0f172a; }
  .flow-icon.ai { background: #f8fafc; color: #0f172a; }
  .flow-icon.bridge { background: #fff1f3; border-color: #fecdd6; color: var(--primary); }
  .flow-icon.cms { background: #f8fafc; color: #0f172a; }
  .flow-icon.check { background: #f0fdf4; border-color: #dcfce7; color: #166534; }

  .flow-card h4 {
    font-size: 0.92rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 0.35rem;
  }

  .flow-card p {
    font-size: 0.76rem;
    color: var(--text-muted);
    line-height: 1.4;
    margin-bottom: 0.75rem;
  }

  .flow-tag {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 600;
    background: #f8fafc;
    border: 1px solid var(--border-hairline);
    color: #475569;
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
  }

  .flow-tag.active {
    background: #fff1f3;
    border-color: #fecdd6;
    color: var(--primary);
  }

  .flow-tag.verified {
    background: #f0fdf4;
    border-color: #dcfce7;
    color: #166534;
  }

  .flow-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #94a3b8;
    flex-shrink: 0;
  }

  .flow-arrow svg {
    width: 20px;
    height: 20px;
  }

  /* Section Headings */
  .section {
    padding: 5rem 0;
  }

  .section.bg-light {
    background: #fafafa;
    border-top: 1px solid var(--border-hairline);
    border-bottom: 1px solid var(--border-hairline);
  }

  .section-head {
    margin-bottom: 3.5rem;
  }

  .section-head.text-center {
    text-align: center;
  }

  .section-head.text-center .attio-badge {
    margin-bottom: 1rem;
  }

  .section-title {
    font-size: clamp(1.8rem, 3.2vw, 2.75rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.025em;
    margin-bottom: 1rem;
  }

  .section-desc {
    font-size: 1.05rem;
    color: var(--text-muted);
    max-width: 680px;
    line-height: 1.6;
    margin: 0 auto;
  }

  /* Comparison Grid */
  .comparison-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .comparison-card {
    background: #ffffff;
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-container);
    padding: 2.5rem 2rem;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.02);
  }

  .comparison-card.modern {
    border-color: var(--border-hairline);
    background: #ffffff;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.04);
  }

  .card-status-badge {
    display: inline-block;
    font-size: 0.74rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.3rem 0.75rem;
    border-radius: 6px;
    margin-bottom: 1.25rem;
  }

  .card-status-badge.bad {
    background: #fef2f2;
    color: #991b1b;
    border: 1px solid #fee2e2;
  }

  .card-status-badge.good {
