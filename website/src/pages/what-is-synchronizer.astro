---
import Layout from '../layouts/Layout.astro';
import CtaBanner from '../components/CtaBanner.astro';

const domains = [
  {
    num: "01",
    title: "Appointment Schedules & Calendar Slots",
    desc: "Bi-directional slot availability, chair allocation, emergency holds, and practitioner rosters synchronized in sub-seconds."
  },
  {
    num: "02",
    title: "Patient Intake & Demographic Profiles",
    desc: "National ID numbers, WhatsApp contact, emergency contacts, and demographic intake written directly to clinic charts."
  },
  {
    num: "03",
    title: "Operatory & Doctor Chair Logistics",
    desc: "Physical chair availability, operatory turnaround buffers, and specialist room assignments managed automatically."
  },
  {
    num: "04",
    title: "Audit Records & Readback Logs",
    desc: "Cryptographic SHA-256 state hashing and two-step verification receipts logged for complete medical auditability."
  }
];
---

<Layout
  title="What is Synchronizer? | LamaniSync Universal Healthcare Bridge"
  description="Learn how LamaniSync functions as a universal translation layer connecting any Clinic Management System (Dentrix, eClinicalWorks, LamaniPulse) to LamaniHub WhatsApp automation."
>
  <section class="attio-section border-t border-subtle">
    <div class="attio-container border-x border-subtle">
      <header class="attio-section-head">
        <div class="attio-head-inner">
          <h1 class="attio-h2-inline">
            <span class="text-primary">What is LamaniSync?</span>
            <span class="text-muted font-normal"> The universal translation layer for modern clinic workflows.</span>
          </h1>
          <p class="attio-lead-desc">
            LamaniSync connects your existing Clinic Management System (Dentrix, eClinicalWorks, LamaniPulse, Kreloses) directly to LamaniHub WhatsApp booking automation in real time. Zero local server installation, zero open firewall ports, and 100% readback-verified.
          </p>
          <div class="hero-actions-wrap">
            <a href="#architecture" class="btn-dark-primary">Explore architecture</a>
            <a href="#domains" class="btn-dark-secondary">The 4 Data Domains</a>
          </div>
        </div>
      </header>

      <div class="attio-separator-wrap">
        <div class="attio-dashed-line"></div>
      </div>
    </div>
  </section>

  <!-- Architecture Comparison Section -->
  <section class="attio-section shaded-bg" id="architecture">
    <div class="attio-container border-x border-subtle">
      <header class="attio-section-head">
        <div class="attio-head-inner">
          <h2 class="attio-h2-inline">
            <span class="text-primary">Workstation bridge vs legacy server.</span>
            <span class="text-muted font-normal"> Why ambient browser execution eliminates maintenance downtime.</span>
          </h2>
          <p class="attio-lead-desc">
            Legacy healthcare integrations rely on dedicated server boxes, open inbound ports, and brittle VPN tunnels. LamaniSync shifts execution entirely into the browser session staff already use.
          </p>
        </div>
      </header>

      <div class="attio-separator-wrap">
        <div class="attio-dashed-line"></div>
      </div>

      <div class="attio-hatch-container">
        <div class="attio-hatch-bg" aria-hidden="true"></div>
        <div class="attio-grid-wrap">
          <div class="compare-grid">
            <div class="compare-card legacy">
              <div class="card-tag">[LEGACY LOCAL SERVER]</div>
              <h3 class="card-title">Fragile On-Premise Infrastructure</h3>
              <ul class="compare-list">
                <li>❌ Requires dedicated physical server or constantly running PC</li>
                <li>❌ Inbound firewall ports exposed to the public internet</li>
                <li>❌ Expensive IT consultant deployment and VPN management</li>
                <li>❌ Breaks completely when clinic IP or DNS leases renew</li>
                <li>❌ Blind write execution with zero UI verification</li>
              </ul>
            </div>

            <div class="compare-card modern">
              <div class="card-tag active">[LAMANISYNC MV3 BRIDGE]</div>
              <h3 class="card-title">Ambient Workstation Execution</h3>
              <ul class="compare-list">
                <li>✅ Runs seamlessly inside Google Chrome on front-desk PCs</li>
                <li>✅ Zero open inbound ports; 100% outbound encrypted WSS tunnels</li>
                <li>✅ 60-second setup by receptionist without IT assistance</li>
                <li>✅ Automatic multi-workstation failover redundancy</li>
                <li>✅ Dual-phase readback verification guarantees zero phantom slots</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 Data Domains Section -->
  <section class="attio-section border-t border-subtle" id="domains">
    <div class="attio-container border-x border-subtle">
      <header class="attio-section-head">
        <div class="attio-head-inner">
          <h2 class="attio-h2-inline">
            <span class="text-primary">The 4 core data domains.</span>
            <span class="text-muted font-normal"> Orchestrated and validated across your clinic software.</span>
          </h2>
          <p class="attio-lead-desc">
            From patient demographic profiles to physical operatory chair availability, LamaniSync enforces strict data boundaries.
          </p>
        </div>
      </header>

      <div class="attio-separator-wrap">
        <div class="attio-dashed-line"></div>
      </div>

      <div class="domains-grid">
        {domains.map((d) => (
          <div class="domain-card">
            <div class="domain-num">[{d.num}]</div>
            <h3 class="domain-title">{d.title}</h3>
            <p class="domain-desc">{d.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBanner />
</Layout>

<style>
  .border-t { border-top: 1px solid #e2e8f0; }
  .border-x { border-left: 1px solid #e2e8f0; border-right: 1px solid #e2e8f0; }
  .border-subtle { border-color: #e2e8f0; }

  .attio-section { background: #ffffff; position: relative; }
  .attio-section.shaded-bg { background: #fafafa; }
  .attio-container { max-width: 1200px; margin: 0 auto; position: relative; background: #ffffff; }

  .attio-section-head { padding: 6rem 3.5rem 3rem 3.5rem; background: #ffffff; }
  .attio-head-inner { max-width: 860px; }

  .attio-h2-inline {
    font-size: clamp(2rem, 3.8vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0 0 1.25rem 0;
    text-wrap: balance;
  }
  .text-primary { color: #1c1d1f; }
  .text-muted { color: #6f7988; }
  .attio-lead-desc { font-size: 1.0625rem; color: #6f7988; line-height: 1.6; margin: 0; max-width: 680px; }

  .hero-actions-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .btn-dark-primary {
    background: #1c1d1f;
    border: 1px solid #1c1d1f;
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.6rem 1.25rem;
    border-radius: 6px;
    text-decoration: none;
    transition: background 0.15s ease;
  }
  .btn-dark-primary:hover { background: #000000; }

  .btn-dark-secondary {
    background: transparent;
    border: 1px solid #e2e8f0;
    color: #1c1d1f;
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.6rem 1.25rem;
    border-radius: 6px;
    text-decoration: none;
    transition: background 0.15s ease;
  }
  .btn-dark-secondary:hover { background: #f8fafc; }

  .attio-separator-wrap { position: relative; width: 100%; height: 1px; background: #e2e8f0; }
  .attio-dashed-line {
    width: 100%;
    height: 1px;
    background-image: linear-gradient(to right, #cbd5e1 50%, transparent 50%);
    background-size: 8px 1px;
  }

  /* Hatch Container */
  .attio-hatch-container {
    position: relative;
    background-color: #fafafa;
    overflow: hidden;
    padding: 0 2rem;
  }
  .attio-hatch-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: repeating-linear-gradient(125deg, transparent, transparent 6px, rgba(15, 23, 42, 0.035) 6px, rgba(15, 23, 42, 0.035) 7px);
  }
  .attio-grid-wrap {
    position: relative;
    z-index: 1;
    border-left: 1px solid #e2e8f0;
    border-right: 1px solid #e2e8f0;
  }

  .compare-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: #e2e8f0;
  }
  .compare-card {
    background: #ffffff;
    padding: 3.5rem 2.5rem;
  }
  .card-tag {
    font-size: 0.75rem;
    font-weight: 600;
    color: #94a3b8;
    font-family: ui-monospace, SFMono-Regular, monospace;
    letter-spacing: 0.08em;
    margin-bottom: 1.5rem;
  }
  .card-tag.active { color: #15803d; }
  .card-title {
    font-size: 1.25rem;
    font-weight: 500;
    color: #1c1d1f;
    letter-spacing: -0.015em;
    margin-bottom: 1.5rem;
  }
  .compare-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    font-size: 0.88rem;
    color: #475569;
    line-height: 1.5;
  }

  /* Domains Grid */
  .domains-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: #e2e8f0;
  }
  .domain-card {
    background: #ffffff;
    padding: 3rem 2.5rem;
    display: flex;
    flex-direction: column;
    transition: background 0.15s ease;
  }
  .domain-card:hover { background: #fafafa; }
  .domain-num {
    font-size: 0.75rem;
    font-weight: 600;
    color: #94a3b8;
    letter-spacing: 0.08em;
    font-family: ui-monospace, SFMono-Regular, monospace;
    margin-bottom: 1.5rem;
  }
  .domain-title {
    font-size: 1.15rem;
    font-weight: 500;
    color: #1c1d1f;
    letter-spacing: -0.015em;
    margin-bottom: 0.75rem;
  }
  .domain-desc {
    font-size: 0.875rem;
    color: #6f7988;
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 900px) {
    .compare-grid { grid-template-columns: 1fr; }
    .domains-grid { grid-template-columns: 1fr; }
    .attio-section-head { padding: 4rem 1.5rem 2.5rem 1.5rem; }
    .attio-hatch-container { padding: 0 1rem; }
  }

  @media (max-width: 640px) {
    .attio-hatch-container { padding: 0; }
    .attio-grid-wrap { border-left: none; border-right: none; }
    .hero-actions-wrap { flex-direction: column; align-items: stretch; }
  }
</style>
