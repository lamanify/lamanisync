---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact Support & Clinical Integrations | LamaniSync"
  description="Need technical support, workstation pairing assistance, or a custom Clinic Management System adapter for LamaniSync? Contact our team."
>
  <section class="attio-section border-t border-subtle">
    <div class="attio-container border-x border-subtle">
      <header class="attio-section-head">
        <div class="attio-head-inner">
          <h1 class="attio-h2-inline">
            <span class="text-primary">How can we help your clinic?</span>
            <span class="text-muted font-normal"> Dedicated engineering and clinical workflow support.</span>
          </h1>
          <p class="attio-lead-desc">
            Whether you need help pairing your front-desk workstations or need a custom adapter built for your proprietary clinic software, our integration engineers are ready to help.
          </p>
        </div>
      </header>

      <div class="attio-separator-wrap">
        <div class="attio-dashed-line"></div>
      </div>

      <!-- Contact Body Grid with 1px Hairlines -->
      <div class="contact-main-grid">
        <!-- Left: Form -->
        <div class="contact-form-cell">
          <h3 class="form-title">Send a message to our clinical operations team</h3>
          <p class="form-desc">Fill out the details below. Inbound requests route directly to our engineering team.</p>

          <form id="contact-form" class="support-form">
            <div class="form-row">
              <div class="form-group">
                <label for="name">Your Name <span class="req">*</span></label>
                <input type="text" id="name" name="name" required placeholder="Dr. Siti Aminah / John Doe" />
              </div>
              <div class="form-group">
                <label for="email">Work Email <span class="req">*</span></label>
                <input type="email" id="email" name="email" required placeholder="doctor@clinic.com.my" />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="clinic">Clinic Name</label>
                <input type="text" id="clinic" name="clinic" placeholder="Klinik Perubatan Central" />
              </div>
              <div class="form-group">
                <label for="phone">Phone / WhatsApp</label>
                <input type="tel" id="phone" name="phone" placeholder="+60 12-345 6789" />
              </div>
            </div>

            <div class="form-group">
              <label for="cms">Current Clinic Management System (CMS)</label>
              <select id="cms" name="cms">
                <option value="kreloses">Kreloses</option>
                <option value="dentrix-ascend">Dentrix Ascend</option>
                <option value="eclinicalworks">eClinicalWorks</option>
                <option value="lamanipulse">LamaniPulse EHR</option>
                <option value="plato">Plato Medical</option>
                <option value="clinicmaster">Clinic Master</option>
                <option value="other">Other / Custom Web Portal</option>
              </select>
            </div>

            <div class="form-group">
              <label for="message">How can we assist? <span class="req">*</span></label>
              <textarea id="message" name="message" rows="4" required placeholder="Describe your clinic setup, workstation count, or custom adapter needs..."></textarea>
            </div>

            <button type="submit" id="submit-btn" class="btn-dark-primary full-width">
              <span>Send Message</span>
            </button>
            <div id="form-status" class="form-status"></div>
          </form>
        </div>

        <!-- Right: Telemetry & Contact Info -->
        <div class="contact-info-cell">
          <div class="info-block">
            <div class="info-tag">[OPERATIONS SINK]</div>
            <h4 class="info-title">Engineering Helpdesk</h4>
            <p class="info-text">Our engineers specialize in browser-level extensions and clinic interoperability.</p>
            <div class="info-meta"><code>support@lamanify.com</code></div>
          </div>

          <div class="info-block">
            <div class="info-tag">[COMMUNICATION]</div>
            <h4 class="info-title">Direct WhatsApp Support</h4>
            <p class="info-text">Active LamaniHub clinics can contact their dedicated account executive via priority WhatsApp group.</p>
            <div class="info-meta"><code>Priority 24/7 SLA for Emergency Holds</code></div>
          </div>

          <div class="info-block">
            <div class="info-tag">[COMPLIANCE & PRIVACY]</div>
            <h4 class="info-title">Zero-PHI Inbound Guarantee</h4>
            <p class="info-text">Please do not submit patient names, identity numbers, or medical records through this form.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const statusDiv = document.getElementById('form-status') as HTMLDivElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.innerText = 'Submitting...';

      const formData = new FormData(form);
      const payload = {
        name: formData.get('name'),
        email: formData.get('email'),
        clinic: formData.get('clinic'),
        phone: formData.get('phone'),
        cms: formData.get('cms'),
        message: formData.get('message'),
        source: 'lamanisync_contact'
      };

      try {
        const res = await fetch('https://n8n.automation.lamanify.com/webhook/lamanisync', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        if (res.ok) {
          statusDiv.innerText = '✓ Thank you. Your message has been routed to our clinical engineering team.';
          statusDiv.className = 'form-status success';
          form.reset();
        } else {
          throw new Error('Server returned ' + res.status);
        }
      } catch (err) {
        statusDiv.innerText = 'Unable to send message. Please email support@lamanify.com directly.';
        statusDiv.className = 'form-status error';
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerText = 'Send Message';
      }
    });
  }
</script>

<style>
  .border-t { border-top: 1px solid #e2e8f0; }
  .border-x { border-left: 1px solid #e2e8f0; border-right: 1px solid #e2e8f0; }
  .border-subtle { border-color: #e2e8f0; }

  .attio-section { background: #ffffff; position: relative; }
  .attio-container { max-width: 1200px; margin: 0 auto; position: relative; background: #ffffff; }

  .attio-section-head { padding: 6rem 3.5rem 3rem 3.5rem; background: #ffffff; }
  .attio-head-inner { max-width: 860px; }

  .attio-h2-inline {
    font-size: clamp(2rem, 3.8vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0 0 1.25rem 0;
    text-wrap: balance;
  }
  .text-primary { color: #1c1d1f; }
  .text-muted { color: #6f7988; }
  .attio-lead-desc { font-size: 1.0625rem; color: #6f7988; line-height: 1.6; margin: 0; max-width: 680px; }

  .attio-separator-wrap { position: relative; width: 100%; height: 1px; background: #e2e8f0; }
  .attio-dashed-line {
    width: 100%;
    height: 1px;
    background-image: linear-gradient(to right, #cbd5e1 50%, transparent 50%);
    background-size: 8px 1px;
  }

  /* Main Contact Grid */
  .contact-main-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 1px;
    background: #e2e8f0;
  }

  .contact-form-cell {
    background: #ffffff;
    padding: 3.5rem;
  }
  .form-title { font-size: 1.25rem; font-weight: 500; color: #1c1d1f; margin-bottom: 0.5rem; }
  .form-desc { font-size: 0.875rem; color: #6f7988; margin-bottom: 2rem; }

  .support-form { display: flex; flex-direction: column; gap: 1.25rem; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
  .form-group { display: flex; flex-direction: column; gap: 0.4rem; }
  .form-group label { font-size: 0.8125rem; font-weight: 500; color: #1c1d1f; }
  .req { color: #dc2626; }
  .form-group input, .form-group select, .form-group textarea {
    padding: 0.65rem 0.85rem;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-size: 0.875rem;
    font-family: inherit;
    color: #1e293b;
    background: #ffffff;
    transition: border-color 0.15s ease;
  }
  .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
    outline: none;
    border-color: #1c1d1f;
  }

  .btn-dark-primary {
    background: #1c1d1f;
    border: 1px solid #1c1d1f;
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .btn-dark-primary:hover { background: #000000; }
  .btn-dark-primary.full-width { width: 100%; margin-top: 0.5rem; }

  .form-status { margin-top: 1rem; font-size: 0.85rem; border-radius: 6px; padding: 0.75rem; display: none; }
  .form-status.success { display: block; background: #dcfce7; color: #15803d; border: 1px solid #bbf7d0; }
  .form-status.error { display: block; background: #fee2e2; color: #b91c1c; border: 1px solid #fecaca; }

  /* Info Cell */
  .contact-info-cell {
    background: #fafafa;
    padding: 3.5rem 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }
  .info-tag {
    font-size: 0.72rem;
    font-weight: 600;
    font-family: ui-monospace, SFMono-Regular, monospace;
    color: #94a3b8;
    margin-bottom: 0.5rem;
    letter-spacing: 0.06em;
  }
  .info-title { font-size: 1.05rem; font-weight: 500; color: #1c1d1f; margin-bottom: 0.4rem; }
  .info-text { font-size: 0.875rem; color: #6f7988; line-height: 1.55; margin: 0 0 0.65rem 0; }
  .info-meta code {
    font-size: 0.78rem;
    font-family: ui-monospace, SFMono-Regular, monospace;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    color: #0f172a;
  }

  @media (max-width: 900px) {
    .contact-main-grid { grid-template-columns: 1fr; }
    .contact-form-cell { padding: 2rem 1.5rem; }
    .contact-info-cell { padding: 2.5rem 1.5rem; }
    .form-row { grid-template-columns: 1fr; }
    .attio-section-head { padding: 4rem 1.5rem 2.5rem 1.5rem; }
  }
</style>
