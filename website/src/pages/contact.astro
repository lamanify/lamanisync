---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact Support & Clinical Integrations | LamaniSync"
  description="Need technical support, workstation pairing assistance, or a custom Clinic Management System adapter for LamaniSync? Contact our team."
>
  <section class="contact-hero">
    <div class="bg-grid-pattern"></div>
    <div class="container contact-head-container">
      <div class="attio-badge crimson">
        <svg style="width:12px; height:12px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <span>Dedicated Clinical Support</span>
      </div>
      <h1 class="contact-title">
        <span class="heading-dark">How can we help</span> <span class="heading-muted">your clinic?</span>
      </h1>
      <p class="contact-subtitle">
        Whether you need help pairing your front-desk workstations or need a custom adapter built for your proprietary clinic software, our integration engineers are ready to help.
      </p>
    </div>
  </section>

  <section class="contact-section">
    <div class="container contact-grid">
      <!-- Left: Contact Form -->
      <div class="form-card">
        <h3 class="form-title">Send a message to our clinical operations team</h3>
        <p class="form-desc">Fill out the details below. We typically respond within a few hours on clinical business days.</p>

        <form id="contact-form" class="support-form">
          <div class="form-row">
            <div class="form-group">
              <label for="name">Your Name <span class="req">*</span></label>
              <input type="text" id="name" name="name" required placeholder="Dr. Siti Aminah / John Doe" />
            </div>
            <div class="form-group">
              <label for="email">Work Email <span class="req">*</span></label>
              <input type="email" id="email" name="email" required placeholder="dr.siti@klinikceria.com" />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="clinicName">Clinic / Healthcare Practice Name <span class="req">*</span></label>
              <input type="text" id="clinicName" name="clinicName" required placeholder="Klinik Gigi Ceria Bangsar" />
            </div>
            <div class="form-group">
              <label for="cms">Clinic Management System (CMS / EHR)</label>
              <select id="cms" name="cms">
                <option value="LamaniPulse EHR">LamaniPulse EHR</option>
                <option value="Dentrix Ascend">Dentrix Ascend</option>
                <option value="eClinicalWorks">eClinicalWorks</option>
                <option value="Open Dental">Open Dental</option>
                <option value="Clinic Pro">Clinic Pro</option>
                <option value="Custom Proprietary Portal">Custom / Other Web Portal</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label for="inquiryType">Inquiry Type <span class="req">*</span></label>
            <select id="inquiryType" name="inquiryType" required>
              <option value="Workstation Pairing Assistance">Workstation Pairing / Extension Support</option>
              <option value="Request New CMS Adapter">Request Custom CMS Adapter (48h Turnaround)</option>
              <option value="Healthcare Privacy & HIPAA / PDPA">Healthcare Privacy, Security & Compliance</option>
              <option value="General Question">General Inquiry / Integration Demo</option>
            </select>
          </div>

          <div class="form-group">
            <label for="message">Message <span class="req">*</span></label>
            <textarea id="message" name="message" rows="4" required placeholder="Please describe your clinic setup, workstation count, or any questions you have..."></textarea>
          </div>

          <!-- Status Alerts -->
          <div id="form-success" class="alert-box success hidden">
            <svg style="width:20px; height:20px; flex-shrink:0;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <div>
              <strong>Message received!</strong>
              <p>Thank you for reaching out. Our clinical support team has logged your inquiry and will contact you shortly.</p>
            </div>
          </div>

          <div id="form-error" class="alert-box error hidden">
            <svg style="width:20px; height:20px; flex-shrink:0;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <div>
              <strong>Submission issue.</strong>
              <p>Could not send message automatically. Please email our team directly at <a href="mailto:support@lamanify.com">support@lamanify.com</a>.</p>
            </div>
          </div>

          <button type="submit" id="submit-btn" class="btn-primary form-submit-btn">
            <span id="btn-text">Send Message</span>
            <svg id="btn-arrow" style="width:16px; height:16px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
            <span id="btn-spinner" class="spinner hidden"></span>
          </button>
        </form>
      </div>

      <!-- Right: Direct Channels & Information -->
      <div class="contact-info-col">
        <div class="info-card">
          <div class="info-icon-box">
            <svg style="width:22px; height:22px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </div>
          <h4 class="info-card-title">Technical & Pairing Support</h4>
          <p class="info-card-text">Need assistance connecting your workstation or pairing code?</p>
          <a href="mailto:support@lamanify.com" class="info-link">support@lamanify.com</a>
        </div>

        <div class="info-card">
          <div class="info-icon-box">
            <svg style="width:22px; height:22px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h4 class="info-card-title">Privacy & Compliance Inquiries</h4>
          <p class="info-card-text">For healthcare data protection, BAA agreements, or PDPA/HIPAA questions:</p>
          <a href="mailto:compliance@lamanify.com" class="info-link">compliance@lamanify.com</a>
        </div>

        <div class="info-card">
          <div class="info-icon-box">
            <svg style="width:22px; height:22px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <h4 class="info-card-title">Response Hours</h4>
          <p class="info-card-text">Monday – Friday: 9:00 AM – 6:00 PM (GMT+8)</p>
          <p class="info-card-sub">Urgent pairing tickets are triaged 24/7 for active LamaniHub clinical partners.</p>
        </div>

        <div class="official-pill-card">
          <img src="https://res.cloudinary.com/lamanify/image/upload/v1790242929/LamaniSync_Logo.png" alt="LamaniSync" class="sidebar-logo">
          <p>LamaniSync is developed and maintained by <strong>Lamanify Technologies</strong> exclusively for the <strong>LamaniHub</strong> healthcare automation network.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const btnText = document.getElementById('btn-text');
  const btnArrow = document.getElementById('btn-arrow');
  const btnSpinner = document.getElementById('btn-spinner');
  const successAlert = document.getElementById('form-success');
  const errorAlert = document.getElementById('form-error');

  if (form && submitBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // UI Loading state
      submitBtn.disabled = true;
      if (btnText) btnText.textContent = 'Sending...';
      if (btnArrow) btnArrow.classList.add('hidden');
      if (btnSpinner) btnSpinner.classList.remove('hidden');
      if (successAlert) successAlert.classList.add('hidden');
      if (errorAlert) errorAlert.classList.add('hidden');

      const formData = new FormData(form);
      const payload = {
        name: formData.get('name'),
        email: formData.get('email'),
        clinicName: formData.get('clinicName'),
        cms: formData.get('cms'),
        inquiryType: formData.get('inquiryType'),
        message: formData.get('message'),
        submittedAt: new Date().toISOString(),
        source: 'lamanisync.com/contact'
      };

      try {
        const response = await fetch('https://n8n.automation.lamanify.com/webhook/lamanisync', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(payload)
        });

        if (response.ok) {
          form.reset();
          if (successAlert) successAlert.classList.remove('hidden');
        } else {
          if (errorAlert) errorAlert.classList.remove('hidden');
        }
      } catch (err) {
        console.error('Submission error:', err);
        if (errorAlert) errorAlert.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        if (btnText) btnText.textContent = 'Send Message';
        if (btnArrow) btnArrow.classList.remove('hidden');
        if (btnSpinner) btnSpinner.classList.add('hidden');
      }
    });
  }
</script>

<style>
  .contact-hero {
    position: relative;
    padding: 5rem 0 3.5rem 0;
    text-align: center;
    background: #ffffff;
    border-bottom: 1px solid var(--border-hairline);
  }

  .contact-head-container {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 780px;
  }

  .contact-title {
    font-size: clamp(2.3rem, 4vw, 3.2rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--text-main);
    margin-top: 1rem;
    margin-bottom: 0.8rem;
  }

  .contact-subtitle {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .contact-section {
    padding: 4.5rem 0 6rem 0;
    background: #ffffff;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 3.5rem;
    align-items: start;
  }

  .form-card {
    background: #ffffff;
    border: 1px solid var(--border-hairline);
    border-radius: 16px;
    padding: 3rem;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
  }

  .form-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 0.4rem;
    letter-spacing: -0.01em;
  }

  .form-desc {
    font-size: 0.92rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  .support-form {
    display: flex;
    flex-direction: column;
    gap: 1.3rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.2rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-group label {
    font-size: 0.86rem;
    font-weight: 600;
    color: #334155;
  }

  .req {
    color: var(--primary);
  }

  .form-group input,
  .form-group select {
    font-family: inherit;
    font-size: 0.92rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border-hairline);
    border-radius: 8px;
    background: #ffffff;
    color: var(--text-main);
    transition: border-color 0.15s, box-shadow 0.15s;
    outline: none;
    width: 100%;
    max-width: 100%;
    min-height: 44px;
    box-sizing: border-box;
  }

  .form-group textarea {
    font-family: inherit;
    font-size: 0.92rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border-hairline);
    border-radius: 8px;
    background: #ffffff;
    color: var(--text-main);
    transition: border-color 0.15s, box-shadow 0.15s;
    outline: none;
    width: 100%;
    max-width: 100%;
    min-height: 90px;
    box-sizing: border-box;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(233, 36, 81, 0.1);
  }

  .form-submit-btn {
    align-self: flex-start;
    padding: 0.85rem 2rem;
    min-height: 44px;
    margin-top: 0.5rem;
  }

  .alert-box {
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
    padding: 1rem 1.2rem;
    border-radius: 10px;
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .alert-box.success {
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    color: #166534;
  }

  .alert-box.error {
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #991b1b;
  }

  .alert-box a {
    color: inherit;
    font-weight: 700;
  }

  .hidden {
    display: none !important;
  }

  .spinner {
    width: 14px;
    height: 14px;
    border: 2px solid #ffffff;
    border-top-color: transparent;
    border-radius: 50%;
    animation: spin 0.6s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* Right column */
  .contact-info-col {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .info-card {
    background: #ffffff;
    border: 1px solid var(--border-hairline);
    border-radius: 16px;
    padding: 1.8rem;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.03);
  }

  .info-icon-box {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: #f8fafc;
    border: 1px solid var(--border-hairline);
    color: var(--primary);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
  }

  .info-card-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 0.35rem;
  }

  .info-card-text {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 0.6rem;
  }

  .info-card-sub {
    font-size: 0.78rem;
    color: #64748b;
    margin-top: 0.4rem;
  }

  .info-link {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--primary);
    text-decoration: none;
  }

  .info-link:hover {
    text-decoration: underline;
  }

  .official-pill-card {
    background: #fafafa;
    border: 1px solid var(--border-hairline);
    border-radius: 16px;
    padding: 1.8rem;
    font-size: 0.85rem;
    color: #475569;
    line-height: 1.55;
  }

  .sidebar-logo {
    height: 32px;
    width: auto;
    object-fit: contain;
    margin-bottom: 1rem;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .form-row {
      grid-template-columns: 1fr;
    }
    .form-card {
      padding: 2rem 1.5rem;
    }
  }

  @media (max-width: 600px) {
    .contact-hero {
      padding: 3.5rem 0 2.5rem 0;
    }
    .contact-section {
      padding: 3rem 0 4rem 0;
    }
    .contact-title {
      font-size: 2rem;
    }
    .form-card {
      padding: 1.5rem 1rem;
    }
    .form-submit-btn {
      width: 100%;
      min-height: 44px;
      justify-content: center;
    }
    .info-card {
      padding: 1.5rem 1rem;
    }
    .official-pill-card {
      padding: 1.5rem 1rem;
    }
  }
</style>
