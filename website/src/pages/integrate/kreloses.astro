---
import Layout from '../../layouts/Layout.astro';
import CtaBanner from '../../components/CtaBanner.astro';
---

<Layout
  title="Kreloses Integration & Data Sync | Connect Kreloses to LamaniHub"
  description="Automate appointment bookings between Kreloses clinic software and LamaniHub WhatsApp in real time. Zero server installation, zero credential sharing, instant live sync."
>
  <main class="attio-page-wrapper">
    <div class="attio-pinstripe-bg"></div>

    <!-- Attio Minimalist Hero -->
    <header class="attio-hero">
      <div class="container hero-inner">
        <h1 class="attio-title">
          Kreloses Sync
        </h1>

        <p class="attio-subtitle">
          <span>Every slot and booking your clinic needs.</span><br />
          <span>Synced with WhatsApp, verified, and written to Kreloses.</span>
        </p>

        <div class="attio-cta-group">
          <a href="/contact" class="attio-btn-primary">
            <span>Request integration</span>
          </a>
          <a href="/docs" class="attio-btn-secondary">
            <span>Read documentation</span>
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2.5 6H9.5M9.5 6L6.5 3M9.5 6L6.5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>
    </header>

    <!-- Content Section -->
    <section class="attio-content-section">
      <div class="container">
        <div class="attio-section-header">
          <h2 class="attio-section-title">
            Built for clinical flow. Zero double entry.
          </h2>
          <p class="attio-section-desc">
            Front-desk schedule and WhatsApp calendar stay identical 24/7.
          </p>
        </div>

        <div class="attio-card-grid">
          <div class="attio-card">
            <div class="card-num">01</div>
            <h3>Real-Time Slot Verification</h3>
            <p>When a patient texts your clinic WhatsApp at midnight, LamaniSync checks Kreloses live availability. No overbooking, no phone tag.</p>
          </div>

          <div class="attio-card">
            <div class="card-num">02</div>
            <h3>Direct Booking Injection</h3>
            <p>Confirmed appointments appear directly on your Kreloses calendar with patient name, contact number, and treatment notes pre-filled.</p>
          </div>

          <div class="attio-card">
            <div class="card-num">03</div>
            <h3>Zero Credential Sharing</h3>
            <p>Never share your Kreloses master passwords or API keys. Operates within your local workstation browser with hardware-level encryption.</p>
          </div>
        </div>
      </div>
    </section>

    <CtaBanner />
  </main>
</Layout>

<style>
  .attio-page-wrapper {
    position: relative;
    background: #ffffff;
    min-height: 100vh;
  }

  /* Attio subtle vertical pinstripe background */
  .attio-pinstripe-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: linear-gradient(to right, rgba(0, 0, 0, 0.03) 1px, transparent 1px);
    background-size: 80px 100%;
    background-position: center top;
    mask-image: linear-gradient(to bottom, black 0%, black 70%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, black 0%, black 70%, transparent 100%);
    z-index: 0;
  }

  .attio-hero {
    position: relative;
    z-index: 1;
    padding: 7.5rem 0 5rem 0;
    text-align: center;
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Attio H1: High-impact single clean title */
  .attio-title {
    font-size: clamp(3rem, 6vw, 4.5rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.08;
    color: #1c1d1f;
    margin: 0 0 1.25rem 0;
  }

  /* Attio Subtitle: 2-line balanced clean text */
  .attio-subtitle {
    font-size: clamp(1.125rem, 2vw, 1.35rem);
    font-weight: 400;
    color: #6f7988;
    line-height: 1.45;
    letter-spacing: -0.015em;
    max-width: 640px;
    margin: 0 0 2.5rem 0;
    text-wrap: balance;
  }

  .attio-cta-group {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  /* Attio Pill Buttons */
  .attio-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #1c1d1f;
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.55rem 1.15rem;
    border-radius: 9999px;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .attio-btn-primary:hover {
    background: #000000;
  }

  .attio-btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    background: #ffffff;
    color: #1c1d1f;
    border: 1px solid #e2e8f0;
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.55rem 1.15rem;
    border-radius: 9999px;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .attio-btn-secondary:hover {
    border-color: #cbd5e1;
    background: #f8fafc;
  }

  /* Content Section */
  .attio-content-section {
    position: relative;
    z-index: 1;
    padding: 5rem 0 6rem 0;
    border-top: 1px solid #f1f5f9;
  }

  .attio-section-header {
    text-align: center;
    margin-bottom: 4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .attio-section-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 500;
    color: #1c1d1f;
    letter-spacing: -0.025em;
    line-height: 1.18;
    margin: 0 0 0.75rem 0;
    max-width: 800px;
    text-wrap: balance;
  }

  .attio-section-desc {
    font-size: 1.05rem;
    color: #6f7988;
    max-width: 540px;
    margin: 0;
    line-height: 1.5;
  }

  .attio-card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .attio-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 2.25rem 1.75rem;
    position: relative;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02);
  }

  .card-num {
    font-size: 0.75rem;
    font-weight: 600;
    color: #94a3b8;
    letter-spacing: 0.05em;
    margin-bottom: 1.5rem;
    font-variant-numeric: tabular-nums;
  }

  .attio-card h3 {
    font-size: 1.125rem;
    font-weight: 500;
    color: #1c1d1f;
    letter-spacing: -0.015em;
    margin: 0 0 0.65rem 0;
  }

  .attio-card p {
    font-size: 0.9rem;
    color: #6f7988;
    line-height: 1.55;
    margin: 0;
  }

  @media (max-width: 860px) {
    .attio-card-grid {
      grid-template-columns: 1fr;
    }
    .attio-hero {
      padding: 5rem 0 3.5rem 0;
    }
  }
</style>
