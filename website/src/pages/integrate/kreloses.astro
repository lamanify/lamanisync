---
import Layout from '../../layouts/Layout.astro';
import CtaBanner from '../../components/CtaBanner.astro';

const cards = [
  {
    num: "01",
    title: "Real-Time Slot Verification",
    desc: "When a patient texts your clinic WhatsApp at midnight, LamaniSync checks Kreloses live availability. No overbooking, no phone tag."
  },
  {
    num: "02",
    title: "Direct Booking Injection",
    desc: "Confirmed appointments appear directly on your Kreloses calendar with patient name, contact number, and treatment notes pre-filled."
  },
  {
    num: "03",
    title: "Zero Credential Sharing",
    desc: "Never share your Kreloses master passwords or API keys. Operates within your local workstation browser with hardware-level encryption."
  }
];
---

<Layout
  title="Kreloses Integration & Data Sync | Connect Kreloses to LamaniHub"
  description="Automate appointment bookings between Kreloses clinic software and LamaniHub WhatsApp in real time. Zero server installation, zero credential sharing, instant live sync."
>
  <!-- Architectural Hero Section -->
  <section class="attio-hero-section border-t border-subtle">
    <div class="attio-container border-x border-subtle">
      <header class="hero-header">
        <div class="eyebrow-wrapper">
          <h1 class="hero-eyebrow">
            <span class="eyebrow-dot"></span>
            <span>Kreloses Ecosystem Bridge</span>
          </h1>
        </div>

        <h2 class="hero-headline">
          Sync Kreloses with WhatsApp.
        </h2>

        <p class="hero-description">
          <span>Automate booking injection and slot availability in real time.</span>
          <br class="hidden sm:inline" />
          <span>Zero server installation, zero master credential sharing, and 100% readback-verified.</span>
        </p>

        <div class="hero-cta-group">
          <a href="/contact" class="btn-attio-primary">
            <span>Request Kreloses integration</span>
          </a>
          <a href="#kreloses-features" class="btn-attio-secondary">
            <span>View capabilities</span>
            <svg class="down-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none">
              <path d="M6 2.5V9.5M6 9.5L2.5 6M6 2.5L9.5 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </header>

            <!-- Contextual Interactive Kreloses Real-Time Calendar Sync Diagram -->
      <div class="hero-diagram-frame">
        <div class="diagram-canvas">
          <svg class="diagram-svg-layer" viewBox="0 0 960 480" fill="none" preserveAspectRatio="xMidYMid meet">
            <!-- Left WhatsApp to Center Calendar -->
            <path d="M 230 240 L 370 240" stroke="#10b981" stroke-width="2" />
            <!-- Center Calendar to Mutex Shield -->
            <path d="M 590 190 L 730 140" stroke="#cbd5e1" stroke-width="1.5" stroke-dasharray="4 4" />
            <!-- Center Calendar to Readback Receipt -->
            <path d="M 590 290 L 730 340" stroke="#cbd5e1" stroke-width="1.5" stroke-dasharray="4 4" />

            <circle class="pulse-particle" r="4" fill="#10b981">
              <animateMotion dur="1.8s" repeatCount="indefinite" path="M 230 240 L 590 240" />
            </circle>
            <circle class="pulse-particle" r="3.5" fill="#3b82f6">
              <animateMotion dur="2.4s" repeatCount="indefinite" path="M 590 290 L 730 340" />
            </circle>
          </svg>

          <!-- Node 1: Left - Inbound WhatsApp Booking Card -->
          <div class="schema-card node-kre-chat">
            <div class="card-head">
              <div class="entity-icon bg-emerald">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
              </div>
              <span class="entity-name">WhatsApp AI Bot</span>
              <span class="entity-badge badge-green">INCOMING</span>
            </div>
            <div class="card-attrs">
              <div class="attr-row highlight-row"><span class="attr-bullet active"></span><span class="attr-label">Patient: Sarah Tan (IC OK)</span></div>
              <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Requested: 3:00 PM Scaling</span></div>
              <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Doctor: Dr. Bryan (Roster OK)</span></div>
              <div class="attr-more">Triaged in 450ms</div>
            </div>
          </div>

          <!-- Node 2: Center - Simulated Kreloses UI Schedule Grid -->
          <div class="kreloses-calendar-mockup">
            <div class="mockup-header">
              <div class="mockup-dots">
                <span class="mock-dot red"></span>
                <span class="mock-dot yellow"></span>
                <span class="mock-dot green"></span>
              </div>
              <span class="mockup-title">Kreloses Portal • Operatory 1 Calendar</span>
              <span class="mockup-status">LIVE DOM ATTACHED</span>
            </div>
            <div class="calendar-slot-list">
              <div class="cal-row booked">
                <span class="time-col">02:00 PM</span>
                <span class="slot-name">Ahmad Faiz — Extraction</span>
                <span class="slot-status">Checked In</span>
              </div>
              <div class="cal-row active-injection">
                <span class="time-col">03:00 PM</span>
                <div class="injection-info">
                  <span class="slot-name-injected">Sarah Tan — Scaling & Polish</span>
                  <span class="injected-tag">⚡ LAMANISYNC WRITTEN</span>
                </div>
                <span class="slot-status-confirmed">Verified (0.9s)</span>
              </div>
              <div class="cal-row vacant">
                <span class="time-col">04:00 PM</span>
                <span class="slot-name muted">Available Slot (Dr. Bryan)</span>
                <span class="slot-status-vacant">Open</span>
              </div>
            </div>
          </div>

          <!-- Node 3: Right Top - Double Booking Mutex Lock -->
          <div class="schema-card node-kre-mutex">
            <div class="card-head">
              <div class="entity-icon bg-purple">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              </div>
              <span class="entity-name">Atomic Mutex Shield</span>
              <span class="entity-badge badge-blue">PROTECTED</span>
            </div>
            <div class="card-attrs">
              <div class="attr-row"><span class="attr-bullet active"></span><span class="attr-label">0 Overlapping slots</span></div>
              <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Workstation-level lock</span></div>
              <div class="attr-more">100% Conflict Proof</div>
            </div>
          </div>

          <!-- Node 4: Right Bottom - Readback Receipt -->
          <div class="schema-card node-kre-receipt">
            <div class="card-head">
              <div class="entity-icon bg-amber">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
              </div>
              <span class="entity-name">Readback Receipt</span>
              <span class="entity-badge badge-green">SHA-256</span>
            </div>
            <div class="card-attrs">
              <div class="attr-row"><span class="attr-bullet active"></span><span class="attr-label">DOM re-queried: Match</span></div>
              <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Zero phantom records</span></div>
              <div class="attr-more">Receipt logged to cloud</div>
            </div>
          </div>

          <!-- Contextual Floating Pill -->
          <div class="floating-query-pill">
            <div class="pill-sparkle">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            </div>
            <span class="pill-text">Live Kreloses DOM attached • 0 credential leakage • sub-second slot injection</span>
            <div class="pill-status-dot"></div>
          </div>
        </div>
      </div>

          <!-- Node 2: Kreloses Schedule Grid -->
          <div class="schema-card node-top-right">
            <div class="card-head">
              <div class="entity-icon bg-indigo">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              </div>
              <span class="entity-name">Kreloses Calendar</span>
              <span class="entity-badge badge-gray">Verified</span>
            </div>
            <div class="card-attrs">
              <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Doctor Shift Verified</span></div>
              <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Direct Slot Injection</span></div>
              <div class="attr-more">0 Phone Tag</div>
            </div>
          </div>

          <!-- Center Node: LamaniSync Kreloses Adapter -->
          <div class="schema-card node-center-hub">
            <div class="card-head">
              <div class="entity-icon bg-purple">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
              </div>
              <span class="entity-name">Kreloses Adapter</span>
              <span class="entity-badge badge-green">Certified</span>
            </div>
            <div class="card-attrs">
              <div class="attr-row highlight-row"><span class="attr-bullet active"></span><span class="attr-label">Live Workstation Sync</span></div>
              <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Hardware-Level Crypto</span></div>
              <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Zero Shared Credentials</span></div>
              <div class="attr-more">Sub-Second Execution</div>
            </div>
          </div>

          <!-- Bottom Left: Patient Record in Kreloses -->
          <div class="schema-card node-bottom-left">
            <div class="card-head">
              <div class="entity-icon bg-blue">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              </div>
              <span class="entity-name">Kreloses Patient File</span>
              <span class="entity-badge badge-gray">Auto-Linked</span>
            </div>
            <div class="card-attrs">
              <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Match Existing NRIC</span></div>
              <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Automated Profile Create</span></div>
              <div class="attr-more">PDPA Compliant</div>
            </div>
          </div>

          <!-- Bottom Right: Cryptographic Receipt -->
          <div class="schema-card node-bottom-right">
            <div class="card-head">
              <div class="entity-icon bg-amber">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
              </div>
              <span class="entity-name">Readback Receipt</span>
              <span class="entity-badge badge-blue">State Hash</span>
            </div>
            <div class="card-attrs">
              <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Schedule Re-Query OK</span></div>
              <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Latency: 0.9s</span></div>
              <div class="attr-more">0 Phantom Bookings</div>
            </div>
          </div>

          <!-- Contextual Floating Pill -->
          <div class="floating-query-pill">
            <div class="pill-sparkle">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m4.93 4.93 4.24 4.24"/><path d="m14.83 9.17 4.24-4.24"/></svg>
            </div>
            <span class="pill-text">Kreloses portal bridge healthy; 0 credential leakage</span>
            <div class="pill-status-dot"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Content Section with Diagonal Hatch Gutters & Hairline 1px Grid -->
  <section class="attio-section shaded-bg border-t border-subtle" id="kreloses-features">
    <div class="attio-container border-x border-subtle">
      <header class="attio-section-head">
        <div class="attio-head-inner">
          <h2 class="attio-h2-inline">
            <span class="text-primary">Built for clinical flow.</span>
            <span class="text-muted font-normal"> Zero double data entry between front desk and WhatsApp.</span>
          </h2>
          <p class="attio-lead-desc">
            Your front-desk Kreloses calendar and patient communication channels stay in lockstep 24/7 without manual phone confirmations.
          </p>
        </div>
      </header>

      <div class="attio-separator-wrap">
        <div class="attio-dashed-line"></div>
      </div>

      <div class="attio-hatch-container">
        <div class="attio-hatch-bg" aria-hidden="true"></div>
        <div class="attio-grid-wrap">
          <div class="attio-card-grid">
            {cards.map((c) => (
              <div class="attio-card">
                <div class="card-num">[{c.num}]</div>
                <h3 class="card-title">{c.title}</h3>
                <p class="card-desc">{c.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <CtaBanner />
</Layout>

<style>
  .border-t { border-top: 1px solid #e2e8f0; }
  .border-x { border-left: 1px solid #e2e8f0; border-right: 1px solid #e2e8f0; }
  .border-subtle { border-color: #e2e8f0; }

  .attio-hero-section { background: #ffffff; position: relative; overflow: hidden; }
  .attio-section { background: #ffffff; position: relative; }
  .attio-section.shaded-bg { background: #fafafa; }
  .attio-container { max-width: 1200px; margin: 0 auto; position: relative; background: #ffffff; }

  /* Hero Copy Header */
  .hero-header {
    padding: 6.5rem 2rem 3.5rem 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .eyebrow-wrapper { margin-bottom: 1.5rem; }
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    padding: 0.35rem 0.95rem;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: #475569;
    letter-spacing: -0.01em;
    margin: 0;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
  }
  .eyebrow-dot { width: 6px; height: 6px; border-radius: 50%; background: #10b981; }

  .hero-headline {
    font-size: clamp(2.5rem, 5.5vw, 4.25rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.1;
    color: #1c1d1f;
    margin: 0 0 1.25rem 0;
    text-wrap: balance;
  }

  .hero-description {
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    font-weight: 400;
    color: #6f7988;
    line-height: 1.5;
    margin: 0 0 2.25rem 0;
    max-width: 680px;
    text-wrap: balance;
  }

  .hero-cta-group {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
  }
  .btn-attio-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #1c1d1f;
    color: #ffffff;
    font-size: 0.9375rem;
    font-weight: 500;
    padding: 0.65rem 1.4rem;
    border-radius: 9999px;
    text-decoration: none;
    border: 1px solid #1c1d1f;
    transition: background-color 0.15s ease;
  }
  .btn-attio-primary:hover { background-color: #000000; }

  .btn-attio-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    background-color: #ffffff;
    color: #1c1d1f;
    font-size: 0.9375rem;
    font-weight: 500;
    padding: 0.65rem 1.4rem;
    border-radius: 9999px;
    text-decoration: none;
    border: 1px solid #e2e8f0;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }
  .btn-attio-secondary:hover { background-color: #f8fafc; border-color: #cbd5e1; }
  .down-arrow { transition: transform 0.15s ease; }
  .btn-attio-secondary:hover .down-arrow { transform: translateY(2px); }

  
  .node-kre-chat { top: 50%; left: 35px; transform: translateY(-50%); width: 220px; }
  .kreloses-calendar-mockup {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 320px;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
    z-index: 2;
    overflow: hidden;
  }
  .mockup-header { background: #f8fafc; padding: 0.55rem 0.85rem; border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: space-between; }
  .mockup-dots { display: flex; gap: 4px; }
  .mock-dot { width: 7px; height: 7px; border-radius: 50%; }
  .mock-dot.red { background: #fca5a5; }
  .mock-dot.yellow { background: #fcd34d; }
  .mock-dot.green { background: #86efac; }
  .mockup-title { font-size: 0.68rem; font-weight: 600; color: #475569; font-family: ui-monospace, monospace; }
  .mockup-status { font-size: 0.58rem; font-weight: 700; color: #15803d; background: #dcfce7; padding: 0.1rem 0.35rem; border-radius: 4px; }

  .calendar-slot-list { display: flex; flex-direction: column; }
  .cal-row { display: flex; align-items: center; padding: 0.6rem 0.85rem; border-bottom: 1px solid #f1f5f9; font-size: 0.72rem; }
  .cal-row:last-child { border-bottom: none; }
  .time-col { width: 62px; font-weight: 600; color: #94a3b8; font-family: ui-monospace, monospace; }
  .slot-name { color: #334155; font-weight: 500; flex: 1; }
  .slot-name.muted { color: #94a3b8; font-style: italic; }
  .slot-status { font-size: 0.65rem; color: #64748b; background: #f1f5f9; padding: 0.1rem 0.35rem; border-radius: 4px; }

  .active-injection { background: #f0fdf4; border-top: 1px solid #bbf7d0; border-bottom: 1px solid #bbf7d0; }
  .injection-info { flex: 1; display: flex; flex-direction: column; gap: 0.15rem; }
  .slot-name-injected { color: #166534; font-weight: 600; }
  .injected-tag { font-size: 0.58rem; color: #15803d; font-weight: 700; font-family: ui-monospace, monospace; }
  .slot-status-confirmed { font-size: 0.65rem; color: #166534; font-weight: 600; }
  .slot-status-vacant { font-size: 0.65rem; color: #94a3b8; }

  .node-kre-mutex { top: 65px; right: 35px; width: 210px; }
  .node-kre-receipt { bottom: 65px; right: 35px; width: 210px; }

  /* Diagram Frame & Dot Matrix Canvas */
  .hero-diagram-frame { position: relative; padding: 0 2rem 5rem 2rem; }
  .diagram-canvas {
    position: relative;
    width: 100%;
    min-height: 520px;
    background-color: #ffffff;
    background-image: radial-gradient(#cbd5e1 1.2px, transparent 1.2px);
    background-size: 24px 24px;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    overflow: hidden;
  }

  .diagram-svg-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  .schema-card {
    position: absolute;
    z-index: 2;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05);
    width: 230px;
    padding: 0.85rem 1rem;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease;
  }
  .schema-card:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08); }

  .node-top-left { top: 45px; left: 45px; }
  .node-top-right { top: 45px; right: 45px; }
  .node-center-hub {
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 250px;
    border-color: #cbd5e1;
  }
  .node-center-hub:hover { transform: translate(-50%, calc(-50% - 2px)); }
  .node-bottom-left { bottom: 65px; left: 60px; }
  .node-bottom-right { bottom: 65px; right: 60px; }

  .card-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #f1f5f9;
  }
  .entity-icon {
    width: 24px;
    height: 24px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .bg-emerald { background: #dcfce7; color: #15803d; }
  .bg-indigo { background: #e0e7ff; color: #4338ca; }
  .bg-purple { background: #f3e8ff; color: #7e22ce; }
  .bg-blue { background: #dbeafe; color: #1d4ed8; }
  .bg-amber { background: #fef3c7; color: #b45309; }

  .entity-name { font-size: 0.8125rem; font-weight: 600; color: #1c1d1f; flex: 1; }
  .entity-badge { font-size: 0.65rem; font-weight: 500; padding: 0.15rem 0.45rem; border-radius: 9999px; }
  .badge-blue { background: #eff6ff; color: #2563eb; }
  .badge-gray { background: #f1f5f9; color: #64748b; }
  .badge-green { background: #f0fdf4; color: #166534; }

  .card-attrs { display: flex; flex-direction: column; gap: 0.35rem; }
  .attr-row { display: flex; align-items: center; gap: 0.45rem; font-size: 0.72rem; color: #475569; }
  .attr-bullet { width: 4px; height: 4px; border-radius: 50%; background: #cbd5e1; }
  .attr-bullet.active { background: #10b981; }
  .attr-label { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .highlight-row { font-weight: 600; color: #1e293b; }
  .attr-more { font-size: 0.68rem; color: #94a3b8; font-weight: 500; margin-top: 0.2rem; }

  .floating-query-pill {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 0.65rem;
