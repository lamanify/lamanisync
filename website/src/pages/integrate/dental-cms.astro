---
import Layout from '../../layouts/Layout.astro';
import CtaBanner from '../../components/CtaBanner.astro';

const cards = [
  {
    num: "01",
    title: "Real-Time Slot Verification",
    desc: "When a patient texts your clinic WhatsApp at midnight, LamaniSync checks Kreloses live availability. No overbooking, no phone tag."
  },
  {
    num: "02",
    title: "Direct Booking Injection",
    desc: "Confirmed appointments appear directly on your Kreloses calendar with patient name, contact number, and treatment notes pre-filled."
  },
  {
    num: "03",
    title: "Zero Credential Sharing",
    desc: "Never share your Kreloses master passwords or API keys. Operates within your local workstation browser with hardware-level encryption."
  }
];
---

<Layout
  title="Dental Clinic Management System Sync | LamaniSync for Dental Practices"
  description="Seamless data synchronization for dental clinic management systems in Malaysia. Keep patient charts, appointment slots, and WhatsApp reminders in lockstep."
>
  <!-- Architectural Hero Section -->
  <section class="attio-hero-section border-t border-subtle">
    <div class="attio-container border-x border-subtle">
      <header class="hero-header">
        <div class="eyebrow-wrapper">
          <h1 class="hero-eyebrow">
            <span class="eyebrow-dot"></span>
            <span>Dental Operatory Sync Engine</span>
          </h1>
        </div>

        <h2 class="hero-headline">
          Every chair. Always full.
        </h2>

        <p class="hero-description">
          <span>Automate dentist operatory scheduling, patient recalls, and booking confirmations.</span>
          <br class="hidden sm:inline" />
          <span>Real-time chair synchronization for modern dental practices and clinics.</span>
        </p>

        <div class="hero-cta-group">
          <a href="/contact" class="btn-attio-primary">
            <span>Connect dental software</span>
          </a>
          <a href="#dental-features" class="btn-attio-secondary">
            <span>View capabilities</span>
            <svg class="down-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none">
              <path d="M6 2.5V9.5M6 9.5L2.5 6M6 2.5L9.5 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </header>

            <!-- Contextual Interactive Dental Operatory Chair Allocation Matrix -->
      <div class="hero-diagram-frame">
        <div class="diagram-canvas">
          <svg class="diagram-svg-layer" viewBox="0 0 960 480" fill="none" preserveAspectRatio="xMidYMid meet">
            <!-- Router to Chair 1, Chair 2, Chair 3 -->
            <path d="M 480 150 L 220 280" stroke="#cbd5e1" stroke-width="1.5" stroke-dasharray="4 4" />
            <path d="M 480 150 L 480 280" stroke="#10b981" stroke-width="2" />
            <path d="M 480 150 L 740 280" stroke="#cbd5e1" stroke-width="1.5" stroke-dasharray="4 4" />

            <circle class="pulse-particle" r="4" fill="#10b981">
              <animateMotion dur="2.0s" repeatCount="indefinite" path="M 480 150 L 480 280" />
            </circle>
          </svg>

          <!-- Top Center: Chairside Allocation Kernel -->
          <div class="schema-card node-dental-allocator">
            <div class="card-head">
              <div class="entity-icon bg-purple">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
              </div>
              <span class="entity-name">Operatory Allocation Router</span>
              <span class="entity-badge badge-green">DISPATCHING</span>
            </div>
            <div class="card-attrs">
              <div class="attr-row highlight-row"><span class="attr-bullet active"></span><span class="attr-label">Triage: Scaling (30m) vs Root Canal (90m)</span></div>
              <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Turnaround Buffer: 15 mins sanitization</span></div>
              <div class="attr-more">Hardware & Equipment Aware</div>
            </div>
          </div>

          <!-- Bottom Left: Operatory 1 (Occupied) -->
          <div class="schema-card node-operatory-1">
            <div class="card-head">
              <div class="entity-icon bg-indigo">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18M15 3v18"/></svg>
              </div>
              <span class="entity-name">Operatory 1</span>
              <span class="entity-badge badge-blue">IN CHAIR</span>
            </div>
            <div class="card-attrs">
              <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Dentist: Dr. Wong (Orthodontics)</span></div>
              <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Procedure: Aligners Fitting</span></div>
              <div class="attr-more">Finishing in 12 mins</div>
            </div>
          </div>

          <!-- Bottom Center: Operatory 2 (Active Target) -->
          <div class="schema-card node-operatory-2 active-operatory">
            <div class="card-head">
              <div class="entity-icon bg-emerald">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="20 6 9 17 4 12"/></svg>
              </div>
              <span class="entity-name">Operatory 2</span>
              <span class="entity-badge badge-green">ALLOCATED</span>
            </div>
            <div class="card-attrs">
              <div class="attr-row highlight-row"><span class="attr-bullet active"></span><span class="attr-label">Dentist: Dr. Sarah (General)</span></div>
              <div class="attr-row"><span class="attr-bullet active"></span><span class="attr-label">Injected: 3:30 PM Ultrasonic Scale</span></div>
              <div class="attr-more">WhatsApp Patient Checked In</div>
            </div>
          </div>

          <!-- Bottom Right: Operatory 3 (Sanitizing) -->
          <div class="schema-card node-operatory-3">
            <div class="card-head">
              <div class="entity-icon bg-amber">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>
              </div>
              <span class="entity-name">Operatory 3</span>
              <span class="entity-badge badge-gray">SANITIZING</span>
            </div>
            <div class="card-attrs">
              <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Autoclave Cycle Running</span></div>
              <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Locked until 04:00 PM</span></div>
              <div class="attr-more">Buffer Protected</div>
            </div>
          </div>

          <!-- Contextual Floating Pill -->
          <div class="floating-query-pill">
            <div class="pill-sparkle">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m4.93 4.93 4.24 4.24"/><path d="m14.83 9.17 4.24-4.24"/></svg>
            </div>
            <span class="pill-text">Dental chair routing active • 3 operatories managed • 0 double-booked chairs</span>
            <div class="pill-status-dot"></div>
          </div>
        </div>
      </div>

          <!-- Node 2: Kreloses Schedule Grid -->
          <div class="schema-card node-top-right">
            <div class="card-head">
              <div class="entity-icon bg-indigo">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              </div>
              <span class="entity-name">Operatory 1 & 2 Roster</span>
              <span class="entity-badge badge-gray">Verified</span>
            </div>
            <div class="card-attrs">
              <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Doctor Shift Verified</span></div>
              <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Direct Slot Injection</span></div>
              <div class="attr-more">0 Phone Tag</div>
            </div>
          </div>

          <!-- Center Node: LamaniSync Kreloses Adapter -->
          <div class="schema-card node-center-hub">
            <div class="card-head">
              <div class="entity-icon bg-purple">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
              </div>
              <span class="entity-name">Dental Operatory Kernel</span>
              <span class="entity-badge badge-green">Certified</span>
            </div>
            <div class="card-attrs">
              <div class="attr-row highlight-row"><span class="attr-bullet active"></span><span class="attr-label">Live Workstation Sync</span></div>
              <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Hardware-Level Crypto</span></div>
              <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Zero Shared Credentials</span></div>
              <div class="attr-more">Sub-Second Execution</div>
            </div>
          </div>

          <!-- Bottom Left: Patient Record in Kreloses -->
          <div class="schema-card node-bottom-left">
            <div class="card-head">
              <div class="entity-icon bg-blue">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              </div>
              <span class="entity-name">Dental Treatment Chart</span>
              <span class="entity-badge badge-gray">Auto-Linked</span>
            </div>
            <div class="card-attrs">
              <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Match Existing NRIC</span></div>
              <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Automated Profile Create</span></div>
              <div class="attr-more">PDPA Compliant</div>
            </div>
          </div>

          <!-- Bottom Right: Cryptographic Receipt -->
          <div class="schema-card node-bottom-right">
            <div class="card-head">
              <div class="entity-icon bg-amber">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
              </div>
              <span class="entity-name">Readback Receipt</span>
              <span class="entity-badge badge-blue">State Hash</span>
            </div>
            <div class="card-attrs">
              <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Schedule Re-Query OK</span></div>
              <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Latency: 0.9s</span></div>
              <div class="attr-more">0 Phantom Bookings</div>
            </div>
          </div>

          <!-- Contextual Floating Pill -->
          <div class="floating-query-pill">
            <div class="pill-sparkle">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m4.93 4.93 4.24 4.24"/><path d="m14.83 9.17 4.24-4.24"/></svg>
            </div>
            <span class="pill-text">Dental operatory bridge active; 0 double bookings</span>
            <div class="pill-status-dot"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Content Section with Diagonal Hatch Gutters & Hairline 1px Grid -->
  <section class="attio-section shaded-bg border-t border-subtle" id="dental-features">
    <div class="attio-container border-x border-subtle">
      <header class="attio-section-head">
        <div class="attio-head-inner">
          <h2 class="attio-h2-inline">
            <span class="text-primary">Built for clinical flow.</span>
            <span class="text-muted font-normal"> Eliminate empty operatory chairs and manual confirmations.</span>
          </h2>
          <p class="attio-lead-desc">
            Keep your dental surgery schedules, practitioner availability, and WhatsApp recall notices in exact lockstep.
          </p>
        </div>
      </header>

      <div class="attio-separator-wrap">
        <div class="attio-dashed-line"></div>
      </div>

      <div class="attio-hatch-container">
        <div class="attio-hatch-bg" aria-hidden="true"></div>
        <div class="attio-grid-wrap">
          <div class="attio-card-grid">
            {[
  { num: "01", title: "Dentist & Chair Scheduling", desc: "Sync slots per dentist and operatory room. Routine scaling and consultations are booked into the exact designated chair." },
  { num: "02", title: "Automated Recall Sync", desc: "Detects patients due for 6-month dental checkups and triggers personalized WhatsApp recall messages via LamaniHub." },
  { num: "03", title: "Malaysian PDPA Compliant", desc: "Protected health information (PHI) never leaves your workstation unencrypted. Compliant with Malaysian healthcare data standards." }
].map((c) => (
              <div class="attio-card">
                <div class="card-num">[{c.num}]</div>
                <h3 class="card-title">{c.title}</h3>
                <p class="card-desc">{c.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <CtaBanner />
</Layout>

<style>
  .border-t { border-top: 1px solid #e2e8f0; }
  .border-x { border-left: 1px solid #e2e8f0; border-right: 1px solid #e2e8f0; }
  .border-subtle { border-color: #e2e8f0; }

  .attio-hero-section { background: #ffffff; position: relative; overflow: hidden; }
  .attio-section { background: #ffffff; position: relative; }
  .attio-section.shaded-bg { background: #fafafa; }
  .attio-container { max-width: 1200px; margin: 0 auto; position: relative; background: #ffffff; }

  /* Hero Copy Header */
  .hero-header {
    padding: 6.5rem 2rem 3.5rem 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .eyebrow-wrapper { margin-bottom: 1.5rem; }
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    padding: 0.35rem 0.95rem;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: #475569;
    letter-spacing: -0.01em;
    margin: 0;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
  }
  .eyebrow-dot { width: 6px; height: 6px; border-radius: 50%; background: #10b981; }

  .hero-headline {
    font-size: clamp(2.5rem, 5.5vw, 4.25rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.1;
    color: #1c1d1f;
    margin: 0 0 1.25rem 0;
    text-wrap: balance;
  }

  .hero-description {
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    font-weight: 400;
    color: #6f7988;
    line-height: 1.5;
    margin: 0 0 2.25rem 0;
    max-width: 680px;
    text-wrap: balance;
  }

  .hero-cta-group {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
  }
  .btn-attio-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #1c1d1f;
    color: #ffffff;
    font-size: 0.9375rem;
    font-weight: 500;
    padding: 0.65rem 1.4rem;
    border-radius: 9999px;
    text-decoration: none;
    border: 1px solid #1c1d1f;
    transition: background-color 0.15s ease;
  }
  .btn-attio-primary:hover { background-color: #000000; }

  .btn-attio-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    background-color: #ffffff;
    color: #1c1d1f;
    font-size: 0.9375rem;
    font-weight: 500;
    padding: 0.65rem 1.4rem;
    border-radius: 9999px;
    text-decoration: none;
    border: 1px solid #e2e8f0;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }
  .btn-attio-secondary:hover { background-color: #f8fafc; border-color: #cbd5e1; }
  .down-arrow { transition: transform 0.15s ease; }
  .btn-attio-secondary:hover .down-arrow { transform: translateY(2px); }

  
  .node-dental-allocator { top: 35px; left: 50%; transform: translateX(-50%); width: 280px; border-color: #cbd5e1; }
  .node-operatory-1 { bottom: 65px; left: 35px; width: 220px; }
  .node-operatory-2 { bottom: 65px; left: 50%; transform: translateX(-50%); width: 240px; }
  .node-operatory-3 { bottom: 65px; right: 35px; width: 220px; }
  .active-operatory { border-color: #86efac; box-shadow: 0 6px 20px rgba(16, 185, 129, 0.12); }

  /* Diagram Frame & Dot Matrix Canvas */
  .hero-diagram-frame { position: relative; padding: 0 2rem 5rem 2rem; }
  .diagram-canvas {
    position: relative;
    width: 100%;
    min-height: 520px;
    background-color: #ffffff;
    background-image: radial-gradient(#cbd5e1 1.2px, transparent 1.2px);
    background-size: 24px 24px;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    overflow: hidden;
  }

  .diagram-svg-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  .schema-card {
    position: absolute;
    z-index: 2;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05);
    width: 230px;
    padding: 0.85rem 1rem;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease;
  }
  .schema-card:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08); }

  .node-top-left { top: 45px; left: 45px; }
  .node-top-right { top: 45px; right: 45px; }
  .node-center-hub {
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 250px;
    border-color: #cbd5e1;
  }
  .node-center-hub:hover { transform: translate(-50%, calc(-50% - 2px)); }
  .node-bottom-left { bottom: 65px; left: 60px; }
  .node-bottom-right { bottom: 65px; right: 60px; }

  .card-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #f1f5f9;
  }
  .entity-icon {
    width: 24px;
    height: 24px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .bg-emerald { background: #dcfce7; color: #15803d; }
  .bg-indigo { background: #e0e7ff; color: #4338ca; }
  .bg-purple { background: #f3e8ff; color: #7e22ce; }
  .bg-blue { background: #dbeafe; color: #1d4ed8; }
  .bg-amber { background: #fef3c7; color: #b45309; }

  .entity-name { font-size: 0.8125rem; font-weight: 600; color: #1c1d1f; flex: 1; }
  .entity-badge { font-size: 0.65rem; font-weight: 500; padding: 0.15rem 0.45rem; border-radius: 9999px; }
  .badge-blue { background: #eff6ff; color: #2563eb; }
  .badge-gray { background: #f1f5f9; color: #64748b; }
  .badge-green { background: #f0fdf4; color: #166534; }

  .card-attrs { display: flex; flex-direction: column; gap: 0.35rem; }
  .attr-row { display: flex; align-items: center; gap: 0.45rem; font-size: 0.72rem; color: #475569; }
  .attr-bullet { width: 4px; height: 4px; border-radius: 50%; background: #cbd5e1; }
  .attr-bullet.active { background: #10b981; }
  .attr-label { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .highlight-row { font-weight: 600; color: #1e293b; }
  .attr-more { font-size: 0.68rem; color: #94a3b8; font-weight: 500; margin-top: 0.2rem; }

  .floating-query-pill {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    padding: 0.45rem 1rem;
    border-radius: 9999px;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.08);
  }
  .pill-sparkle { color: #8b5cf6; display: flex; align-items: center; }
  .pill-text { font-size: 0.8125rem; color: #64748b; }
  .pill-status-dot { width: 7px; height: 7px; border-radius: 50%; background: #10b981; }

  /* Attio Section Head */
  .attio-section-head { padding: 6rem 3.5rem 3rem 3.5rem; background: #ffffff; }
  .attio-head-inner { max-width: 860px; }
  .attio-h2-inline { font-size: clamp(2rem, 3.8vw, 3rem); font-weight: 500; letter-spacing: -0.03em; line-height: 1.15; margin: 0 0 1.25rem 0; }
  .text-primary { color: #1c1d1f; }
  .text-muted { color: #6f7988; }
  .attio-lead-desc { font-size: 1.0625rem; color: #6f7988; line-height: 1.6; margin: 0; max-width: 680px; }

  .attio-separator-wrap { position: relative; width: 100%; height: 1px; background: #e2e8f0; }
  .attio-dashed-line { width: 100%; height: 1px; background-image: linear-gradient(to right, #cbd5e1 50%, transparent 50%); background-size: 8px 1px; }

  .attio-hatch-container { position: relative; background-color: #fafafa; overflow: hidden; padding: 0 2rem; }
  .attio-hatch-bg { position: absolute; inset: 0; pointer-events: none; background-image: repeating-linear-gradient(125deg, transparent, transparent 6px, rgba(15, 23, 42, 0.035) 6px, rgba(15, 23, 42, 0.035) 7px); }
  .attio-grid-wrap { position: relative; z-index: 1; border-left: 1px solid #e2e8f0; border-right: 1px solid #e2e8f0; }

  .attio-card-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: #e2e8f0; }
  .attio-card { background: #ffffff; padding: 3rem 2.25rem; display: flex; flex-direction: column; transition: background-color 0.15s ease; }
  .attio-card:hover { background: #fafafa; }
  .card-num { font-size: 0.75rem; font-weight: 600; color: #94a3b8; letter-spacing: 0.08em; font-family: ui-monospace, SFMono-Regular, monospace; margin-bottom: 1.5rem; }
  .card-title { font-size: 1.15rem; font-weight: 500; color: #1c1d1f; letter-spacing: -0.015em; margin: 0 0 0.75rem 0; line-height: 1.35; }
  .card-desc { font-size: 0.875rem; color: #6f7988; line-height: 1.6; margin: 0; }

