---
import Layout from '../../layouts/Layout.astro';
import CtaBanner from '../../components/CtaBanner.astro';

const cards = [
  {
    num: "01",
    title: "Real-Time Slot Verification",
    desc: "When a patient texts your clinic WhatsApp at midnight, LamaniSync checks Kreloses live availability. No overbooking, no phone tag."
  },
  {
    num: "02",
    title: "Direct Booking Injection",
    desc: "Confirmed appointments appear directly on your Kreloses calendar with patient name, contact number, and treatment notes pre-filled."
  },
  {
    num: "03",
    title: "Zero Credential Sharing",
    desc: "Never share your Kreloses master passwords or API keys. Operates within your local workstation browser with hardware-level encryption."
  }
];
---

<Layout
  title="Dental Clinic Management System Sync | LamaniSync for Dental Practices"
  description="Seamless data synchronization for dental clinic management systems in Malaysia. Keep patient charts, appointment slots, and WhatsApp reminders in lockstep."
>
  <main class="attio-page-wrapper">
    <div class="attio-pinstripe-bg"></div>

    <!-- Attio Minimalist Hero -->
    <header class="attio-hero">
      <div class="container hero-inner">
        <h1 class="attio-title">
          Dental CMS Sync
        </h1>

        <p class="attio-subtitle">
          <span>Every slot and booking your clinic needs.</span><br />
          <span>Synced with WhatsApp, verified, and written to your dental CMS.</span>
        </p>

        <div class="attio-cta-group">
          <a href="/contact" class="attio-btn-primary">
            <span>Connect dental software</span>
          </a>
          <a href="/docs" class="attio-btn-secondary">
            <span>Read documentation</span>
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2.5 6H9.5M9.5 6L6.5 3M9.5 6L6.5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>
    </header>

    <!-- Content Section with Diagonal Hatch Gutters & Hairline 1px Grid -->
    <section class="attio-section shaded-bg border-t border-subtle">
      <div class="attio-container border-x border-subtle">
        <header class="attio-section-head">
          <div class="attio-head-inner">
            <h2 class="attio-h2-inline">
              <span class="text-primary">Built for clinical flow.</span>
              <span class="text-muted font-normal"> Eliminate empty operatory chairs and manual confirmations.</span>
            </h2>
            <p class="attio-lead-desc">
              Keep your dental surgery schedules, practitioner availability, and WhatsApp recall notices in exact lockstep.
            </p>
          </div>
        </header>

        <div class="attio-separator-wrap">
          <div class="attio-dashed-line"></div>
        </div>

        <div class="attio-hatch-container">
          <div class="attio-hatch-bg" aria-hidden="true"></div>
          <div class="attio-grid-wrap">
            <div class="attio-card-grid">
              {[
  { num: "01", title: "Dentist & Chair Scheduling", desc: "Sync slots per dentist and operatory room. Routine scaling and consultations are booked into the exact designated chair." },
  { num: "02", title: "Automated Recall Sync", desc: "Detects patients due for 6-month dental checkups and triggers personalized WhatsApp recall messages via LamaniHub." },
  { num: "03", title: "Malaysian PDPA Compliant", desc: "Protected health information (PHI) never leaves your workstation unencrypted. Compliant with Malaysian healthcare data standards." }
].map((c) => (
                <div class="attio-card">
                  <div class="card-num">[{c.num}]</div>
                  <h3 class="card-title">{c.title}</h3>
                  <p class="card-desc">{c.desc}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <CtaBanner />
  </main>
</Layout>

<style>
  .border-t { border-top: 1px solid #e2e8f0; }
  .border-x { border-left: 1px solid #e2e8f0; border-right: 1px solid #e2e8f0; }
  .border-subtle { border-color: #e2e8f0; }

  .attio-page-wrapper { position: relative; background: #ffffff; min-height: 100vh; }

  .attio-pinstripe-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: linear-gradient(to right, rgba(0, 0, 0, 0.03) 1px, transparent 1px);
    background-size: 80px 100%;
    background-position: center top;
    mask-image: linear-gradient(to bottom, black 0%, black 70%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, black 0%, black 70%, transparent 100%);
    z-index: 0;
  }

  .attio-hero { position: relative; z-index: 1; padding: 7.5rem 0 5rem 0; text-align: center; }
  .hero-inner { display: flex; flex-direction: column; align-items: center; max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }

  .attio-title {
    font-size: clamp(3rem, 6vw, 4.5rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.08;
    color: #1c1d1f;
    margin: 0 0 1.25rem 0;
  }

  .attio-subtitle {
    font-size: clamp(1.125rem, 2vw, 1.35rem);
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: -0.02em;
    color: #6f7988;
    margin: 0 0 2.25rem 0;
    text-wrap: balance;
  }

  .attio-cta-group { display: flex; align-items: center; justify-content: center; gap: 0.75rem; }
  .attio-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #1c1d1f;
    color: #ffffff;
    font-size: 0.9375rem;
    font-weight: 500;
    padding: 0.65rem 1.4rem;
    border-radius: 9999px;
    text-decoration: none;
    border: 1px solid #1c1d1f;
    transition: background-color 0.15s ease;
  }
  .attio-btn-primary:hover { background-color: #000000; }

  .attio-btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    background-color: #ffffff;
    color: #1c1d1f;
    font-size: 0.9375rem;
    font-weight: 500;
    padding: 0.65rem 1.4rem;
    border-radius: 9999px;
    text-decoration: none;
    border: 1px solid #e2e8f0;
    transition: background-color 0.15s ease;
  }
  .attio-btn-secondary:hover { background-color: #f8fafc; }

  /* Attio Section Styling */
  .attio-section { background: #ffffff; position: relative; }
  .attio-section.shaded-bg { background: #fafafa; }
  .attio-container { max-width: 1200px; margin: 0 auto; position: relative; background: #ffffff; }

  .attio-section-head { padding: 6rem 3.5rem 3rem 3.5rem; background: #ffffff; }
  .attio-head-inner { max-width: 860px; }

  .attio-h2-inline {
    font-size: clamp(2rem, 3.8vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0 0 1.25rem 0;
    text-wrap: balance;
  }
  .text-primary { color: #1c1d1f; }
  .text-muted { color: #6f7988; }
  .attio-lead-desc { font-size: 1.0625rem; color: #6f7988; line-height: 1.6; margin: 0; max-width: 680px; }

  .attio-separator-wrap { position: relative; width: 100%; height: 1px; background: #e2e8f0; }
  .attio-dashed-line {
    width: 100%;
    height: 1px;
    background-image: linear-gradient(to right, #cbd5e1 50%, transparent 50%);
    background-size: 8px 1px;
  }

  /* Hatch Container */
  .attio-hatch-container {
    position: relative;
    background-color: #fafafa;
    overflow: hidden;
    padding: 0 2rem;
  }
  .attio-hatch-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: repeating-linear-gradient(125deg, transparent, transparent 6px, rgba(15, 23, 42, 0.035) 6px, rgba(15, 23, 42, 0.035) 7px);
  }
  .attio-grid-wrap {
    position: relative;
    z-index: 1;
    border-left: 1px solid #e2e8f0;
    border-right: 1px solid #e2e8f0;
  }

  .attio-card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: #e2e8f0;
  }

  .attio-card {
    background: #ffffff;
    padding: 3rem 2.25rem;
    display: flex;
    flex-direction: column;
    transition: background-color 0.15s ease;
  }
  .attio-card:hover { background: #fafafa; }

  .card-num {
    font-size: 0.75rem;
    font-weight: 600;
    color: #94a3b8;
    letter-spacing: 0.08em;
    font-family: ui-monospace, SFMono-Regular, monospace;
    margin-bottom: 1.5rem;
  }
  .card-title {
    font-size: 1.15rem;
    font-weight: 500;
    color: #1c1d1f;
    letter-spacing: -0.015em;
    margin: 0 0 0.75rem 0;
    line-height: 1.35;
  }
  .card-desc {
    font-size: 0.875rem;
    color: #6f7988;
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 900px) {
    .attio-card-grid { grid-template-columns: 1fr; }
    .attio-section-head { padding: 4rem 1.5rem 2.5rem 1.5rem; }
    .attio-hatch-container { padding: 0 1rem; }
  }

  @media (max-width: 640px) {
    .attio-hatch-container { padding: 0; }
    .attio-grid-wrap { border-left: none; border-right: none; }
  }
</style>
