---
import Layout from '../../layouts/Layout.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { blogPosts } from '../../data/blog';

const featuredPost = blogPosts[0];
const remainingPosts = blogPosts.slice(1);
---

<Layout
  title="Blog & Engineering Dispatch | LamaniSync Healthcare Bridge"
  description="In-depth engineering articles, clinic operations insights, and clinical data sovereignty manifestos from the LamaniSync and LamaniHub engineering teams."
>
  <section class="blog-hero">
    <div class="bg-grid-pattern"></div>
    <div class="hero-glow"></div>
    <div class="container hero-content">
      <div class="attio-badge crimson">
        <svg style="width:12px; height:12px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
        <span>Engineering & Clinic Operations Dispatch</span>
      </div>
      <h1 class="hero-title">
        <span class="heading-dark">LamaniSync Blog</span>
        <span class="heading-muted">Healthcare data sovereignty & modern engineering.</span>
      </h1>
      <p class="hero-subtitle">
        Architectural deep-dives, clinical data sovereignty manifestos, and real-world guides to eliminating front-desk administrative friction.
      </p>
    </div>
  </section>

  <!-- Featured Article -->
  {featuredPost && (
    <section class="featured-section">
      <div class="container">
        <a href={`/blog/${featuredPost.slug}`} class="featured-card">
          <div class="featured-content">
            <div class="post-meta">
              <span class="category-pill">{featuredPost.category}</span>
              <span class="meta-dot">•</span>
              <span class="meta-time">{featuredPost.readTime}</span>
              <span class="meta-dot">•</span>
              <span class="meta-date">{featuredPost.publishedAt}</span>
            </div>
            <h2 class="featured-title">{featuredPost.title}</h2>
            <p class="featured-desc">{featuredPost.description}</p>
            <div class="author-block">
              <img src={featuredPost.author.avatar} alt={featuredPost.author.name} class="author-avatar" />
              <div>
                <span class="author-name">{featuredPost.author.name}</span>
                <span class="author-role">{featuredPost.author.role}</span>
              </div>
            </div>
          </div>
          <div class="featured-action">
            <span class="read-btn">
              <span>Read Deep Dive</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </span>
          </div>
        </a>
      </div>
    </section>
  )}

  <!-- Posts Grid -->
  <section class="section">
    <div class="container">
      <div class="grid-head">
        <h3 class="grid-title">All Articles</h3>
        <span class="post-count">{blogPosts.length} Articles</span>
      </div>

      <div class="posts-grid">
        {remainingPosts.map((post) => (
          <article class="post-card">
            <div class="post-meta">
              <span class="category-pill">{post.category}</span>
              <span class="meta-dot">•</span>
              <span class="meta-time">{post.readTime}</span>
            </div>
            <h3 class="post-title">
              <a href={`/blog/${post.slug}`}>{post.title}</a>
            </h3>
            <p class="post-desc">{post.description}</p>
            <div class="post-footer">
              <div class="author-block">
                <img src={post.author.avatar} alt={post.author.name} class="author-avatar small" />
                <div>
                  <span class="author-name">{post.author.name}</span>
                  <span class="author-date">{post.publishedAt}</span>
                </div>
              </div>
              <a href={`/blog/${post.slug}`} class="post-link" aria-label={`Read ${post.title}`}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <CtaBanner />
</Layout>

<style>
  .blog-hero {
    position: relative;
    padding: 5.5rem 0 3.5rem 0;
    overflow: hidden;
    background: #ffffff;
  }

  .hero-glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: min(700px, 100%);
    max-width: 100%;
    height: 380px;
    background: radial-gradient(circle, rgba(15, 23, 42, 0.025) 0%, rgba(255, 255, 255, 0) 70%);
    pointer-events: none;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .hero-title {
    font-size: clamp(1.9rem, 4.5vw, 3.8rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-top: 1.25rem;
    margin-bottom: 1.25rem;
    max-width: 900px;
    overflow-wrap: break-word;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 720px;
    line-height: 1.6;
  }

  /* Featured Article */
  .featured-section {
    padding: 1rem 0 3rem 0;
  }

  .featured-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #ffffff;
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-container);
    padding: 3rem;
    text-decoration: none;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.02);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s, border-color 0.2s;
  }

  .featured-card:hover {
    transform: translateY(-2px);
    border-color: #cbd5e1;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.05);
  }

  .featured-content {
    max-width: 750px;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .category-pill {
    background: #f8fafc;
    color: #0f172a;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    border: 1px solid var(--border-hairline);
  }

  .meta-dot {
    color: #cbd5e1;
  }

  .featured-title {
    font-size: clamp(1.6rem, 2.5vw, 2.2rem);
    font-weight: 800;
    color: #0f172a;
    line-height: 1.25;
    margin-bottom: 0.85rem;
    letter-spacing: -0.02em;
  }

  .featured-desc {
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1.75rem;
  }

  .author-block {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .author-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
  }

  .author-avatar.small {
    width: 32px;
    height: 32px;
  }

  .author-name {
    display: block;
    font-size: 0.84rem;
    font-weight: 700;
    color: #0f172a;
  }

  .author-role, .author-date {
    display: block;
    font-size: 0.74rem;
    color: var(--text-muted);
  }

  .featured-action {
    flex-shrink: 0;
    margin-left: 2rem;
  }

  .read-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--primary);
    color: #ffffff;
    font-size: 0.88rem;
    font-weight: 600;
    padding: 0.65rem 1.25rem;
    border-radius: var(--radius-btn);
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.08);
  }

  .read-btn svg {
    width: 14px;
    height: 14px;
  }

  /* Grid */
  .section {
    padding: 3rem 0 5rem 0;
  }

  .grid-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-hairline);
  }

  .grid-title {
    font-size: 1.3rem;
    font-weight: 800;
    color: #0f172a;
  }

  .post-count {
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
  }

  .post-card {
    background: #ffffff;
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-card);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.02);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s, border-color 0.2s;
  }

  .post-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.05);
    border-color: #cbd5e1;
  }

  .post-title {
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: 0.75rem;
    letter-spacing: -0.015em;
  }

  .post-title a {
    color: #0f172a;
    text-decoration: none;
    transition: color 0.15s;
  }

  .post-title a:hover {
    color: var(--primary);
  }

  .post-desc {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1.75rem;
    flex-grow: 1;
  }

  .post-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-hairline);
  }

  .post-link {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #ffffff;
    border: 1px solid var(--border-hairline);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #0f172a;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }

  .post-link svg {
    width: 16px;
    height: 16px;
  }

  .post-card:hover .post-link {
    background: var(--primary);
    color: #ffffff;
    border-color: var(--primary);
  }

  @media (max-width: 960px) {
    .posts-grid {
      grid-template-columns: 1fr;
    }
    .featured-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
      padding: 2rem 1.5rem;
    }
    .featured-action {
      margin-left: 0;
      width: 100%;
    }
  }

  @media (max-width: 600px) {
    .blog-hero {
      padding: 4rem 0 2.5rem 0;
    }
    .featured-card {
      padding: 1.5rem 1rem;
    }
    .read-btn {
      width: 100%;
      min-height: 44px;
      justify-content: center;
    }
    .post-card {
      padding: 1.5rem 1rem;
    }
    .section {
      padding: 2.5rem 0 4rem 0;
    }
  }
</style>
