---
import Layout from '../../layouts/Layout.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { blogPosts } from '../../data/blog';

const featuredPost = blogPosts[0];
const remainingPosts = blogPosts.slice(1);
---

<Layout
  title="Engineering Blog | Healthcare Data Integration & EMR Sync"
  description="Engineering dispatches on healthcare data integration, Manifest V3 browser bridges, EMR synchronization protocols, and medical data compliance."
>
  <div class="attio-outer-gutter">
    <div class="attio-container border-x border-subtle">

      <!-- Attio Hero Section -->
      <header class="attio-hero-section">
        <div class="hero-top-strip">
          <div class="strip-tick left"></div>
          <div class="strip-tick right"></div>
        </div>

        <div class="hero-inner">
          <div class="attio-eyebrow-pill">
            <span class="status-indicator-dot"></span>
            <h1>Engineering & Healthcare Operations Dispatch</h1>
          </div>

          <h2 class="attio-display-headline">
            Architecture. Sovereignty. Zero friction.
          </h2>

          <p class="attio-subtext">
            Technical deep dives, clinic operations manifestos, and real-world case studies on eliminating front-desk administrative overhead.<br class="hidden sm:inline" />
            Written by systems architects and clinic software practitioners.
          </p>
        </div>

        <!-- Contextual Engineering Blog Hero Diagram: Editorial & Pipeline Graph -->
        <div class="hero-diagram-frame">
          <div class="diagram-canvas">
            <svg class="diagram-svg-layer" viewBox="0 0 960 480" fill="none" preserveAspectRatio="xMidYMid meet">
              <path d="M 220 240 L 480 240" stroke="#cbd5e1" stroke-width="1.5" stroke-dasharray="4 4" />
              <path d="M 480 240 L 740 140" stroke="#10b981" stroke-width="2" />
              <path d="M 480 240 L 740 340" stroke="#3b82f6" stroke-width="2" />

              <circle class="pulse-particle" r="4" fill="#10b981">
                <animateMotion dur="2.2s" repeatCount="indefinite" path="M 220 240 L 480 240 L 740 140" />
              </circle>
              <circle class="pulse-particle" r="3.5" fill="#3b82f6">
                <animateMotion dur="2.6s" repeatCount="indefinite" path="M 220 240 L 480 240 L 740 340" />
              </circle>
            </svg>

            <!-- Node 1: Left - In-The-Trenches Telemetry -->
            <div class="schema-card node-blog-left">
              <div class="card-head">
                <div class="entity-icon bg-purple">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
                </div>
                <span class="entity-name">Field Operations</span>
                <span class="entity-badge badge-blue">TELEMETRY</span>
              </div>
              <div class="card-attrs">
                <div class="attr-row"><span class="attr-bullet active"></span><span class="attr-label">Live Clinic Workstations</span></div>
                <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Double-Booking Edge Cases</span></div>
                <div class="attr-more">Raw Data from 120 Clinics</div>
              </div>
            </div>

            <!-- Node 2: Center - Analysis & Architectural Synthesis -->
            <div class="schema-card node-blog-center">
              <div class="card-head">
                <div class="entity-icon bg-blue">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
                </div>
                <span class="entity-name">Engineering Dispatch</span>
                <span class="entity-badge badge-green">PEER REVIEWED</span>
              </div>
              <div class="card-attrs">
                <div class="attr-row highlight-row"><span class="attr-bullet active"></span><span class="attr-label">Topic: Sovereign Data vs Tollways</span></div>
                <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Mechanism: Sub-second DOM Mutex</span></div>
                <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Outcome: 0 Phantom Bookings</span></div>
                <div class="attr-more">Deep Dives & Verification Proofs</div>
              </div>
            </div>

            <!-- Node 3: Right Top - Clinic Manifesto -->
            <div class="schema-card node-blog-right-top">
              <div class="card-head">
                <div class="entity-icon bg-emerald">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                </div>
                <span class="entity-name">Sovereignty Manifesto</span>
                <span class="entity-badge badge-green">MANIFESTO</span>
              </div>
              <div class="card-attrs">
                <div class="attr-row"><span class="attr-bullet active"></span><span class="attr-label">The Dropbox Analogy</span></div>
                <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Zero Vendor Gatekeeping</span></div>
                <div class="attr-more">Read in 4 mins</div>
              </div>
            </div>

            <!-- Node 4: Right Bottom - Technical Architecture -->
            <div class="schema-card node-blog-right-bottom">
              <div class="card-head">
                <div class="entity-icon bg-amber">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                </div>
                <span class="entity-name">Systems Blueprint</span>
                <span class="entity-badge badge-blue">RFC-004</span>
              </div>
              <div class="card-attrs">
                <div class="attr-row"><span class="attr-bullet active"></span><span class="attr-label">Chrome MV3 Workstation Lease</span></div>
                <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Cryptographic Proof of Write</span></div>
                <div class="attr-more">Code & Schema Included</div>
              </div>
            </div>

            <!-- Contextual Floating Pill -->
            <div class="floating-query-pill">
              <div class="pill-sparkle">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
              </div>
              <span class="pill-text">15 published engineering essays • 0 corporate marketing fluff</span>
              <div class="pill-status-dot"></div>
            </div>
          </div>
        </div>
      </header>

      <!-- Featured Article (Attio Hero Post Frame) -->
      {featuredPost && (
        <section class="attio-section-standard border-b border-subtle">
          <div class="section-label-header">
            <span class="attio-subtext" style="font-family: ui-monospace, monospace; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em;">[01] Featured Engineering Essay</span>
          </div>

          <a href={`/blog/${featuredPost.slug}`} class="attio-featured-card">
            <div class="featured-body">
              <div class="featured-meta">
                <span class="category-chip">{featuredPost.category}</span>
                <span class="meta-tag">• {featuredPost.readTime} read</span>
                <span class="meta-tag">• {featuredPost.publishedAt}</span>
              </div>
              <h2 class="featured-headline">{featuredPost.title}</h2>
              <p class="featured-summary">{featuredPost.description}</p>
              
              <div class="featured-author">
                <img src={featuredPost.author.avatar} alt={featuredPost.author.name} class="author-img" />
                <div class="author-info">
                  <span class="author-title">{featuredPost.author.name}</span>
                  <span class="author-subtitle">{featuredPost.author.role}</span>
                </div>
              </div>
            </div>
            <div class="featured-action-bar">
              <span class="read-action">Read Full Analysis &rarr;</span>
            </div>
          </a>
        </section>
      )}

      <!-- All Dispatches (Attio 3-Col Hairline Grid) -->
      <section class="attio-section-shaded border-b border-subtle">
        <div class="section-label-header">
          <span class="attio-subtext" style="font-family: ui-monospace, monospace; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em;">[02] Archive & Technical Chronicles</span>
          <h2 class="attio-section-h2">
            <span class="h2-lead">All Dispatches</span>
            <span class="h2-muted">Clinical integrations, architecture decisions, and workflow patterns.</span>
          </h2>
        </div>

        <div class="attio-hairline-grid grid-3">
          {remainingPosts.map((post, index) => (
            <a href={`/blog/${post.slug}`} class="attio-grid-card">
              <div class="card-inner">
                <div class="card-top">
                  <span class="category-chip">{post.category}</span>
                  <span class="meta-tag">[{String(index + 2).padStart(2, '0')}]</span>
                </div>
                <h3 class="card-title">{post.title}</h3>
                <p class="card-desc">{post.description}</p>
                <div class="card-footer">
                  <span class="read-link">Read Post &rarr;</span>
                  <span class="meta-time">{post.readTime}</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>

    </div>
  </div>

  <CtaBanner />
</Layout>

<style>
  /* Attio Outer Gutters & Frame */
  .attio-outer-gutter {
    background-color: #fafafa;
    background-image: repeating-linear-gradient(
      125deg,
      #e2e8f0 0,
      #e2e8f0 1px,
      transparent 1px,
      transparent 8px
    );
    min-height: 100vh;
  }
  .attio-container {
    max-width: 1200px;
    margin: 0 auto;
    background-color: #ffffff;
  }
  .border-subtle { border-color: #e2e8f0; }

  /* Hero Section */
  .attio-hero-section {
    position: relative;
    padding: 3.5rem 1.5rem 3rem;
    background-color: #ffffff;
    text-align: center;
    border-bottom: 1px solid #e2e8f0;
  }
  .hero-top-strip {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 44px;
    border-bottom: 1px solid #f1f5f9;
    pointer-events: none;
  }
  .strip-tick {
    position: absolute;
    width: 1px;
    height: 100%;
    background-color: #f1f5f9;
  }
  .strip-tick.left { left: 44px; }
  .strip-tick.right { right: 44px; }

  .hero-inner {
    max-width: 820px;
    margin: 0 auto 2.5rem;
    position: relative;
    z-index: 2;
  }
  .attio-eyebrow-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    border: 1px solid #e2e8f0;
    background: #ffffff;
    margin-bottom: 1.5rem;
  }
  .attio-eyebrow-pill h1 {
    font-size: 0.75rem;
    font-weight: 500;
    color: #1c1d1f;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .status-indicator-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #10b981;
    display: inline-block;
  }
  .attio-display-headline {
    font-size: clamp(2.5rem, 5vw, 4.25rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    color: #1c1d1f;
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }
  .attio-subtext {
    font-size: 1.125rem;
    line-height: 1.5;
    color: #6f7988;
    font-weight: 400;
    max-width: 680px;
    margin: 0 auto;
  }

  /* Hero Diagram Frame & Dot Matrix Canvas */
  .hero-diagram-frame {
    margin: 0 auto;
    max-width: 1000px;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    background: #ffffff;
    box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.04);
    overflow: hidden;
  }
  .diagram-canvas {
    position: relative;
    width: 100%;
    height: 480px;
    background-color: #ffffff;
    background-image: radial-gradient(#cbd5e1 1.2px, transparent 1.2px);
    background-size: 24px 24px;
    overflow: hidden;
  }
  .diagram-svg-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  /* Node Positions */
  .schema-card {
    position: absolute;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.06);
    padding: 0.75rem 0.85rem;
    text-align: left;
    z-index: 2;
  }
  .node-blog-left { top: 50%; left: 35px; transform: translateY(-50%); width: 220px; }
  .node-blog-center { top: 50%; left: 50%; transform: translate(-50%, -50%); width: 250px; border-color: #cbd5e1; }
  .node-blog-right-top { top: 55px; right: 35px; width: 220px; }
  .node-blog-right-bottom { bottom: 65px; right: 35px; width: 220px; }

  .card-head {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.5rem;
    padding-bottom: 0.45rem;
    border-bottom: 1px solid #f1f5f9;
  }
  .entity-icon {
    width: 22px;
    height: 22px;
    border-radius: 5px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .bg-purple { background: #f3e8ff; color: #7e22ce; }
  .bg-emerald { background: #d1fae5; color: #047857; }
  .bg-blue { background: #dbeafe; color: #1d4ed8; }
  .bg-amber { background: #fef3c7; color: #b45309; }

  .entity-name { font-size: 0.75rem; font-weight: 600; color: #1c1d1f; flex: 1; }
  .entity-badge { font-size: 0.6rem; font-weight: 600; font-family: ui-monospace, monospace; padding: 0.1rem 0.35rem; border-radius: 4px; }
  .badge-blue { background: #eff6ff; color: #2563eb; }
  .badge-green { background: #ecfdf5; color: #059669; }

  .card-attrs { display: flex; flex-direction: column; gap: 0.3rem; }
  .attr-row { display: flex; align-items: center; gap: 0.4rem; font-size: 0.7rem; color: #334155; }
  .attr-bullet { width: 4px; height: 4px; border-radius: 50%; background: #94a3b8; }
  .attr-bullet.active { background: #10b981; }
  .attr-more { font-size: 0.65rem; color: #94a3b8; font-family: ui-monospace, monospace; margin-top: 0.2rem; }

  /* Floating Query Pill */
  .floating-query-pill {
    position: absolute;
    bottom: 16px;
    left: 50%;
    transform: translateX(-50%);
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 9999px;
    padding: 0.4rem 1rem;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.08);
    display: flex;
    align-items: center;
    gap: 0.6rem;
    z-index: 3;
    white-space: nowrap;
  }
  .pill-sparkle { color: #6366f1; display: flex; }
  .pill-text { font-size: 0.75rem; color: #475569; font-weight: 500; font-family: ui-monospace, monospace; }
  .pill-status-dot { width: 6px; height: 6px; border-radius: 50%; background: #10b981; }

  /* Sections */
  .attio-section-standard {
    padding: 3.5rem 2rem;
    background: #ffffff;
  }
  .attio-section-shaded {
    padding: 3.5rem 2rem;
    background: #fafafa;
  }
  .section-label-header {
    margin-bottom: 1.5rem;
  }
  .attio-section-h2 {
    font-size: 1.75rem;
    line-height: 1.25;
    margin-top: 0.35rem;
  }
  .h2-lead { color: #1c1d1f; font-weight: 600; margin-right: 0.5rem; }
  .h2-muted { color: #6f7988; font-weight: 400; }

  /* Featured Article Card */
  .attio-featured-card {
    display: block;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 4px 18px rgba(15, 23, 42, 0.05);
    transition: all 0.2s ease;
  }
  .attio-featured-card:hover {
    border-color: #1c1d1f;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
  }
  .featured-body { padding: 2.25rem; }
  .featured-meta { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem; }
  .category-chip { font-size: 0.7rem; font-weight: 600; color: #2563eb; background: #eff6ff; padding: 0.2rem 0.5rem; border-radius: 4px; }
  .meta-tag { font-size: 0.75rem; color: #94a3b8; font-family: ui-monospace, monospace; }
  .featured-headline { font-size: clamp(1.5rem, 3vw, 2.25rem); font-weight: 600; color: #1c1d1f; line-height: 1.25; margin-bottom: 0.75rem; }
  .featured-summary { font-size: 1rem; color: #6f7988; line-height: 1.6; max-width: 800px; margin-bottom: 1.5rem; }

  .featured-author { display: flex; align-items: center; gap: 0.75rem; }
  .author-img { width: 36px; height: 36px; border-radius: 50%; border: 1px solid #e2e8f0; }
  .author-info { display: flex; flex-direction: column; }
  .author-title { font-size: 0.85rem; font-weight: 600; color: #1c1d1f; }
  .author-subtitle { font-size: 0.75rem; color: #94a3b8; }

  .featured-action-bar {
    background: #f8fafc;
    border-top: 1px solid #e2e8f0;
    padding: 0.75rem 2.25rem;
    display: flex;
    justify-content: flex-end;
  }
  .read-action { font-size: 0.85rem; font-weight: 600; color: #1c1d1f; }

  /* Hairline Grid Architecture */
  .attio-hairline-grid {
    display: grid;
    gap: 1px;
    background-color: #e2e8f0;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    overflow: hidden;
  }
  .grid-3 { grid-template-columns: repeat(3, 1fr); }

  .attio-grid-card {
    background-color: #ffffff;
    text-decoration: none;
    color: inherit;
    transition: background 0.15s ease;
  }
  .attio-grid-card:hover { background-color: #fcfcfd; }
  .card-inner { padding: 1.5rem; height: 100%; display: flex; flex-direction: column; }
  .card-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; }
  .card-title { font-size: 1.05rem; font-weight: 600; color: #1c1d1f; line-height: 1.35; margin-bottom: 0.5rem; }
  .card-desc { font-size: 0.85rem; color: #6f7988; line-height: 1.5; flex: 1; margin-bottom: 1rem; }
  .card-footer { display: flex; justify-content: space-between; align-items: center; padding-top: 0.75rem; border-top: 1px solid #f1f5f9; font-size: 0.75rem; }
  .read-link { font-weight: 600; color: #1c1d1f; }
  .meta-time { color: #94a3b8; }

  @media (max-width: 768px) {
    .grid-3 { grid-template-columns: 1fr; }
    .hero-diagram-frame { display: none; }
    .featured-body { padding: 1.5rem; }
  }
</style>
