---
import Layout from '../../layouts/Layout.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { blogPosts, type BlogPost } from '../../data/blog';
import { renderMarkdown } from '../../data/markdown';

export function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;

// Other posts for "Related Reads"
const relatedPosts = blogPosts.filter((p) => p.slug !== post.slug).slice(0, 2);

const renderedContent = renderMarkdown(post.content);
---

<Layout
  title={`${post.title} | LamaniSync Engineering Blog`}
  description={post.description}
>
  <div class="attio-outer-gutter">
    <div class="attio-container border-x border-subtle">

      <!-- Architectural Top Bar -->
      <div class="attio-article-topbar border-b border-subtle">
        <a href="/blog" class="back-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          <span>All Dispatches</span>
        </a>
      </div>

      <!-- Article Shell -->
      <article class="attio-article-main">
        <!-- Header -->
        <header class="article-header">
          <div class="attio-eyebrow-pill">
            <span class="status-indicator-dot"></span>
            <span class="pill-category">{post.category}</span>
            <span class="pill-meta">• {post.readTime} read • {post.publishedAt}</span>
          </div>

          <h1 class="article-title">{post.title}</h1>
          <p class="article-lead">{post.description}</p>

          <div class="author-block">
            <img src={post.author.avatar} alt={post.author.name} class="author-avatar" />
            <div class="author-info">
              <span class="author-name">{post.author.name}</span>
              <span class="author-role">{post.author.role}</span>
            </div>
          </div>
        </header>

        <!-- Main Prose Body -->
        <div class="article-prose" set:html={renderedContent} />

        <!-- Author Bio Card (Attio Style) -->
        <div class="attio-bio-card border border-subtle">
          <img src={post.author.avatar} alt={post.author.name} class="bio-avatar" />
          <div class="bio-text">
            <h4 class="bio-name">Written by {post.author.name}</h4>
            <p class="bio-desc">{post.author.role}. Focused on healthcare data sovereignty, zero-knowledge synchronizer reliability, and eliminating clinic administrative overhead.</p>
          </div>
        </div>

        <!-- Related Dispatches (Attio Hairline Grid) -->
        {relatedPosts.length > 0 && (
          <section class="related-section border-t border-subtle">
            <div class="section-label-header">
              <span class="attio-subtext" style="font-family: ui-monospace, monospace; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em;">[RELATED] Continue Reading</span>
            </div>
            <div class="attio-hairline-grid grid-2">
              {relatedPosts.map((related) => (
                <a href={`/blog/${related.slug}`} class="attio-grid-card">
                  <div class="card-inner">
                    <div class="card-top">
                      <span class="category-chip">{related.category}</span>
                      <span class="meta-time">{related.readTime}</span>
                    </div>
                    <h3 class="card-title">{related.title}</h3>
                    <p class="card-desc">{related.description}</p>
                    <div class="card-footer">
                      <span class="read-link">Read Dispatch &rarr;</span>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}
      </article>

    </div>
  </div>

  <CtaBanner />
</Layout>

<style>
  /* Attio Gutter & Container */
  .attio-outer-gutter {
    background-color: #fafafa;
    background-image: repeating-linear-gradient(
      125deg,
      #e2e8f0 0,
      #e2e8f0 1px,
      transparent 1px,
      transparent 8px
    );
    min-height: 100vh;
  }
  .attio-container {
    max-width: 1200px;
    margin: 0 auto;
    background-color: #ffffff;
  }
  .border-subtle { border-color: #e2e8f0; }

  /* Top Bar */
  .attio-article-topbar {
    padding: 0.85rem 2rem;
    background: #ffffff;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #1c1d1f;
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
  }
  .back-link svg { width: 14px; height: 14px; }

  /* Article Shell */
  .attio-article-main {
    max-width: 820px;
    margin: 0 auto;
    padding: 3.5rem 1.5rem;
    background: #ffffff;
  }

  /* Header */
  .article-header {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid #f1f5f9;
  }
  .attio-eyebrow-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    border: 1px solid #e2e8f0;
    background: #ffffff;
    margin-bottom: 1.5rem;
  }
  .status-indicator-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #10b981;
  }
  .pill-category { font-size: 0.72rem; font-weight: 600; color: #1c1d1f; }
  .pill-meta { font-size: 0.72rem; color: #94a3b8; font-family: ui-monospace, monospace; }

  .article-title {
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 600;
    color: #1c1d1f;
    letter-spacing: -0.035em;
    line-height: 1.15;
    margin-bottom: 1.25rem;
  }
  .article-lead {
    font-size: 1.15rem;
    color: #6f7988;
    line-height: 1.6;
    margin-bottom: 1.75rem;
  }

  .author-block {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .author-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid #e2e8f0;
  }
  .author-info { display: flex; flex-direction: column; }
  .author-name { font-size: 0.85rem; font-weight: 600; color: #1c1d1f; }
  .author-role { font-size: 0.75rem; color: #94a3b8; }

  /* Prose */
  .article-prose {
    font-size: 1rem;
    line-height: 1.75;
    color: #334155;
  }
  .article-prose :global(h2) {
    font-size: 1.65rem;
    font-weight: 600;
    color: #1c1d1f;
    letter-spacing: -0.025em;
    margin-top: 2.75rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #f1f5f9;
  }
  .article-prose :global(h3) {
    font-size: 1.25rem;
    font-weight: 600;
    color: #1c1d1f;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .article-prose :global(p) {
    margin-bottom: 1.35rem;
  }
  .article-prose :global(ul), .article-prose :global(ol) {
    margin-bottom: 1.35rem;
    padding-left: 1.5rem;
  }
  .article-prose :global(li) {
    margin-bottom: 0.45rem;
  }
  .article-prose :global(pre) {
    background: #0b0c0e;
    color: #e2e8f0;
    border: 1px solid #27272a;
    border-radius: 8px;
    padding: 1.25rem;
    overflow-x: auto;
    font-size: 0.85rem;
    margin-bottom: 1.75rem;
  }
  .article-prose :global(code) {
    font-family: ui-monospace, monospace;
    font-size: 0.85em;
    background: #f1f5f9;
    color: #0f172a;
    padding: 0.15rem 0.35rem;
    border-radius: 4px;
    border: 1px solid #e2e8f0;
  }
  .article-prose :global(pre code) {
    background: transparent;
    color: inherit;
    border: none;
    padding: 0;
  }
  .article-prose :global(blockquote) {
    border-left: 3px solid #1c1d1f;
    background: #f8fafc;
    padding: 1rem 1.5rem;
    margin: 1.75rem 0;
    color: #475569;
    font-style: italic;
    border-radius: 0 6px 6px 0;
  }

  /* Author Bio Card */
  .attio-bio-card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    background: #fafafa;
    border-radius: 8px;
    padding: 1.5rem;
    margin-top: 3.5rem;
    margin-bottom: 3.5rem;
  }
  .bio-avatar {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 1px solid #e2e8f0;
    flex-shrink: 0;
  }
  .bio-name { font-size: 0.95rem; font-weight: 600; color: #1c1d1f; margin-bottom: 0.25rem; }
  .bio-desc { font-size: 0.82rem; color: #6f7988; line-height: 1.5; margin: 0; }

  /* Related Section */
  .related-section {
    padding-top: 2.5rem;
  }
  .section-label-header {
    margin-bottom: 1.25rem;
  }
  .attio-subtext { color: #94a3b8; }

  /* Hairline Grid */
  .attio-hairline-grid {
    display: grid;
    gap: 1px;
    background-color: #e2e8f0;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    overflow: hidden;
  }
  .grid-2 { grid-template-columns: repeat(2, 1fr); }

  .attio-grid-card {
    background-color: #ffffff;
    text-decoration: none;
    color: inherit;
    transition: background 0.15s ease;
  }
  .attio-grid-card:hover { background-color: #fcfcfd; }
  .card-inner { padding: 1.5rem; height: 100%; display: flex; flex-direction: column; }
  .card-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; }
  .category-chip { font-size: 0.7rem; font-weight: 600; color: #2563eb; background: #eff6ff; padding: 0.2rem 0.5rem; border-radius: 4px; }
  .card-title { font-size: 1.05rem; font-weight: 600; color: #1c1d1f; line-height: 1.35; margin-bottom: 0.5rem; }
  .card-desc { font-size: 0.85rem; color: #6f7988; line-height: 1.5; flex: 1; margin-bottom: 1rem; }
  .card-footer { display: flex; justify-content: flex-end; padding-top: 0.75rem; border-top: 1px solid #f1f5f9; font-size: 0.75rem; }
  .read-link { font-weight: 600; color: #1c1d1f; }
  .meta-time { color: #94a3b8; font-size: 0.75rem; font-family: ui-monospace, monospace; }

  @media (max-width: 768px) {
    .grid-2 { grid-template-columns: 1fr; }
    .attio-article-main { padding: 2rem 1.25rem; }
  }
</style>
