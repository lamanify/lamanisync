---
import Layout from '../../layouts/Layout.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { blogPosts, type BlogPost } from '../../data/blog';
import { renderMarkdown } from '../../data/markdown';

export function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;

// Other posts for "Related Reads"
const relatedPosts = blogPosts.filter((p) => p.slug !== post.slug).slice(0, 2);

const renderedContent = renderMarkdown(post.content);
---

<Layout
  title={`${post.title} | LamaniSync Engineering Blog`}
  description={post.description}
>
  <article class="article-page">
    <div class="bg-grid-pattern"></div>
    <div class="article-glow"></div>

    <div class="container article-container">
      <!-- Breadcrumb -->
      <div class="article-nav">
        <a href="/blog" class="back-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          <span>Back to All Articles</span>
        </a>
      </div>

      <!-- Header -->
      <header class="article-header">
        <div class="post-meta">
          <span class="category-pill">{post.category}</span>
          <span class="meta-dot">•</span>
          <span class="meta-time">{post.readTime}</span>
          <span class="meta-dot">•</span>
          <span class="meta-date">{post.publishedAt}</span>
        </div>

        <h1 class="article-title">{post.title}</h1>
        <p class="article-lead">{post.description}</p>

        <div class="article-author">
          <img src={post.author.avatar} alt={post.author.name} class="author-avatar" />
          <div class="author-details">
            <span class="author-name">{post.author.name}</span>
            <span class="author-role">{post.author.role}</span>
          </div>
        </div>

        {post.tags && post.tags.length > 0 && (
          <div class="article-tags">
            {post.tags.map((tag) => (
              <span class="article-tag">#{tag}</span>
            ))}
          </div>
        )}
      </header>

      <!-- Content -->
      <div class="article-body">
        <div class="article-prose" set:html={renderedContent} />
      </div>

      <!-- Author Bio Box -->
      <div class="author-bio-card">
        <img src={post.author.avatar} alt={post.author.name} class="bio-avatar" />
        <div class="bio-text">
          <h4>Written by {post.author.name}</h4>
          <p>{post.author.role}. Dedicated to unlocking clinic data sovereignty, zero-knowledge synchronizer reliability, and 24/7 conversational healthcare intelligence.</p>
        </div>
      </div>

      <!-- Related Reads -->
      {relatedPosts.length > 0 && (
        <div class="related-section">
          <h3 class="related-title">Continue Reading</h3>
          <div class="related-grid">
            {relatedPosts.map((related) => (
              <a href={`/blog/${related.slug}`} class="related-card">
                <span class="related-cat">{related.category}</span>
                <h4 class="related-card-title">{related.title}</h4>
                <p class="related-card-desc">{related.description}</p>
                <span class="related-read-more">Read Article →</span>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </article>

  <CtaBanner />
</Layout>

<style>
  .article-page {
    position: relative;
    padding: 3.5rem 0 5rem 0;
    background: #ffffff;
    overflow: hidden;
  }

  .article-glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: min(700px, 100%);
    max-width: 100%;
    height: 380px;
    background: radial-gradient(circle, rgba(15, 23, 42, 0.025) 0%, rgba(255, 255, 255, 0) 70%);
    pointer-events: none;
  }

  .article-container {
    max-width: 820px;
    width: 100%;
    min-width: 0;
    position: relative;
    z-index: 1;
  }

  .article-nav {
    margin-bottom: 2rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--text-muted);
    text-decoration: none;
    min-height: 44px;
    padding: 0.4rem 0;
    transition: color 0.15s;
  }

  .back-link:hover {
    color: var(--primary);
  }

  .back-link svg {
    width: 16px;
    height: 16px;
  }

  .article-header {
    margin-bottom: 3rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--border-hairline);
  }

  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    row-gap: 0.35rem;
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  .category-pill {
    background: var(--primary-subtle);
    color: var(--primary);
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    border: 1px solid var(--primary-border);
  }

  .meta-dot {
    color: #cbd5e1;
  }

  .article-title {
    font-size: clamp(1.75rem, 3.8vw, 3rem);
    font-weight: 800;
    line-height: 1.2;
    color: #0a0a0a;
    letter-spacing: -0.025em;
    margin-bottom: 1.25rem;
    overflow-wrap: break-word;
  }

  .article-lead {
    font-size: 1.15rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .article-author {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .author-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
  }

  .author-details {
    display: flex;
    flex-direction: column;
  }

  .author-name {
    font-size: 0.88rem;
    font-weight: 700;
    color: #0a0a0a;
  }

  .author-role {
    font-size: 0.76rem;
    color: var(--text-muted);
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .article-tag {
    font-size: 0.76rem;
    font-weight: 600;
    color: #475569;
    background: #f1f5f9;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    border: 1px solid #e2e8f0;
  }

  /* Body Prose Styling */
  .article-body {
    width: 100%;
    min-width: 0;
    max-width: 100%;
  }

  .article-prose {
    font-size: 1.05rem;
    line-height: 1.8;
    color: #334155;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    overflow-wrap: break-word;
  }

  :global(.article-prose .article-h2) {
    font-size: 1.7rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.02em;
    margin-top: 3rem;
    margin-bottom: 1.25rem;
  }

  :global(.article-prose .article-h3) {
    font-size: 1.3rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.015em;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  :global(.article-prose .article-p) {
    margin-bottom: 1.5rem;
  }

  :global(.article-prose .article-quote) {
    background: #f8fafc;
    border-left: 2px solid var(--primary);
    padding: 1.25rem 1.75rem;
    border-radius: 0 8px 8px 0;
    margin: 2rem 0;
    font-style: italic;
    color: #0f172a;
    font-weight: 500;
  }

  :global(.article-prose .article-quote p) {
    margin-bottom: 0;
  }

  :global(.article-prose .article-hr) {
    border: none;
    height: 1px;
    background: var(--border-hairline);
    margin: 3rem 0;
  }

  :global(.article-prose .article-ul) {
    list-style: disc;
    padding-left: 1.75rem;
    margin-bottom: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  :global(.article-prose .article-ol) {
    list-style: decimal;
    padding-left: 1.75rem;
    margin-bottom: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  :global(.article-prose .article-ul li),
  :global(.article-prose .article-ol li) {
    line-height: 1.6;
  }

  :global(.article-prose .article-link) {
    color: var(--primary);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 500;
    transition: color 0.15s ease;
  }

  :global(.article-prose .article-link:hover) {
    color: var(--primary-dark);
  }

  :global(.article-prose .inline-code) {
    background: #f1f5f9;
    color: #0f172a;
    font-size: 0.88em;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    border: 1px solid var(--border-hairline);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  :global(.article-prose .article-code),
  :global(.article-prose pre) {
    background: #0f172a;
    color: #f1f5f9;
    padding: 1.25rem 1rem;
    border-radius: 12px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    max-width: 100%;
    font-size: 0.82rem;
    line-height: 1.6;
    margin: 1.75rem 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    border: 1px solid #1e293b;
  }

  :global(.article-prose .article-code code),
  :global(.article-prose pre code) {
    display: block;
    min-width: fit-content;
  }

  :global(.article-prose .table-container) {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    max-width: 100%;
    margin: 2rem 0;
    border: 1px solid var(--border-hairline);
    border-radius: 12px;
    background: #ffffff;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.02);
  }

  :global(.article-prose .article-table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
    text-align: left;
  }

  :global(.article-prose .article-table th) {
    background: #f8fafc;
    padding: 0.85rem 1.25rem;
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #475569;
    border-bottom: 1px solid var(--border-hairline);
  }

  :global(.article-prose .article-table td) {
    padding: 0.85rem 1.25rem;
    border-bottom: 1px solid var(--border-hairline);
    color: #334155;
  }

  :global(.article-prose .article-table tr:last-child td) {
    border-bottom: none;
  }

  /* Author Bio Card */
  .author-bio-card {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    background: #fafafa;
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-card);
    padding: 2rem;
    margin-top: 4rem;
  }

  .bio-avatar {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .bio-text h4 {
    font-size: 1.05rem;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 0.35rem;
  }

  .bio-text p {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* Related Reads */
  .related-section {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid var(--border-hairline);
  }

  .related-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 1.5rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .related-card {
    background: #ffffff;
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-card);
    padding: 1.5rem;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.02);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s, border-color 0.2s;
  }

  .related-card:hover {
    transform: translateY(-2px);
    border-color: #cbd5e1;
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.05);
  }

  .related-cat {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--primary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.4rem;
  }

  .related-card-title {
    font-size: 1.05rem;
    font-weight: 800;
    color: #0a0a0a;
    margin-bottom: 0.5rem;
    line-height: 1.35;
  }

  .related-card-desc {
    font-size: 0.82rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 1rem;
    flex-grow: 1;
  }

  .related-read-more {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--primary);
  }

  @media (max-width: 768px) {
    .related-grid {
      grid-template-columns: 1fr;
    }
    .author-bio-card {
      flex-direction: column;
      text-align: center;
      gap: 1rem;
    }
  }

  @media (max-width: 600px) {
    .article-page {
      padding: 2.5rem 0 3.5rem 0;
    }
    .article-title {
      font-size: 1.75rem;
    }
    .article-lead {
      font-size: 1rem;
    }
    .author-bio-card {
      padding: 1.5rem 1rem;
    }
    :global(.article-prose .article-h2) {
      font-size: 1.35rem;
      margin-top: 2rem;
    }
    :global(.article-prose .article-h3) {
      font-size: 1.15rem;
      margin-top: 1.5rem;
    }
    :global(.article-prose .article-table th),
    :global(.article-prose .article-table td) {
      padding: 0.65rem 0.75rem;
      font-size: 0.78rem;
    }
    :global(.article-prose .article-code),
    :global(.article-prose pre) {
      padding: 1rem 0.75rem;
      font-size: 0.75rem;
    }
    :global(.article-prose .article-quote) {
      padding: 1rem 1.15rem;
    }
  }
</style>
