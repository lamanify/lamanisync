---
import Layout from '../layouts/Layout.astro';
import CtaBanner from '../components/CtaBanner.astro';

const pillars = [
  {
    num: "01",
    title: "Sub-Second Bidirectional Sync",
    desc: "Appointments created via LamaniHub WhatsApp bots write to your CMS schedule in < 1.2s. Status changes inside the clinic reflect back to patients instantly."
  },
  {
    num: "02",
    title: "Operatory & Chair Routing",
    desc: "Route appointments based on physical operatory, doctor schedule, procedure duration, and chair availability. Prevents scheduling double-bookings automatically."
  },
  {
    num: "03",
    title: "WhatsApp Triage & Auto-Booking",
    desc: "Connect 24/7 AI chat with real-time calendar availability. Patients select available slots on WhatsApp; LamaniSync writes them directly into your doctor's chair."
  },
  {
    num: "04",
    title: "Two-Way Readback Verification",
    desc: "Every write is verified by a secondary readback of the CMS DOM state. Zero phantom bookings; if the clinic schedule rejects the write, LamaniHub is alerted."
  },
  {
    num: "05",
    title: "Manifest V3 Isolated Sandboxing",
    desc: "Strict Chrome MV3 execution policy. Host permissions scoped exclusively to your clinic origin. Zero background native binaries, zero open firewall ports."
  },
  {
    num: "06",
    title: "Multi-Workstation Redundancy",
    desc: "Deploy across multiple reception desks. LamaniSync elects an active bridge with sub-second failover. If one PC sleeps, the secondary takes over instantly."
  }
];

const actionIds = [
  { id: "APPOINTMENT_READ_SLOTS", desc: "Queries real-time calendar grid for doctor availability and open time windows." },
  { id: "APPOINTMENT_WRITE_BOOKING", desc: "Injects verified patient name, phone, chair, and appointment type into schedule." },
  { id: "APPOINTMENT_VERIFY_READBACK", desc: "Re-queries newly written appointment slot to confirm database persistence." },
  { id: "PATIENT_QUERY_RECORD", desc: "Checks existing patient record by national ID or phone number before booking." },
  { id: "PATIENT_CREATE_RECORD", desc: "Generates new patient file in CMS when a first-time patient books via WhatsApp." },
  { id: "CHAIR_BLOCK_TIME", desc: "Synchronizes emergency doctor holds or operatory maintenance across channels." }
];
---

<Layout
  title="Features & Capabilities | LamaniSync Healthcare Bridge"
  description="Explore the comprehensive features of LamaniSync: Sub-second sync, multi-operatory chair routing, LamaniHub WhatsApp triage, verified writes, Manifest V3 security, and multi-branch support."
>
  <!-- Architectural Hero Section (Attio Eyebrow, 4-word Headline, 2-line Desc, Diagram) -->
  <section class="attio-hero-section border-t border-subtle">
    <div class="attio-container border-x border-subtle">
      <header class="hero-header">
        <div class="eyebrow-wrapper">
          <h1 class="hero-eyebrow">
            <span class="eyebrow-dot"></span>
            <span>Clinical Engine Architecture</span>
          </h1>
        </div>

        <h2 class="hero-headline">
          Speed. Redundancy. Zero downtime.
        </h2>

        <p class="hero-description">
          <span>Sub-second WhatsApp sync, chair routing, and ambient workstation failover.</span>
          <br class="hidden sm:inline" />
          <span>Purpose-built for high-volume practices that cannot afford front-desk double entry.</span>
        </p>

        <div class="hero-cta-group">
          <a href="/contact" class="btn-attio-primary">
            <span>Contact for integration</span>
          </a>
          <a href="#core-features" class="btn-attio-secondary">
            <span>Explore all features</span>
            <svg class="down-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none">
              <path d="M6 2.5V9.5M6 9.5L2.5 6M6 2.5L9.5 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </header>

      <!-- Contextual Interactive Feature Topology Diagram -->
      <div class="hero-diagram-frame">
        <div class="diagram-canvas">
          <svg class="diagram-svg-layer" viewBox="0 0 960 480" fill="none" preserveAspectRatio="xMidYMid meet">
            <path d="M 230 110 C 340 110, 360 230, 480 230" stroke="#cbd5e1" stroke-width="1.5" stroke-dasharray="4 4" />
            <circle class="pulse-particle" r="3.5" fill="#10b981">
              <animateMotion dur="2.8s" repeatCount="indefinite" path="M 230 110 C 340 110, 360 230, 480 230" />
            </circle>

            <path d="M 730 110 C 620 110, 600 230, 480 230" stroke="#cbd5e1" stroke-width="1.5" stroke-dasharray="4 4" />
            <circle class="pulse-particle" r="3.5" fill="#6366f1">
              <animateMotion dur="3.2s" repeatCount="indefinite" path="M 730 110 C 620 110, 600 230, 480 230" />
            </circle>

            <path d="M 480 250 C 370 250, 340 370, 230 370" stroke="#cbd5e1" stroke-width="1.5" stroke-dasharray="4 4" />
            <circle class="pulse-particle" r="3.5" fill="#3b82f6">
              <animateMotion dur="3.6s" repeatCount="indefinite" path="M 480 250 C 370 250, 340 370, 230 370" />
            </circle>

            <path d="M 480 250 C 590 250, 620 370, 730 370" stroke="#cbd5e1" stroke-width="1.5" stroke-dasharray="4 4" />
            <circle class="pulse-particle" r="3.5" fill="#f59e0b">
              <animateMotion dur="3.0s" repeatCount="indefinite" path="M 480 250 C 590 250, 620 370, 730 370" />
            </circle>

            <circle cx="480" cy="240" r="5" fill="#ffffff" stroke="#1c1d1f" stroke-width="2" />
          </svg>

          <!-- Top Left Node: Operatory Routing -->
          <div class="schema-card node-top-left">
            <div class="card-head">
              <div class="entity-icon bg-emerald">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
              </div>
              <span class="entity-name">Chair Allocation</span>
              <span class="entity-badge badge-blue">Auto</span>
            </div>
            <div class="card-attrs">
              <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Operatory 1, 2, 3 Router</span></div>
              <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Procedure Buffer (15m)</span></div>
              <div class="attr-more">+ 3 Attributes</div>
            </div>
          </div>

          <!-- Top Right Node: Multi-Workstation Failover -->
          <div class="schema-card node-top-right">
            <div class="card-head">
              <div class="entity-icon bg-indigo">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
              </div>
              <span class="entity-name">Failover Node</span>
              <span class="entity-badge badge-gray">Active</span>
            </div>
            <div class="card-attrs">
              <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Front Desk PC #1 (Active)</span></div>
              <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Front Desk PC #2 (Standby)</span></div>
              <div class="attr-more">&lt; 500ms failover</div>
            </div>
          </div>

          <!-- Center Node: Core Runtime -->
          <div class="schema-card node-center-hub">
            <div class="card-head">
              <div class="entity-icon bg-purple">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
              </div>
              <span class="entity-name">Sync Engine (MV3)</span>
              <span class="entity-badge badge-green">Healthy</span>
            </div>
            <div class="card-attrs">
              <div class="attr-row highlight-row"><span class="attr-bullet active"></span><span class="attr-label">Sub-Second Queue</span></div>
              <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Predefined Action Whitelist</span></div>
              <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Zero Background Native Port</span></div>
              <div class="attr-more">100% Outbound WSS</div>
            </div>
          </div>

          <!-- Bottom Left: Double-Booking Shield -->
          <div class="schema-card node-bottom-left">
            <div class="card-head">
              <div class="entity-icon bg-blue">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              </div>
              <span class="entity-name">Mutex Lock</span>
              <span class="entity-badge badge-gray">Guard</span>
            </div>
            <div class="card-attrs">
              <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Atomic Slot Reservation</span></div>
              <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">0 Race Conditions</span></div>
              <div class="attr-more">Idempotent</div>
            </div>
          </div>

          <!-- Bottom Right: Readback Receipt -->
          <div class="schema-card node-bottom-right">
            <div class="card-head">
              <div class="entity-icon bg-amber">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
              </div>
              <span class="entity-name">Readback Receipt</span>
              <span class="entity-badge badge-blue">Verified</span>
            </div>
            <div class="card-attrs">
              <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Secondary DOM Audit</span></div>
              <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">SHA-256 State Hash</span></div>
              <div class="attr-more">Receipt Logged</div>
            </div>
          </div>

          <!-- Contextual Floating Pill -->
          <div class="floating-query-pill">
            <div class="pill-sparkle">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m4.93 4.93 4.24 4.24"/><path d="m14.83 9.17 4.24-4.24"/></svg>
            </div>
            <span class="pill-text">Front-desk PC 1 active; failover latency 340ms</span>
            <div class="pill-status-dot"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6 Pillars Feature Grid (Attio Shaded Hatch Container + 1px Grid) -->
  <section class="attio-section shaded-bg border-t border-subtle" id="core-features">
    <div class="attio-container border-x border-subtle">
      <header class="attio-section-head">
        <div class="attio-head-inner">
          <h2 class="attio-h2-inline">
            <span class="text-primary">Six pillars of reliability.</span>
            <span class="text-muted font-normal"> Engineered under the hood of the universal ambient bridge.</span>
          </h2>
          <p class="attio-lead-desc">
            A hardened synchronization runtime designed to operate in background harmony with your existing clinic workflow.
          </p>
        </div>
      </header>

      <div class="attio-separator-wrap">
        <div class="attio-dashed-line"></div>
      </div>

      <div class="attio-hatch-container">
        <div class="attio-hatch-bg" aria-hidden="true"></div>
        <div class="attio-grid-wrap">
          <div class="attio-pillars-grid">
            {pillars.map((item) => (
              <div class="attio-cell">
                <div class="cell-overline">[{item.num}]</div>
                <h3 class="cell-title">{item.title}</h3>
                <p class="cell-desc">{item.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Action IDs Architecture Section -->
  <section class="attio-section border-t border-subtle" id="action-ids">
    <div class="attio-container border-x border-subtle">
      <header class="attio-section-head">
        <div class="attio-head-inner">
          <h2 class="attio-h2-inline">
            <span class="text-primary">Predefined adapter action IDs.</span>
            <span class="text-muted font-normal"> Bounded page execution with zero arbitrary remote code injection.</span>
          </h2>
          <p class="attio-lead-desc">
            LamaniSync executes only pre-compiled, cryptographically whitelisted functions. Third-party or unverified scripts are strictly blocked by browser extension security policies.
          </p>
        </div>
      </header>

      <div class="attio-separator-wrap">
        <div class="attio-dashed-line"></div>
      </div>

      <div class="action-grid-wrap">
        <div class="action-grid">
          {actionIds.map((act) => (
            <div class="action-cell">
              <div class="action-id-tag"><code>{act.id}</code></div>
              <p class="action-desc">{act.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <CtaBanner />
</Layout>

<style>
  .border-t { border-top: 1px solid #e2e8f0; }
  .border-x { border-left: 1px solid #e2e8f0; border-right: 1px solid #e2e8f0; }
  .border-subtle { border-color: #e2e8f0; }

  .attio-hero-section { background: #ffffff; position: relative; overflow: hidden; }
  .attio-section { background: #ffffff; position: relative; }
  .attio-section.shaded-bg { background: #fafafa; }
  .attio-container { max-width: 1200px; margin: 0 auto; position: relative; background: #ffffff; }

  /* Hero Copy Header */
  .hero-header {
    padding: 6.5rem 2rem 3.5rem 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .eyebrow-wrapper { margin-bottom: 1.5rem; }
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    padding: 0.35rem 0.95rem;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: #475569;
    letter-spacing: -0.01em;
    margin: 0;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
  }
  .eyebrow-dot { width: 6px; height: 6px; border-radius: 50%; background: #10b981; }

  .hero-headline {
    font-size: clamp(2.5rem, 5.5vw, 4.25rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.1;
    color: #1c1d1f;
    margin: 0 0 1.25rem 0;
    text-wrap: balance;
  }

  .hero-description {
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    font-weight: 400;
    color: #6f7988;
    line-height: 1.5;
    margin: 0 0 2.25rem 0;
    max-width: 680px;
    text-wrap: balance;
  }

  .hero-cta-group {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
  }
  .btn-attio-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #1c1d1f;
    color: #ffffff;
    font-size: 0.9375rem;
    font-weight: 500;
    padding: 0.65rem 1.4rem;
    border-radius: 9999px;
    text-decoration: none;
    border: 1px solid #1c1d1f;
    transition: background-color 0.15s ease;
  }
  .btn-attio-primary:hover { background-color: #000000; }

  .btn-attio-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    background-color: #ffffff;
    color: #1c1d1f;
    font-size: 0.9375rem;
    font-weight: 500;
    padding: 0.65rem 1.4rem;
    border-radius: 9999px;
    text-decoration: none;
    border: 1px solid #e2e8f0;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }
  .btn-attio-secondary:hover { background-color: #f8fafc; border-color: #cbd5e1; }
  .down-arrow { transition: transform 0.15s ease; }
  .btn-attio-secondary:hover .down-arrow { transform: translateY(2px); }

  /* Diagram Frame & Dot Matrix Canvas */
  .hero-diagram-frame { position: relative; padding: 0 2rem 5rem 2rem; }
  .diagram-canvas {
    position: relative;
    width: 100%;
    min-height: 520px;
    background-color: #ffffff;
    background-image: radial-gradient(#cbd5e1 1.2px, transparent 1.2px);
    background-size: 24px 24px;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    overflow: hidden;
  }

  .diagram-svg-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  .schema-card {
    position: absolute;
    z-index: 2;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05);
    width: 230px;
    padding: 0.85rem 1rem;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease;
  }
  .schema-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
  }

  .node-top-left { top: 45px; left: 45px; }
  .node-top-right { top: 45px; right: 45px; }
  .node-center-hub {
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 250px;
    border-color: #cbd5e1;
  }
  .node-center-hub:hover { transform: translate(-50%, calc(-50% - 2px)); }
  .node-bottom-left { bottom: 65px; left: 60px; }
  .node-bottom-right { bottom: 65px; right: 60px; }

  .card-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #f1f5f9;
  }
  .entity-icon {
    width: 24px;
    height: 24px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .bg-emerald { background: #dcfce7; color: #15803d; }
  .bg-indigo { background: #e0e7ff; color: #4338ca; }
  .bg-purple { background: #f3e8ff; color: #7e22ce; }
  .bg-blue { background: #dbeafe; color: #1d4ed8; }
  .bg-amber { background: #fef3c7; color: #b45309; }

  .entity-name { font-size: 0.8125rem; font-weight: 600; color: #1c1d1f; flex: 1; }
  .entity-badge { font-size: 0.65rem; font-weight: 500; padding: 0.15rem 0.45rem; border-radius: 9999px; }
  .badge-blue { background: #eff6ff; color: #2563eb; }
  .badge-gray { background: #f1f5f9; color: #64748b; }
  .badge-green { background: #f0fdf4; color: #166534; }

  .card-attrs { display: flex; flex-direction: column; gap: 0.35rem; }
  .attr-row { display: flex; align-items: center; gap: 0.45rem; font-size: 0.72rem; color: #475569; }
  .attr-bullet { width: 4px; height: 4px; border-radius: 50%; background: #cbd5e1; }
  .attr-bullet.active { background: #10b981; }
  .attr-label { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .highlight-row { font-weight: 600; color: #1e293b; }
  .attr-more { font-size: 0.68rem; color: #94a3b8; font-weight: 500; margin-top: 0.2rem; }

  .floating-query-pill {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    padding: 0.45rem 1rem;
    border-radius: 9999px;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.08);
  }
  .pill-sparkle { color: #8b5cf6; display: flex; align-items: center; }
  .pill-text { font-size: 0.8125rem; color: #64748b; }
  .pill-status-dot { width: 7px; height: 7px; border-radius: 50%; background: #10b981; }

  /* Attio Section Head & Pillars */
  .attio-section-head { padding: 6rem 3.5rem 3rem 3.5rem; background: #ffffff; }
  .attio-head-inner { max-width: 860px; }
  .attio-h2-inline { font-size: clamp(2rem, 3.8vw, 3rem); font-weight: 500; letter-spacing: -0.03em; line-height: 1.15; margin: 0 0 1.25rem 0; }
  .text-primary { color: #1c1d1f; }
  .text-muted { color: #6f7988; }
  .attio-lead-desc { font-size: 1.0625rem; color: #6f7988; line-height: 1.6; margin: 0; max-width: 680px; }

  .attio-separator-wrap { position: relative; width: 100%; height: 1px; background: #e2e8f0; }
  .attio-dashed-line { width: 100%; height: 1px; background-image: linear-gradient(to right, #cbd5e1 50%, transparent 50%); background-size: 8px 1px; }

  .attio-hatch-container { position: relative; background-color: #fafafa; overflow: hidden; padding: 0 2rem; }
  .attio-hatch-bg { position: absolute; inset: 0; pointer-events: none; background-image: repeating-linear-gradient(125deg, transparent, transparent 6px, rgba(15, 23, 42, 0.035) 6px, rgba(15, 23, 42, 0.035) 7px); }
  .attio-grid-wrap { position: relative; z-index: 1; border-left: 1px solid #e2e8f0; border-right: 1px solid #e2e8f0; }

  .attio-pillars-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: #e2e8f0; }
  .attio-cell { background: #ffffff; padding: 3rem 2.25rem; display: flex; flex-direction: column; transition: background 0.15s ease; }
  .attio-cell:hover { background: #fafafa; }
  .cell-overline { font-size: 0.75rem; font-weight: 600; color: #94a3b8; letter-spacing: 0.08em; font-family: ui-monospace, SFMono-Regular, monospace; margin-bottom: 1.75rem; }
  .cell-title { font-size: 1.125rem; font-weight: 500; color: #1c1d1f; letter-spacing: -0.015em; line-height: 1.35; margin: 0 0 0.85rem 0; }
  .cell-desc { font-size: 0.875rem; color: #6f7988; line-height: 1.6; margin: 0; }

  .action-grid-wrap { background: #fafafa; padding: 3.5rem; }
  .action-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: #e2e8f0; border: 1px solid #e2e8f0; }
  .action-cell { background: #ffffff; padding: 2rem; display: flex; flex-direction: column; gap: 0.75rem; }
  .action-id-tag code { font-size: 0.78rem; font-weight: 600; font-family: ui-monospace, SFMono-Regular, monospace; background: #f1f5f9; color: #0f172a; padding: 0.2rem 0.5rem; border-radius: 4px; border: 1px solid #e2e8f0; }
  .action-desc { font-size: 0.875rem; color: #6f7988; line-height: 1.55; margin: 0; }

  @media (max-width: 900px) {
    .diagram-canvas { min-height: 700px; }
    .schema-card { width: 190px; padding: 0.65rem 0.75rem; }
    .node-top-left { top: 20px; left: 20px; }
    .node-top-right { top: 20px; right: 20px; }
