---
import Layout from '../layouts/Layout.astro';
import CtaBanner from '../components/CtaBanner.astro';

const pillars = [
  {
    num: "01",
    title: "Sub-Second Bidirectional Sync",
    desc: "Appointments created via LamaniHub WhatsApp bots write to your CMS schedule in < 1.2s. Status changes inside the clinic reflect back to patients instantly."
  },
  {
    num: "02",
    title: "Operatory & Chair Routing",
    desc: "Route appointments based on physical operatory, doctor schedule, procedure duration, and chair availability. Prevents scheduling double-bookings automatically."
  },
  {
    num: "03",
    title: "WhatsApp Triage & Auto-Booking",
    desc: "Connect 24/7 AI chat with real-time calendar availability. Patients select available slots on WhatsApp; LamaniSync writes them directly into your doctor's chair."
  },
  {
    num: "04",
    title: "Two-Way Readback Verification",
    desc: "Every write is verified by a secondary readback of the CMS DOM state. Zero phantom bookings; if the clinic schedule rejects the write, LamaniHub is alerted."
  },
  {
    num: "05",
    title: "Manifest V3 Isolated Sandboxing",
    desc: "Strict Chrome MV3 execution policy. Host permissions scoped exclusively to your clinic origin. Zero background native binaries, zero open firewall ports."
  },
  {
    num: "06",
    title: "Multi-Workstation Redundancy",
    desc: "Deploy across multiple reception desks. LamaniSync elects an active bridge with sub-second failover. If one PC sleeps, the secondary takes over instantly."
  }
];

const actionIds = [
  { id: "APPOINTMENT_READ_SLOTS", desc: "Queries real-time calendar grid for doctor availability and open time windows." },
  { id: "APPOINTMENT_WRITE_BOOKING", desc: "Injects verified patient name, phone, chair, and appointment type into schedule." },
  { id: "APPOINTMENT_VERIFY_READBACK", desc: "Re-queries newly written appointment slot to confirm database persistence." },
  { id: "PATIENT_QUERY_RECORD", desc: "Checks existing patient record by national ID or phone number before booking." },
  { id: "PATIENT_CREATE_RECORD", desc: "Generates new patient file in CMS when a first-time patient books via WhatsApp." },
  { id: "CHAIR_BLOCK_TIME", desc: "Synchronizes emergency doctor holds or operatory maintenance across channels." }
];
---

<Layout
  title="Features & Capabilities | LamaniSync Healthcare Bridge"
  description="Explore the comprehensive features of LamaniSync: Sub-second sync, multi-operatory chair routing, LamaniHub WhatsApp triage, verified writes, Manifest V3 security, and multi-branch support."
>
  <!-- Architectural Hero Section -->
  <section class="attio-section border-t border-subtle">
    <div class="attio-container border-x border-subtle">
      <header class="attio-section-head">
        <div class="attio-head-inner">
          <h1 class="attio-h2-inline">
            <span class="text-primary">Built for high-volume clinics.</span>
            <span class="text-muted font-normal"> Healthcare practices, specialist centers, and multi-operatory dental networks.</span>
          </h1>
          <p class="attio-lead-desc">
            Every layer of LamaniSync is purpose-built to eliminate manual front-desk entry, prevent double-bookings, and unlock autonomous 24/7 WhatsApp appointments.
          </p>
          <div class="hero-actions-wrap">
            <a href="#core-features" class="btn-dark-primary">Explore all features</a>
            <a href="https://lamanihub.com" target="_blank" rel="noopener noreferrer" class="btn-dark-secondary">View in LamaniHub</a>
          </div>
        </div>
      </header>

      <div class="attio-separator-wrap">
        <div class="attio-dashed-line"></div>
      </div>
    </div>
  </section>

  <!-- 6 Pillars Feature Grid (Attio Shaded Hatch Container + 1px Grid) -->
  <section class="attio-section shaded-bg" id="core-features">
    <div class="attio-container border-x border-subtle">
      <header class="attio-section-head">
        <div class="attio-head-inner">
          <h2 class="attio-h2-inline">
            <span class="text-primary">Six pillars of reliability.</span>
            <span class="text-muted font-normal"> Engineered under the hood of the universal ambient bridge.</span>
          </h2>
          <p class="attio-lead-desc">
            A hardened synchronization runtime designed to operate in background harmony with your existing clinic workflow.
          </p>
        </div>
      </header>

      <div class="attio-separator-wrap">
        <div class="attio-dashed-line"></div>
      </div>

      <div class="attio-hatch-container">
        <div class="attio-hatch-bg" aria-hidden="true"></div>
        <div class="attio-grid-wrap">
          <div class="attio-pillars-grid">
            {pillars.map((item) => (
              <div class="attio-cell">
                <div class="cell-overline">[{item.num}]</div>
                <h3 class="cell-title">{item.title}</h3>
                <p class="cell-desc">{item.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Action IDs Architecture Section -->
  <section class="attio-section border-t border-subtle" id="action-ids">
    <div class="attio-container border-x border-subtle">
      <header class="attio-section-head">
        <div class="attio-head-inner">
          <h2 class="attio-h2-inline">
            <span class="text-primary">Predefined adapter action IDs.</span>
            <span class="text-muted font-normal"> Bounded page execution with zero arbitrary remote code injection.</span>
          </h2>
          <p class="attio-lead-desc">
            LamaniSync executes only pre-compiled, cryptographically whitelisted functions. Third-party or unverified scripts are strictly blocked by browser extension security policies.
          </p>
        </div>
      </header>

      <div class="attio-separator-wrap">
        <div class="attio-dashed-line"></div>
      </div>

      <div class="action-grid-wrap">
        <div class="action-grid">
          {actionIds.map((act) => (
            <div class="action-cell">
              <div class="action-id-tag"><code>{act.id}</code></div>
              <p class="action-desc">{act.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <CtaBanner />
</Layout>

<style>
  .border-t { border-top: 1px solid #e2e8f0; }
  .border-x { border-left: 1px solid #e2e8f0; border-right: 1px solid #e2e8f0; }
  .border-subtle { border-color: #e2e8f0; }

  .attio-section { background: #ffffff; position: relative; }
  .attio-section.shaded-bg { background: #fafafa; }
  .attio-container { max-width: 1200px; margin: 0 auto; position: relative; background: #ffffff; }

  .attio-section-head { padding: 6rem 3.5rem 3rem 3.5rem; background: #ffffff; }
  .attio-head-inner { max-width: 860px; }

  .attio-h2-inline {
    font-size: clamp(2rem, 3.8vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0 0 1.25rem 0;
    text-wrap: balance;
  }
  .text-primary { color: #1c1d1f; }
  .text-muted { color: #6f7988; }
  .attio-lead-desc { font-size: 1.0625rem; color: #6f7988; line-height: 1.6; margin: 0; max-width: 680px; }

  .hero-actions-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .btn-dark-primary {
    background: #1c1d1f;
    border: 1px solid #1c1d1f;
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.6rem 1.25rem;
    border-radius: 6px;
    text-decoration: none;
    transition: background 0.15s ease;
  }
  .btn-dark-primary:hover { background: #000000; }

  .btn-dark-secondary {
    background: transparent;
    border: 1px solid #e2e8f0;
    color: #1c1d1f;
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.6rem 1.25rem;
    border-radius: 6px;
    text-decoration: none;
    transition: background 0.15s ease;
  }
  .btn-dark-secondary:hover { background: #f8fafc; }

  .attio-separator-wrap { position: relative; width: 100%; height: 1px; background: #e2e8f0; }
  .attio-dashed-line {
    width: 100%;
    height: 1px;
    background-image: linear-gradient(to right, #cbd5e1 50%, transparent 50%);
    background-size: 8px 1px;
  }

  /* Hatch Container & Inset Grid */
  .attio-hatch-container {
    position: relative;
    background-color: #fafafa;
    overflow: hidden;
    padding: 0 2rem;
  }
  .attio-hatch-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: repeating-linear-gradient(125deg, transparent, transparent 6px, rgba(15, 23, 42, 0.035) 6px, rgba(15, 23, 42, 0.035) 7px);
  }
  .attio-grid-wrap {
    position: relative;
    z-index: 1;
    border-left: 1px solid #e2e8f0;
    border-right: 1px solid #e2e8f0;
  }

  .attio-pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: #e2e8f0;
  }

  .attio-cell {
    background: #ffffff;
    padding: 3rem 2.25rem;
    display: flex;
    flex-direction: column;
    transition: background 0.15s ease;
  }
  .attio-cell:hover { background: #fafafa; }

  .cell-overline {
    font-size: 0.75rem;
    font-weight: 600;
    color: #94a3b8;
    letter-spacing: 0.08em;
    font-family: ui-monospace, SFMono-Regular, monospace;
    margin-bottom: 1.75rem;
  }
  .cell-title {
    font-size: 1.125rem;
    font-weight: 500;
    color: #1c1d1f;
    letter-spacing: -0.015em;
    line-height: 1.35;
    margin: 0 0 0.85rem 0;
  }
  .cell-desc { font-size: 0.875rem; color: #6f7988; line-height: 1.6; margin: 0; }

  /* Action Grid */
  .action-grid-wrap {
    background: #fafafa;
    padding: 3.5rem;
  }
  .action-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: #e2e8f0;
    border: 1px solid #e2e8f0;
  }
  .action-cell {
    background: #ffffff;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .action-id-tag code {
    font-size: 0.78rem;
    font-weight: 600;
    font-family: ui-monospace, SFMono-Regular, monospace;
    background: #f1f5f9;
    color: #0f172a;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    border: 1px solid #e2e8f0;
  }
  .action-desc {
    font-size: 0.875rem;
    color: #6f7988;
    line-height: 1.55;
    margin: 0;
  }

  @media (max-width: 960px) {
    .attio-pillars-grid { grid-template-columns: repeat(2, 1fr); }
    .action-grid { grid-template-columns: 1fr; }
    .action-grid-wrap { padding: 1.5rem; }
    .attio-section-head { padding: 4rem 1.5rem 2.5rem 1.5rem; }
    .attio-hatch-container { padding: 0 1rem; }
  }

  @media (max-width: 640px) {
    .attio-pillars-grid { grid-template-columns: 1fr; }
    .attio-hatch-container { padding: 0; }
    .attio-grid-wrap { border-left: none; border-right: none; }
    .hero-actions-wrap { flex-direction: column; align-items: stretch; }
  }
</style>
