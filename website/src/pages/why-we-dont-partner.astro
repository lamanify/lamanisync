---
import Layout from '../layouts/Layout.astro';
import CtaBanner from '../components/CtaBanner.astro';

const manifestoPoints = [
  {
    num: "01",
    title: "The Extortionate 'Partner Tax'",
    desc: "Legacy CMS companies charge third-party developers up to $10,000 upfront plus 30% monthly royalties just to access an API that touches your own clinic data. We refuse to pass that cost to clinics."
  },
  {
    num: "02",
    title: "The 12-Month Red Tape Queue",
    desc: "Partner programs are engineered to protect legacy CMS market share, not foster clinic agility. Clinics wait over a year for simple automated booking approvals. LamaniSync deploys in 60 seconds."
  },
  {
    num: "03",
    title: "Artificial API Throttling & Rate Limits",
    desc: "Official APIs intentionally throttle requests during peak morning appointment rushes, causing WhatsApp booking drops. LamaniSync runs with workstation velocity directly in the active browser tab."
  },
  {
    num: "04",
    title: "The Dropbox Analogy: Sovereign Domain",
    desc: "Dropbox didn't ask Microsoft for permission to sync files on Windows. Your clinic workstation is your sovereign hardware; staff have the absolute right to automate the software they legally pay for."
  }
];
---

<Layout
  title="Why We Don't Partner | Clinic Data Sovereignty Manifesto | LamaniSync"
  description="Read why LamaniSync doesn't wait for legacy CMS vendor permission, pay partner taxes, or allow software cartels to hold your clinic's calendar hostage. The Dropbox Analogy and clinic data rights."
>
  <!-- Architectural Hero Section -->
  <section class="attio-hero-section border-t border-subtle">
    <div class="attio-container border-x border-subtle">
      <header class="hero-header">
        <div class="eyebrow-wrapper">
          <h1 class="hero-eyebrow">
            <span class="eyebrow-dot"></span>
            <span>Healthcare Data Sovereignty</span>
          </h1>
        </div>

        <h2 class="hero-headline">
          Your data. Your rules.
        </h2>

        <p class="hero-description">
          <span>Why independent clinics shouldn't pay partner taxes or wait 12 months for vendor approval.</span>
          <br class="hidden sm:inline" />
          <span>The Dropbox model for healthcare data freedom: ambient execution on your sovereign hardware.</span>
        </p>

        <div class="hero-cta-group">
          <a href="/contact" class="btn-attio-primary">
            <span>Talk to our team</span>
          </a>
          <a href="#manifesto" class="btn-attio-secondary">
            <span>Read manifesto</span>
            <svg class="down-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none">
              <path d="M6 2.5V9.5M6 9.5L2.5 6M6 2.5L9.5 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </header>

            <!-- Contextual Interactive Sovereignty Comparison Architecture -->
      <div class="hero-diagram-frame">
        <div class="diagram-canvas">
          <svg class="diagram-svg-layer" viewBox="0 0 960 480" fill="none" preserveAspectRatio="xMidYMid meet">
            <!-- Top Track (Red Cartel Tollway) -->
            <path d="M 120 140 L 840 140" stroke="#fecaca" stroke-width="2" stroke-dasharray="6 6" />
            <line x1="480" y1="120" x2="480" y2="160" stroke="#ef4444" stroke-width="2.5" />

            <!-- Bottom Track (Green Sovereign Freeway) -->
            <path d="M 120 330 L 840 330" stroke="#10b981" stroke-width="2.5" />
            <circle class="pulse-particle" r="4.5" fill="#10b981">
              <animateMotion dur="2.2s" repeatCount="indefinite" path="M 120 330 L 840 330" />
            </circle>
          </svg>

          <!-- Top Track Container: The Partner Cartel Tollway -->
          <div class="track-header-top">
            <span class="track-badge red-track">THE LEGACY CARTEL TOLLWAY</span>
            <span class="track-sub">12-Month Wait • $10,000 Upfront Tax • Arbitrary Throttling</span>
          </div>

          <div class="schema-card track-node node-cartel-1">
            <div class="card-head">
              <div class="entity-icon bg-red-soft">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
              </div>
              <span class="entity-name">Vendor Paywall</span>
              <span class="entity-badge badge-red">BLOCKED</span>
            </div>
            <div class="card-attrs">
              <div class="attr-row"><span class="attr-bullet red-dot"></span><span class="attr-label">$10,000 "Partner Fee"</span></div>
              <div class="attr-more">Extortionate Toll</div>
            </div>
          </div>

          <div class="schema-card track-node node-cartel-2">
            <div class="card-head">
              <div class="entity-icon bg-red-soft">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              </div>
              <span class="entity-name">Approval Queue</span>
              <span class="entity-badge badge-red">12 MONTHS</span>
            </div>
            <div class="card-attrs">
              <div class="attr-row"><span class="attr-bullet red-dot"></span><span class="attr-label">Partner Committee Review</span></div>
              <div class="attr-more">Artificial Gatekeeping</div>
            </div>
          </div>

          <div class="schema-card track-node node-cartel-3">
            <div class="card-head">
              <div class="entity-icon bg-red-soft">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/></svg>
              </div>
              <span class="entity-name">API Rate Limit</span>
              <span class="entity-badge badge-red">THROTTLED</span>
            </div>
            <div class="card-attrs">
              <div class="attr-row"><span class="attr-bullet red-dot"></span><span class="attr-label">Fails on Monday morning</span></div>
              <div class="attr-more">Vendor Lock-In</div>
            </div>
          </div>

          <!-- Bottom Track Container: The LamaniSync Sovereign Bridge -->
          <div class="track-header-bottom">
            <span class="track-badge green-track">THE LAMANISYNC SOVEREIGN MODEL (THE DROPBOX ANALOGY)</span>
            <span class="track-sub">Zero Permission Needed • Direct Workstation Velocity • 60-Second Setup</span>
          </div>

          <div class="schema-card track-node node-sovereign-1">
            <div class="card-head">
              <div class="entity-icon bg-emerald">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
              </div>
              <span class="entity-name">Your Hardware</span>
              <span class="entity-badge badge-green">SOVEREIGN</span>
            </div>
            <div class="card-attrs">
              <div class="attr-row"><span class="attr-bullet active"></span><span class="attr-label">Staff Reception PC</span></div>
              <div class="attr-more">You own the machine</div>
            </div>
          </div>

          <div class="schema-card track-node node-sovereign-2">
            <div class="card-head">
              <div class="entity-icon bg-purple">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              </div>
              <span class="entity-name">Ambient Bridge</span>
              <span class="entity-badge badge-green">DIRECT</span>
            </div>
            <div class="card-attrs">
              <div class="attr-row"><span class="attr-bullet active"></span><span class="attr-label">Standard Chrome Extension</span></div>
              <div class="attr-more">No Vendor Approval</div>
            </div>
          </div>

          <div class="schema-card track-node node-sovereign-3">
            <div class="card-head">
              <div class="entity-icon bg-blue">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="20 6 9 17 4 12"/></svg>
              </div>
              <span class="entity-name">Instant Growth</span>
              <span class="entity-badge badge-blue">AUTOPILOT</span>
            </div>
            <div class="card-attrs">
              <div class="attr-row"><span class="attr-bullet active"></span><span class="attr-label">Live in 60 seconds</span></div>
              <div class="attr-more">Zero Partner Tax</div>
            </div>
          </div>

          <!-- Contextual Floating Pill -->
          <div class="floating-query-pill">
            <div class="pill-sparkle">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            </div>
            <span class="pill-text">Staff input the data. You own the computer. You own the synchronization.</span>
            <div class="pill-status-dot"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Manifesto Pillars in 1px Hairline Grid -->
  <section class="attio-section shaded-bg border-t border-subtle" id="manifesto">
    <div class="attio-container border-x border-subtle">
      <header class="attio-section-head">
        <div class="attio-head-inner">
          <h2 class="attio-h2-inline">
            <span class="text-primary">Four foundational truths.</span>
            <span class="text-muted font-normal"> Breaking down the healthcare software cartel.</span>
          </h2>
          <p class="attio-lead-desc">
            Healthcare technology moves forward when independent clinics hold the keys to their operational software.
          </p>
        </div>
      </header>

      <div class="attio-separator-wrap">
        <div class="attio-dashed-line"></div>
      </div>

      <div class="attio-hatch-container">
        <div class="attio-hatch-bg" aria-hidden="true"></div>
        <div class="attio-grid-wrap">
          <div class="manifesto-grid">
            {manifestoPoints.map((item) => (
              <div class="manifesto-cell">
                <div class="cell-overline">[{item.num}]</div>
                <h3 class="cell-title">{item.title}</h3>
                <p class="cell-desc">{item.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Quote Section -->
  <section class="attio-section border-t border-subtle">
    <div class="attio-container border-x border-subtle">
      <div class="quote-box">
        <blockquote class="serif-quote">
          "If your clinic pays for software and staff enter the data, your clinic owns that data. An ambient browser bridge is not an intrusion—it is an exercise of your fundamental digital property rights."
        </blockquote>
        <div class="quote-author">— The LamaniSync Architecture Working Group</div>
      </div>
    </div>
  </section>

  <CtaBanner />
</Layout>

<style>
  .border-t { border-top: 1px solid #e2e8f0; }
  .border-x { border-left: 1px solid #e2e8f0; border-right: 1px solid #e2e8f0; }
  .border-subtle { border-color: #e2e8f0; }

  .attio-hero-section { background: #ffffff; position: relative; overflow: hidden; }
  .attio-section { background: #ffffff; position: relative; }
  .attio-section.shaded-bg { background: #fafafa; }
  .attio-container { max-width: 1200px; margin: 0 auto; position: relative; background: #ffffff; }

  /* Hero Copy Header */
  .hero-header {
    padding: 6.5rem 2rem 3.5rem 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .eyebrow-wrapper { margin-bottom: 1.5rem; }
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    padding: 0.35rem 0.95rem;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: #475569;
    letter-spacing: -0.01em;
    margin: 0;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
  }
  .eyebrow-dot { width: 6px; height: 6px; border-radius: 50%; background: #10b981; }

  .hero-headline {
    font-size: clamp(2.5rem, 5.5vw, 4.25rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.1;
    color: #1c1d1f;
    margin: 0 0 1.25rem 0;
    text-wrap: balance;
  }

  .hero-description {
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    font-weight: 400;
    color: #6f7988;
    line-height: 1.5;
    margin: 0 0 2.25rem 0;
    max-width: 680px;
    text-wrap: balance;
  }

  .hero-cta-group {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
  }
  .btn-attio-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #1c1d1f;
    color: #ffffff;
    font-size: 0.9375rem;
    font-weight: 500;
    padding: 0.65rem 1.4rem;
    border-radius: 9999px;
    text-decoration: none;
    border: 1px solid #1c1d1f;
    transition: background-color 0.15s ease;
  }
  .btn-attio-primary:hover { background-color: #000000; }

  .btn-attio-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    background-color: #ffffff;
    color: #1c1d1f;
    font-size: 0.9375rem;
    font-weight: 500;
    padding: 0.65rem 1.4rem;
    border-radius: 9999px;
    text-decoration: none;
    border: 1px solid #e2e8f0;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }
  .btn-attio-secondary:hover { background-color: #f8fafc; border-color: #cbd5e1; }
  .down-arrow { transition: transform 0.15s ease; }
  .btn-attio-secondary:hover .down-arrow { transform: translateY(2px); }

  
  .track-header-top { position: absolute; top: 22px; left: 45px; display: flex; align-items: center; gap: 0.75rem; z-index: 2; }
  .track-header-bottom { position: absolute; top: 235px; left: 45px; display: flex; align-items: center; gap: 0.75rem; z-index: 2; }
  .track-badge { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.05em; font-family: ui-monospace, monospace; padding: 0.2rem 0.5rem; border-radius: 4px; }
  .red-track { background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; }
  .green-track { background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; }
  .track-sub { font-size: 0.72rem; color: #94a3b8; font-weight: 500; }

  .track-node { width: 195px; }
  .node-cartel-1 { top: 65px; left: 45px; }
  .node-cartel-2 { top: 65px; left: 50%; transform: translateX(-50%); }
  .node-cartel-3 { top: 65px; right: 45px; }

  .node-sovereign-1 { top: 280px; left: 45px; }
  .node-sovereign-2 { top: 280px; left: 50%; transform: translateX(-50%); }
  .node-sovereign-3 { top: 280px; right: 45px; }

  .bg-red-soft { background: #fee2e2; color: #b91c1c; }
  .badge-red { background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; }
  .red-dot { background: #ef4444 !important; }

  /* Diagram Frame & Dot Matrix Canvas */
  .hero-diagram-frame { position: relative; padding: 0 2rem 5rem 2rem; }
  .diagram-canvas {
    position: relative;
    width: 100%;
    min-height: 520px;
    background-color: #ffffff;
    background-image: radial-gradient(#cbd5e1 1.2px, transparent 1.2px);
    background-size: 24px 24px;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    overflow: hidden;
  }

  .diagram-svg-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  .schema-card {
    position: absolute;
    z-index: 2;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05);
    width: 230px;
    padding: 0.85rem 1rem;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease;
  }
  .schema-card:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08); }

  .node-top-left { top: 45px; left: 45px; }
  .node-top-right { top: 45px; right: 45px; }
  .node-center-hub {
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 250px;
    border-color: #cbd5e1;
  }
  .node-center-hub:hover { transform: translate(-50%, calc(-50% - 2px)); }
  .node-bottom-left { bottom: 65px; left: 60px; }
  .node-bottom-right { bottom: 65px; right: 60px; }

  .card-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #f1f5f9;
  }
  .entity-icon {
    width: 24px;
    height: 24px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .bg-emerald { background: #dcfce7; color: #15803d; }
  .bg-indigo { background: #e0e7ff; color: #4338ca; }
  .bg-purple { background: #f3e8ff; color: #7e22ce; }
  .bg-blue { background: #dbeafe; color: #1d4ed8; }
  .bg-amber { background: #fef3c7; color: #b45309; }

  .entity-name { font-size: 0.8125rem; font-weight: 600; color: #1c1d1f; flex: 1; }
  .entity-badge { font-size: 0.65rem; font-weight: 500; padding: 0.15rem 0.45rem; border-radius: 9999px; }
  .badge-blue { background: #eff6ff; color: #2563eb; }
  .badge-gray { background: #f1f5f9; color: #64748b; }
  .badge-green { background: #f0fdf4; color: #166534; }

  .card-attrs { display: flex; flex-direction: column; gap: 0.35rem; }
  .attr-row { display: flex; align-items: center; gap: 0.45rem; font-size: 0.72rem; color: #475569; }
  .attr-bullet { width: 4px; height: 4px; border-radius: 50%; background: #cbd5e1; }
  .attr-bullet.active { background: #10b981; }
  .attr-label { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .highlight-row { font-weight: 600; color: #1e293b; }
  .attr-more { font-size: 0.68rem; color: #94a3b8; font-weight: 500; margin-top: 0.2rem; }

  .floating-query-pill {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    padding: 0.45rem 1rem;
    border-radius: 9999px;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.08);
  }
  .pill-sparkle { color: #8b5cf6; display: flex; align-items: center; }
  .pill-text { font-size: 0.8125rem; color: #64748b; }
  .pill-status-dot { width: 7px; height: 7px; border-radius: 50%; background: #10b981; }

  /* Manifesto Section Head */
  .attio-section-head { padding: 6rem 3.5rem 3rem 3.5rem; background: #ffffff; }
  .attio-head-inner { max-width: 860px; }
  .attio-h2-inline { font-size: clamp(2rem, 3.8vw, 3rem); font-weight: 500; letter-spacing: -0.03em; line-height: 1.15; margin: 0 0 1.25rem 0; }
  .text-primary { color: #1c1d1f; }
  .text-muted { color: #6f7988; }
  .attio-lead-desc { font-size: 1.0625rem; color: #6f7988; line-height: 1.6; margin: 0; max-width: 680px; }

  .attio-separator-wrap { position: relative; width: 100%; height: 1px; background: #e2e8f0; }
  .attio-dashed-line { width: 100%; height: 1px; background-image: linear-gradient(to right, #cbd5e1 50%, transparent 50%); background-size: 8px 1px; }

  .attio-hatch-container { position: relative; background-color: #fafafa; overflow: hidden; padding: 0 2rem; }
  .attio-hatch-bg { position: absolute; inset: 0; pointer-events: none; background-image: repeating-linear-gradient(125deg, transparent, transparent 6px, rgba(15, 23, 42, 0.035) 6px, rgba(15, 23, 42, 0.035) 7px); }
  .attio-grid-wrap { position: relative; z-index: 1; border-left: 1px solid #e2e8f0; border-right: 1px solid #e2e8f0; }

  .manifesto-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: #e2e8f0; }
  .manifesto-cell { background: #ffffff; padding: 3.5rem 2.5rem; display: flex; flex-direction: column; transition: background 0.15s ease; }
  .manifesto-cell:hover { background: #fafafa; }
  .cell-overline { font-size: 0.75rem; font-weight: 600; color: #94a3b8; letter-spacing: 0.08em; font-family: ui-monospace, SFMono-Regular, monospace; margin-bottom: 1.5rem; }
  .cell-title { font-size: 1.2rem; font-weight: 500; color: #1c1d1f; letter-spacing: -0.015em; margin-bottom: 0.85rem; }
  .cell-desc { font-size: 0.875rem; color: #6f7988; line-height: 1.6; margin: 0; }

  .quote-box { padding: 5rem 3.5rem; background: #ffffff; text-align: center; max-width: 860px; margin: 0 auto; }
  .serif-quote { font-family: Georgia, Cambria, 'Times New Roman', Times, serif; font-size: clamp(1.25rem, 2.2vw, 1.65rem); font-style: italic; color: #1c1d1f; line-height: 1.5; margin: 0 0 1.5rem 0; }
  .quote-author { font-size: 0.82rem; font-weight: 600; color: #64748b; font-family: ui-monospace, SFMono-Regular, monospace; text-transform: uppercase; letter-spacing: 0.06em; }

  @media (max-width: 900px) {
    .diagram-canvas { min-height: 700px; }
    .schema-card { width: 190px; padding: 0.65rem 0.75rem; }
    .node-top-left { top: 20px; left: 20px; }
    .node-top-right { top: 20px; right: 20px; }
    .node-bottom-left { bottom: 80px; left: 20px; }
    .node-bottom-right { bottom: 80px; right: 20px; }
    .manifesto-grid { grid-template-columns: 1fr; }
    .attio-section-head { padding: 4rem 1.5rem 2.5rem 1.5rem; }
    .quote-box { padding: 3.5rem 1.5rem; }
    .hero-header { padding: 4.5rem 1.5rem 2.5rem 1.5rem; }
    .hero-diagram-frame { padding: 0 1rem 3rem 1rem; }
  }

  @media (max-width: 640px) {
    .diagram-canvas { display: flex; flex-direction: column; gap: 1rem; padding: 1.5rem 1rem 4.5rem 1rem; min-height: auto; }
    .diagram-svg-layer { display: none; }
    .schema-card { position: relative; top: auto !important; left: auto !important; right: auto !important; bottom: auto !important; transform: none !important; width: 100%; }
    .hero-cta-group { flex-direction: column; align-items: stretch; width: 100%; }
