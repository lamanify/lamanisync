---
import Layout from '../../layouts/Layout.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { docCategories, docArticles, type DocArticle } from '../../data/docs';
import { renderMarkdown } from '../../data/markdown';

export function getStaticPaths() {
  return docArticles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: DocArticle;
}

const { article } = Astro.props;

const currentCat = docCategories.find((c) => c.slug === article.categorySlug);
const currentIndex = docArticles.findIndex((a) => a.slug === article.slug);
const prevArticle = currentIndex > 0 ? docArticles[currentIndex - 1] : null;
const nextArticle = currentIndex < docArticles.length - 1 ? docArticles[currentIndex + 1] : null;

const renderedContent = renderMarkdown(article.content);
---

<Layout
  title={`${article.title} | LamaniSync Technical Docs`}
  description={article.description}
>
  <div class="attio-outer-gutter">
    <div class="attio-container border-x border-subtle">

      <!-- Architectural Breadcrumb Strip -->
      <div class="attio-doc-topbar border-b border-subtle">
        <nav class="docs-breadcrumbs" aria-label="Breadcrumb">
          <a href="/docs" class="back-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
            <span>All Docs</span>
          </a>
          <span class="crumb-sep">/</span>
          {currentCat && (
            <>
              <a href={`/docs#${currentCat.slug}`} class="crumb-link">{currentCat.title}</a>
              <span class="crumb-sep">/</span>
            </>
          )}
          <span class="crumb-active">{article.title}</span>
        </nav>
      </div>

      <!-- Main Docs Layout Grid (Sticky Sidebar + Content) -->
      <div class="docs-workspace-grid">
        <!-- Sidebar Navigation -->
        <aside class="attio-sidebar" id="docs-sidebar">
          <div class="sidebar-inner">
            <div class="sidebar-title">[INDEX] Architecture Guides</div>
            <nav class="sidebar-nav">
              {docCategories.map((cat) => (
                <div class="sidebar-cat-group">
                  <div class="cat-label">{cat.title}</div>
                  <ul class="cat-list">
                    {cat.articles.map((art) => {
                      const isActive = art.slug === article.slug;
                      return (
                        <li>
                          <a
                            href={`/docs/${art.slug}`}
                            class={`article-link ${isActive ? 'active' : ''}`}
                            aria-current={isActive ? 'page' : undefined}
                          >
                            <span class="active-dot"></span>
                            <span class="link-text">{art.title}</span>
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                </div>
              ))}
            </nav>

            <div class="sidebar-callout">
              <div class="callout-title">Custom Adapter?</div>
              <p class="callout-text">We build specialized DOM adapters for legacy Windows EHRs.</p>
              <a href="/contact" class="callout-link">Speak with IT Support &rarr;</a>
            </div>
          </div>
        </aside>

        <!-- Document Content Body -->
        <main class="attio-doc-main">
          <!-- Article Header -->
          <header class="doc-header">
            <div class="doc-eyebrow-pill">
              <span class="status-indicator-dot"></span>
              <span class="pill-title">{article.category}</span>
              <span class="pill-meta">• {article.readTime} read • Updated {article.lastUpdated}</span>
            </div>

            <h1 class="doc-display-title">{article.title}</h1>
            <p class="doc-lead-desc">{article.description}</p>
          </header>

          <!-- Markdown Content Body -->
          <div class="doc-prose-body" set:html={renderedContent} />

          <!-- Prev / Next Navigation Footer -->
          <div class="attio-doc-pagination border-t border-subtle">
            {prevArticle ? (
              <a href={`/docs/${prevArticle.slug}`} class="page-nav prev">
                <span class="nav-dir">&larr; Previous Guide</span>
                <span class="nav-title">{prevArticle.title}</span>
              </a>
            ) : <div class="page-nav-placeholder"></div>}

            {nextArticle ? (
              <a href={`/docs/${nextArticle.slug}`} class="page-nav next">
                <span class="nav-dir">Next Guide &rarr;</span>
                <span class="nav-title">{nextArticle.title}</span>
              </a>
            ) : <div class="page-nav-placeholder"></div>}
          </div>
        </main>
      </div>

    </div>
  </div>

  <CtaBanner />
</Layout>

<style>
  /* Attio Gutter & Container */
  .attio-outer-gutter {
    background-color: #fafafa;
    background-image: repeating-linear-gradient(
      125deg,
      #e2e8f0 0,
      #e2e8f0 1px,
      transparent 1px,
      transparent 8px
    );
    min-height: 100vh;
  }
  .attio-container {
    max-width: 1200px;
    margin: 0 auto;
    background-color: #ffffff;
  }
  .border-subtle { border-color: #e2e8f0; }

  /* Top Bar */
  .attio-doc-topbar {
    padding: 0.85rem 1.5rem;
    background: #ffffff;
  }
  .docs-breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: #6f7988;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: #1c1d1f;
    font-weight: 600;
    text-decoration: none;
  }
  .back-link svg { width: 14px; height: 14px; }
  .crumb-sep { color: #cbd5e1; }
  .crumb-link { color: #6f7988; text-decoration: none; }
  .crumb-link:hover { color: #1c1d1f; }
  .crumb-active { color: #1c1d1f; font-weight: 500; }

  /* Workspace Grid: Sidebar + Main */
  .docs-workspace-grid {
    display: grid;
    grid-template-columns: 280px 1fr;
    min-height: 800px;
  }

  /* Sidebar */
  .attio-sidebar {
    border-right: 1px solid #e2e8f0;
    background: #fafafa;
    padding: 2rem 1.25rem;
  }
  .sidebar-inner {
    position: sticky;
    top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .sidebar-title {
    font-family: ui-monospace, monospace;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: #94a3b8;
  }
  .sidebar-cat-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
  }
  .cat-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: #1c1d1f;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .cat-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .article-link {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.5rem;
    border-radius: 6px;
    font-size: 0.8rem;
    color: #475569;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .article-link:hover {
    color: #1c1d1f;
    background: #f1f5f9;
  }
  .article-link.active {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    color: #1c1d1f;
    font-weight: 600;
    box-shadow: 0 1px 3px rgba(15,23,42,0.04);
  }
  .active-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: transparent;
  }
  .article-link.active .active-dot {
    background-color: #10b981;
  }
  .link-text { line-height: 1.3; }

  /* Callout */
  .sidebar-callout {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 1rem;
  }
  .callout-title { font-size: 0.8rem; font-weight: 600; color: #1c1d1f; margin-bottom: 0.25rem; }
  .callout-text { font-size: 0.75rem; color: #6f7988; line-height: 1.4; margin-bottom: 0.5rem; }
  .callout-link { font-size: 0.75rem; font-weight: 600; color: #1c1d1f; text-decoration: none; }

  /* Main Document Area */
  .attio-doc-main {
    padding: 3rem 3.5rem;
    background: #ffffff;
    max-width: 860px;
  }
  .doc-header {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid #f1f5f9;
  }
  .doc-eyebrow-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    border: 1px solid #e2e8f0;
    background: #ffffff;
    margin-bottom: 1.25rem;
  }
  .status-indicator-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #10b981;
  }
  .pill-title { font-size: 0.72rem; font-weight: 600; color: #1c1d1f; }
  .pill-meta { font-size: 0.72rem; color: #94a3b8; }

  .doc-display-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 600;
    color: #1c1d1f;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: 1rem;
  }
  .doc-lead-desc {
    font-size: 1.125rem;
    color: #6f7988;
    line-height: 1.6;
    margin: 0;
  }

  /* Prose Typography & Formatting */
  .doc-prose-body {
    font-size: 0.95rem;
    line-height: 1.7;
    color: #334155;
  }
  .doc-prose-body :global(h2) {
    font-size: 1.5rem;
    font-weight: 600;
    color: #1c1d1f;
    letter-spacing: -0.02em;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #f1f5f9;
  }
  .doc-prose-body :global(h3) {
    font-size: 1.2rem;
    font-weight: 600;
    color: #1c1d1f;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .doc-prose-body :global(p) {
    margin-bottom: 1.25rem;
  }
  .doc-prose-body :global(ul), .doc-prose-body :global(ol) {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }
  .doc-prose-body :global(li) {
    margin-bottom: 0.4rem;
  }
  .doc-prose-body :global(pre) {
    background: #0b0c0e;
    color: #e2e8f0;
    border: 1px solid #27272a;
    border-radius: 8px;
    padding: 1.25rem;
    overflow-x: auto;
    font-size: 0.85rem;
    margin-bottom: 1.5rem;
  }
  .doc-prose-body :global(code) {
    font-family: ui-monospace, monospace;
    font-size: 0.85em;
    background: #f1f5f9;
    color: #0f172a;
    padding: 0.15rem 0.35rem;
    border-radius: 4px;
    border: 1px solid #e2e8f0;
  }
  .doc-prose-body :global(pre code) {
    background: transparent;
    color: inherit;
    border: none;
    padding: 0;
  }
  .doc-prose-body :global(blockquote) {
    border-left: 3px solid #1c1d1f;
    background: #f8fafc;
    padding: 0.75rem 1.25rem;
    margin: 1.5rem 0;
    color: #475569;
    border-radius: 0 6px 6px 0;
  }

  /* Pagination Nav */
  .attio-doc-pagination {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 3.5rem;
    padding-top: 2rem;
  }
  .page-nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.75rem 1rem;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    text-decoration: none;
    max-width: 320px;
    transition: all 0.15s ease;
  }
  .page-nav:hover {
    border-color: #1c1d1f;
    background: #fcfcfd;
  }
  .page-nav.next { text-align: right; margin-left: auto; }
  .nav-dir { font-size: 0.72rem; color: #94a3b8; font-family: ui-monospace, monospace; }
  .nav-title { font-size: 0.85rem; font-weight: 600; color: #1c1d1f; }
  .page-nav-placeholder { flex: 1; }

  @media (max-width: 768px) {
    .docs-workspace-grid { grid-template-columns: 1fr; }
    .attio-sidebar { border-right: none; border-bottom: 1px solid #e2e8f0; }
    .attio-doc-main { padding: 2rem 1.5rem; }
  }
</style>
