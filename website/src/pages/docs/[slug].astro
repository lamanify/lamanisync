---
import Layout from '../../layouts/Layout.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { docCategories, docArticles, type DocArticle } from '../../data/docs';
import { renderMarkdown } from '../../data/markdown';

export function getStaticPaths() {
  return docArticles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: DocArticle;
}

const { article } = Astro.props;

const currentCat = docCategories.find((c) => c.slug === article.categorySlug);
const currentIndex = docArticles.findIndex((a) => a.slug === article.slug);
const prevArticle = currentIndex > 0 ? docArticles[currentIndex - 1] : null;
const nextArticle = currentIndex < docArticles.length - 1 ? docArticles[currentIndex + 1] : null;

const renderedContent = renderMarkdown(article.content);
---

<Layout
  title={`${article.title} | LamaniSync Knowledge Base`}
  description={article.description}
>
  <div class="docs-layout-container">
    <div class="container docs-shell">
      <!-- Mobile Sidebar Toggle -->
      <div class="mobile-sidebar-bar">
        <button id="docs-sidebar-toggle" class="docs-sidebar-toggle" aria-expanded="false" aria-label="Toggle Documentation Navigation">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
          <span>All Documentation Guides</span>
        </button>
      </div>

      <div class="docs-grid">
        <!-- Sticky Sidebar Navigation -->
        <aside class="docs-sidebar" id="docs-sidebar">
          <div class="sidebar-inner">
            <div class="sidebar-header">
              <a href="/docs" class="sidebar-back-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                <span>Docs Home</span>
              </a>
            </div>

            <nav class="sidebar-nav" aria-label="Documentation Navigation">
              {docCategories.map((cat) => (
                <div class="sidebar-cat-group">
                  <div class="sidebar-cat-title">
                    <span>{cat.title}</span>
                  </div>
                  <ul class="sidebar-articles-list">
                    {cat.articles.map((art) => {
                      const isActive = art.slug === article.slug;
                      return (
                        <li>
                          <a
                            href={`/docs/${art.slug}`}
                            class={`sidebar-article-link ${isActive ? 'active' : ''}`}
                            aria-current={isActive ? 'page' : undefined}
                          >
                            <span class="active-indicator"></span>
                            <span class="link-label">{art.title}</span>
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                </div>
              ))}
            </nav>

            <div class="sidebar-footer-box">
              <div class="footer-box-title">Need custom adapter?</div>
              <p class="footer-box-desc">Our team provides custom EHR and web CMS bridge manifests.</p>
              <a href="/contact" class="footer-box-btn">Contact IT Support →</a>
            </div>
          </div>
        </aside>

        <!-- Main Document Area -->
        <main class="docs-main">
          <!-- Breadcrumb Navigation -->
          <nav class="docs-breadcrumbs" aria-label="Breadcrumb">
            <a href="/" class="crumb-link">Home</a>
            <span class="crumb-sep">/</span>
            <a href="/docs" class="crumb-link">Docs</a>
            <span class="crumb-sep">/</span>
            {currentCat && (
              <>
                <a href={`/docs#${currentCat.slug}`} class="crumb-link crumb-current-cat">{currentCat.title}</a>
                <span class="crumb-sep">/</span>
              </>
            )}
            <span class="crumb-active">{article.title}</span>
          </nav>

          <!-- Article Header -->
          <header class="doc-header">
            <div class="doc-meta-row">
              <span class="category-pill">{article.category}</span>
              <span class="meta-dot">•</span>
              <span class="meta-time">{article.readTime}</span>
              <span class="meta-dot">•</span>
              <span class="meta-date">Updated {article.lastUpdated}</span>
            </div>

            <h1 class="doc-title">{article.title}</h1>
            <p class="doc-lead">{article.description}</p>
          </header>

          <!-- Rendered Markdown Body -->
          <article class="doc-content">
            <div class="article-prose" set:html={renderedContent} />
          </article>

          <!-- Feedback Rating Component (Modeled after NexHealth docs) -->
          <section class="feedback-section">
            <div class="feedback-card" id="feedback-card">
              <div class="feedback-prompt" id="feedback-prompt">
                <span class="feedback-question">Did this guide help you?</span>
                <div class="feedback-buttons">
                  <button type="button" class="feedback-btn yes-btn" id="feedback-yes" aria-label="Yes, this guide helped">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"></path>
                    </svg>
                    <span>Yes</span>
                  </button>
                  <button type="button" class="feedback-btn no-btn" id="feedback-no" aria-label="No, this guide did not help">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M10 15v4a3 3 0 0 0 3 3l4-9V2H5.72a2 2 0 0 0-2 1.7l-1.38 9a2 2 0 0 0 2 2.3zm7-13h3a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2h-3"></path>
                    </svg>
                    <span>No</span>
                  </button>
                </div>
              </div>
              <div class="feedback-ack feedback-ack-yes" id="feedback-ack-yes" style="display: none;">
                <svg viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                <span>Thank you! We are glad this guide helped your clinic.</span>
              </div>
              <div class="feedback-ack feedback-ack-no" id="feedback-ack-no" style="display: none;">
                <svg viewBox="0 0 24 24" fill="none" stroke="#e92451" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                <span>Thanks for the feedback. Need help? <a href="/contact" class="ack-contact-link">Contact our engineering team →</a></span>
              </div>
            </div>
          </section>

          <!-- Prev / Next Pagination -->
          <nav class="doc-pagination" aria-label="Document pagination">
            {prevArticle ? (
              <a href={`/docs/${prevArticle.slug}`} class="page-nav-link prev">
                <span class="nav-direction">← Previous Guide</span>
                <span class="nav-title">{prevArticle.title}</span>
              </a>
            ) : <div class="page-nav-placeholder"></div>}

            {nextArticle ? (
              <a href={`/docs/${nextArticle.slug}`} class="page-nav-link next">
                <span class="nav-direction">Next Guide →</span>
                <span class="nav-title">{nextArticle.title}</span>
              </a>
            ) : <div class="page-nav-placeholder"></div>}
          </nav>
        </main>
      </div>
    </div>
  </div>

  <CtaBanner />
</Layout>

<script>
  // Mobile sidebar drawer handler
  const sidebarToggle = document.getElementById('docs-sidebar-toggle');
  const sidebar = document.getElementById('docs-sidebar');
  if (sidebarToggle && sidebar) {
    sidebarToggle.addEventListener('click', () => {
      const isOpen = sidebar.classList.toggle('open');
      sidebarToggle.setAttribute('aria-expanded', String(isOpen));
    });
  }

  // Interactive feedback rating
  const yesBtn = document.getElementById('feedback-yes');
  const noBtn = document.getElementById('feedback-no');
  const promptBox = document.getElementById('feedback-prompt');
  const ackYes = document.getElementById('feedback-ack-yes');
  const ackNo = document.getElementById('feedback-ack-no');

  if (yesBtn && promptBox && ackYes) {
    yesBtn.addEventListener('click', () => {
      promptBox.style.display = 'none';
      ackYes.style.display = 'flex';
    });
  }

  if (noBtn && promptBox && ackNo) {
    noBtn.addEventListener('click', () => {
      promptBox.style.display = 'none';
      ackNo.style.display = 'flex';
    });
  }
</script>

<style>
  .docs-layout-container {
    background: #ffffff;
    min-height: calc(100vh - var(--nav-height));
    position: relative;
    padding: 2rem 0 5rem 0;
  }

  .docs-shell {
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
  }

  /* Mobile Sidebar Toggle Bar */
  .mobile-sidebar-bar {
    display: none;
    margin-bottom: 1.5rem;
  }

  .docs-sidebar-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    min-height: 44px;
    padding: 0.65rem 1rem;
    background: #f8fafc;
    border: 1px solid var(--border-hairline);
    border-radius: 8px;
    font-size: 0.88rem;
    font-weight: 600;
    color: #0f172a;
    cursor: pointer;
    font-family: inherit;
  }

  .docs-sidebar-toggle svg {
    width: 18px;
    height: 18px;
  }

  /* Main Grid */
  .docs-grid {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 3.5rem;
    align-items: start;
    position: relative;
  }

  /* Sidebar Navigation */
  .docs-sidebar {
    position: sticky;
    top: calc(var(--nav-height) + 1.5rem);
    max-height: calc(100vh - var(--nav-height) - 3rem);
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding-right: 1rem;
  }

  .sidebar-header {
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-hairline);
  }

  .sidebar-back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--text-muted);
    text-decoration: none;
    min-height: 44px;
    transition: color 0.15s ease;
  }

  .sidebar-back-link:hover {
    color: var(--primary);
  }

  .sidebar-back-link svg {
    width: 15px;
    height: 15px;
  }

  .sidebar-cat-group {
    margin-bottom: 1.75rem;
  }

  .sidebar-cat-title {
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #0f172a;
    margin-bottom: 0.65rem;
    padding: 0 0.5rem;
  }

  .sidebar-articles-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .sidebar-article-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.85rem;
    color: #475569;
    text-decoration: none;
    padding: 0.5rem 0.65rem;
    min-height: 44px;
    border-radius: 6px;
    line-height: 1.35;
    transition: all 0.15s ease;
  }

  .sidebar-article-link:hover {
    background: #f8fafc;
    color: #0f172a;
  }

  .sidebar-article-link.active {
    background: var(--primary-subtle);
    color: var(--primary);
    font-weight: 600;
  }

  .active-indicator {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: transparent;
    flex-shrink: 0;
  }

  .sidebar-article-link.active .active-indicator {
    background: var(--primary);
  }

  .link-label {
    flex-grow: 1;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .sidebar-footer-box {
    margin-top: 2rem;
    padding: 1.25rem;
    background: #fafafa;
    border: 1px solid var(--border-hairline);
    border-radius: 12px;
  }

  .footer-box-title {
    font-size: 0.84rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 0.35rem;
  }

  .footer-box-desc {
    font-size: 0.78rem;
    color: var(--text-muted);
    line-height: 1.45;
    margin-bottom: 0.75rem;
  }

  .footer-box-btn {
    display: inline-flex;
    align-items: center;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--primary);
    text-decoration: none;
    min-height: 44px;
    transition: color 0.15s;
  }

  .footer-box-btn:hover {
    color: var(--primary-dark);
  }

  /* Main Content Area */
  .docs-main {
    min-width: 0;
    width: 100%;
    max-width: 820px;
  }

  /* Breadcrumbs */
  .docs-breadcrumbs {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.45rem;
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: 1.75rem;
  }

  .crumb-link {
    color: var(--text-muted);
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    transition: color 0.15s;
  }

  .crumb-link:hover {
    color: var(--primary);
  }

  .crumb-sep {
    color: #cbd5e1;
  }

  .crumb-current-cat {
    color: #475569;
    font-weight: 500;
  }

  .crumb-active {
    color: #0f172a;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 320px;
  }

  /* Header */
  .doc-header {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-hairline);
  }

  .doc-meta-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  .category-pill {
    background: var(--primary-subtle);
    color: var(--primary);
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    border: 1px solid var(--primary-border);
  }

  .meta-dot {
    color: #cbd5e1;
  }

  .doc-title {
    font-size: clamp(1.8rem, 3.8vw, 2.8rem);
    font-weight: 800;
    color: #0a0a0a;
    letter-spacing: -0.025em;
    line-height: 1.2;
    margin-bottom: 1rem;
    overflow-wrap: break-word;
  }

  .doc-lead {
    font-size: 1.1rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  /* Prose */
  .doc-content {
    width: 100%;
    min-width: 0;
  }

  .article-prose {
    font-size: 1.02rem;
    line-height: 1.8;
    color: #334155;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    overflow-wrap: break-word;
  }

  :global(.article-prose .article-h2) {
    font-size: 1.6rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.02em;
    margin-top: 2.75rem;
    margin-bottom: 1.15rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-hairline);
  }

  :global(.article-prose .article-h3) {
    font-size: 1.25rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.015em;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  :global(.article-prose .article-p) {
    margin-bottom: 1.4rem;
  }

  :global(.article-prose .article-quote) {
    background: #fff8f9;
    border: 1px solid rgba(233, 36, 81, 0.16);
    border-left: 4px solid var(--primary);
    padding: 1.25rem 1.5rem;
    border-radius: 8px;
    margin: 2rem 0;
    font-style: normal;
    color: #1e293b;
    font-size: 0.95rem;
    line-height: 1.65;
    box-shadow: 0 1px 3px rgba(233, 36, 81, 0.03);
  }

  :global(.article-prose .article-quote strong) {
    color: var(--primary);
    font-weight: 700;
  }

  :global(.article-prose .article-quote p) {
    margin-bottom: 0;
  }

  :global(.article-prose .article-hr) {
    border: none;
    height: 1px;
    background: var(--border-hairline);
    margin: 2.5rem 0;
  }

  :global(.article-prose .article-ul) {
    list-style: disc;
    padding-left: 1.75rem;
    margin-bottom: 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  :global(.article-prose .article-ol) {
    list-style: decimal;
    padding-left: 1.75rem;
    margin-bottom: 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  :global(.article-prose .article-ul li),
  :global(.article-prose .article-ol li) {
    line-height: 1.6;
  }

  :global(.article-prose .article-link) {
    color: var(--primary);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 500;
    transition: color 0.15s ease;
  }

  :global(.article-prose .article-link:hover) {
    color: var(--primary-dark);
  }

  :global(.article-prose .inline-code) {
    background: #f1f5f9;
    color: #0f172a;
    font-size: 0.88em;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    border: 1px solid var(--border-hairline);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  :global(.article-prose .article-code),
  :global(.article-prose pre) {
    background: #0f172a;
    color: #f1f5f9;
    padding: 1.25rem 1rem;
    border-radius: 12px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    max-width: 100%;
    font-size: 0.82rem;
    line-height: 1.6;
    margin: 1.75rem 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    border: 1px solid #1e293b;
  }

  :global(.article-prose .article-code code),
  :global(.article-prose pre code) {
    display: block;
    min-width: fit-content;
  }

  :global(.article-prose .table-container) {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    max-width: 100%;
    margin: 2rem 0;
    border: 1px solid var(--border-hairline);
    border-radius: 12px;
    background: #ffffff;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.02);
  }

  :global(.article-prose .article-table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
    text-align: left;
  }

  :global(.article-prose .article-table th) {
    background: #f8fafc;
    padding: 0.85rem 1.25rem;
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #475569;
    border-bottom: 1px solid var(--border-hairline);
  }

  :global(.article-prose .article-table td) {
    padding: 0.85rem 1.25rem;
    border-bottom: 1px solid var(--border-hairline);
    color: #334155;
  }

  :global(.article-prose .article-table tr:last-child td) {
    border-bottom: none;
  }

  /* Feedback Section */
  .feedback-section {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-hairline);
  }

  .feedback-card {
    background: #f8fafc;
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-card);
    padding: 1.5rem 2rem;
  }

  .feedback-prompt {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .feedback-question {
    font-size: 0.94rem;
    font-weight: 700;
    color: #0f172a;
  }

  .feedback-buttons {
    display: flex;
    gap: 0.75rem;
  }

  .feedback-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: #ffffff;
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-btn);
    padding: 0.5rem 1.1rem;
    min-height: 44px;
    font-size: 0.86rem;
    font-weight: 600;
    color: #0f172a;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.15s ease;
  }

  .feedback-btn svg {
    width: 15px;
    height: 15px;
  }

  .feedback-btn:hover {
    border-color: #cbd5e1;
    background: #f1f5f9;
  }

  .yes-btn:hover {
    color: #059669;
    border-color: #a7f3d0;
    background: #ecfdf5;
  }

  .no-btn:hover {
    color: #dc2626;
    border-color: #fecaca;
    background: #fef2f2;
  }

  .feedback-ack {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: #0f172a;
    font-size: 0.92rem;
    font-weight: 600;
  }

  .feedback-ack svg {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .ack-contact-link {
    color: var(--primary);
    font-weight: 600;
    text-decoration: underline;
    margin-left: 0.35rem;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    transition: color 0.15s ease;
  }

  .ack-contact-link:hover {
    color: var(--primary-dark);
  }

  /* Pagination Navigation */
  .doc-pagination {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  .page-nav-link {
    background: #ffffff;
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-card);
    padding: 1.25rem 1.5rem;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    min-height: 44px;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .page-nav-link:hover {
    border-color: #cbd5e1;
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05);
  }

  .page-nav-link.next {
    text-align: right;
  }

  .nav-direction {
    font-size: 0.74rem;
    font-weight: 700;
    color: var(--primary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.35rem;
  }

  .nav-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.35;
  }

  .page-nav-placeholder {
    visibility: hidden;
  }

