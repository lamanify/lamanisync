---
import Layout from '../../layouts/Layout.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { docCategories, docArticles } from '../../data/docs';

const popularArticles = docArticles.filter((art) => art.popular);
---

<Layout
  title="Documentation Hub | Clinic Management System Integration Specs"
  description="Technical guides and setup specifications for clinic management system integration, workstation pairing, and healthcare data synchronization."
>
  <div class="attio-outer-gutter">
    <div class="attio-container border-x border-subtle">

      <!-- Attio Hero Section -->
      <header class="attio-hero-section">
        <div class="hero-top-strip">
          <div class="strip-tick left"></div>
          <div class="strip-tick right"></div>
        </div>

        <div class="hero-inner">
          <div class="attio-eyebrow-pill">
            <span class="status-indicator-dot"></span>
            <h1>Technical Documentation & Architecture Hub</h1>
          </div>

          <h2 class="attio-display-headline">
            Documentation. Schemas. Reference guides.
          </h2>

          <p class="attio-subtext">
            Everything clinic administrators and software engineers need to pair front-desk workstations with Dentrix, Kreloses, and LamaniHub.<br class="hidden sm:inline" />
            Zero-port outbound sync, local MV3 bridging, and cryptographic session leasing.
          </p>

          <!-- Interactive Search Input inside Hero -->
          <div class="docs-search-bar-wrap">
            <div class="search-input-box">
              <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <input
                type="search"
                id="docs-search"
                placeholder="Search technical guides (e.g. Kreloses, Dentrix, WebCrypto, Leases, Error codes)..."
                aria-label="Search documentation"
                class="search-field"
                autocomplete="off"
              />
              <span class="search-shortcut">⌘K</span>
            </div>
          </div>
        </div>

        <!-- Contextual Technical Topology Diagram: Documentation Knowledge Mesh -->
        <div class="hero-diagram-frame">
          <div class="diagram-canvas">
            <svg class="diagram-svg-layer" viewBox="0 0 960 480" fill="none" preserveAspectRatio="xMidYMid meet">
              <path d="M 220 130 L 480 240" stroke="#cbd5e1" stroke-width="1.5" stroke-dasharray="4 4" />
              <path d="M 220 350 L 480 240" stroke="#cbd5e1" stroke-width="1.5" stroke-dasharray="4 4" />
              <path d="M 480 240 L 740 130" stroke="#10b981" stroke-width="2" />
              <path d="M 480 240 L 740 350" stroke="#3b82f6" stroke-width="2" />

              <circle class="pulse-particle" r="4" fill="#10b981">
                <animateMotion dur="2.4s" repeatCount="indefinite" path="M 220 130 L 480 240 L 740 130" />
              </circle>
              <circle class="pulse-particle" r="3.5" fill="#3b82f6">
                <animateMotion dur="2.8s" repeatCount="indefinite" path="M 220 350 L 480 240 L 740 350" />
              </circle>
            </svg>

            <!-- Node 1: Top-Left - CMS Connectors Spec -->
            <div class="schema-card node-docs-nw">
              <div class="card-head">
                <div class="entity-icon bg-purple">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
                </div>
                <span class="entity-name">CMS Adapters</span>
                <span class="entity-badge badge-blue">DOCS/01</span>
              </div>
              <div class="card-attrs">
                <div class="attr-row"><span class="attr-bullet active"></span><span class="attr-label">Kreloses / Dentrix / eCW</span></div>
                <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">DOM selector contracts</span></div>
                <div class="attr-more">6 Spec Guides</div>
              </div>
            </div>

            <!-- Node 2: Bottom-Left - Workstation Security -->
            <div class="schema-card node-docs-sw">
              <div class="card-head">
                <div class="entity-icon bg-emerald">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                </div>
                <span class="entity-name">Security & Keys</span>
                <span class="entity-badge badge-green">DOCS/02</span>
              </div>
              <div class="card-attrs">
                <div class="attr-row"><span class="attr-bullet active"></span><span class="attr-label">WebCrypto AES-GCM 256</span></div>
                <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Zero-Trust WSS lease</span></div>
                <div class="attr-more">4 Technical Specs</div>
              </div>
            </div>

            <!-- Node 3: Center - Unified Reference Core -->
            <div class="schema-card node-docs-center">
              <div class="card-head">
                <div class="entity-icon bg-blue">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
                </div>
                <span class="entity-name">LamaniSync Core API</span>
                <span class="entity-badge badge-green">v2.4.0 SPEC</span>
              </div>
              <div class="card-attrs">
                <div class="attr-row highlight-row"><span class="attr-bullet active"></span><span class="attr-label">Protocol: WebSocket JSON-RPC</span></div>
                <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Failover: Raft-inspired Heartbeat</span></div>
                <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Slot Mutex: Sub-second Atomic</span></div>
                <div class="attr-more">Standardized Clinic API Schema</div>
              </div>
            </div>

            <!-- Node 4: Top-Right - Deployment SOPs -->
            <div class="schema-card node-docs-ne">
              <div class="card-head">
                <div class="entity-icon bg-amber">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
                </div>
                <span class="entity-name">Deployment SOP</span>
                <span class="entity-badge badge-blue">DOCS/03</span>
              </div>
              <div class="card-attrs">
                <div class="attr-row"><span class="attr-bullet active"></span><span class="attr-label">Windows / macOS / Linux</span></div>
                <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Group Policy & Enterprise</span></div>
                <div class="attr-more">60-Second Setup</div>
              </div>
            </div>

            <!-- Node 5: Bottom-Right - Webhook & Events -->
            <div class="schema-card node-docs-se">
              <div class="card-head">
                <div class="entity-icon bg-purple">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
                </div>
                <span class="entity-name">WhatsApp Events</span>
                <span class="entity-badge badge-green">n8n / API</span>
              </div>
              <div class="card-attrs">
                <div class="attr-row"><span class="attr-bullet active"></span><span class="attr-label">Event: appointment.created</span></div>
                <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Payload: Patient, Slot, IC</span></div>
                <div class="attr-more">Bi-directional Webhooks</div>
              </div>
            </div>

            <!-- Contextual Floating Pill -->
            <div class="floating-query-pill">
              <div class="pill-sparkle">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
              </div>
              <span class="pill-text">Indexed 11 architectural guides, 34 schema definitions, and 6 CMS adapters</span>
              <div class="pill-status-dot"></div>
            </div>
          </div>
        </div>
      </header>

      <!-- Live Search Results Container (Hidden by default) -->
      <section id="search-results-section" class="search-results-section" style="display: none;">
        <div class="content-container">
          <div class="results-header">
            <h2 class="attio-section-h2">
              <span class="h2-lead">Search Results</span>
              <span class="h2-muted" id="results-count">Matches</span>
            </h2>
            <button id="clear-search-btn" class="clear-btn">Clear search</button>
          </div>
          <div id="search-results-grid" class="search-results-grid"></div>
        </div>
      </section>

      <!-- Popular Guides Section (Hairline Grid) -->
      <section class="attio-section-standard border-t border-subtle" id="popular-guides">
        <div class="section-label-header">
          <span class="attio-subtext" style="font-family: ui-monospace, monospace; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em;">[01] Essential Architectural Guides</span>
          <h2 class="attio-section-h2">
            <span class="h2-lead">Popular Documentation</span>
            <span class="h2-muted">The core implementation guides most clinics deploy first.</span>
          </h2>
        </div>

        <div class="attio-hairline-grid grid-3">
          {popularArticles.map((art, index) => {
            const cat = docCategories.find((c) => c.slug === art.categorySlug);
            return (
              <a href={`/docs/${art.slug}`} class="attio-grid-card">
                <div class="card-inner">
                  <div class="card-top">
                    <span class="category-chip">{cat?.title || art.categorySlug}</span>
                    <span class="meta-tag">[{String(index + 1).padStart(2, '0')}]</span>
                  </div>
                  <h3 class="card-title">{art.title}</h3>
                  <p class="card-desc">{art.description}</p>
                  <div class="card-footer">
                    <span class="read-link">Read Guide &rarr;</span>
                    <span class="meta-time">{art.readTime} read</span>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </section>

      <!-- All Categories Section (Hairline 2-Col Grid) -->
      <section class="attio-section-shaded border-t border-subtle" id="all-categories">
        <div class="section-label-header">
          <span class="attio-subtext" style="font-family: ui-monospace, monospace; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em;">[02] Full Documentation Index</span>
          <h2 class="attio-section-h2">
            <span class="h2-lead">Categories & Modules</span>
            <span class="h2-muted">Explore comprehensive specs organized by technical discipline.</span>
          </h2>
        </div>

        <div class="attio-hairline-grid grid-2">
          {docCategories.map((cat) => {
            const articlesInCat = docArticles.filter((a) => a.categorySlug === cat.slug);
            return (
              <div class="attio-grid-card category-module-card">
                <div class="card-inner">
                  <div class="cat-header">
                    <div class="cat-badge-wrap">
                      <span class="mono-badge">[{cat.slug.toUpperCase()}]</span>
                      <h3 class="cat-title">{cat.title}</h3>
                    </div>
                    <span class="article-count-tag">{articlesInCat.length} guides</span>
                  </div>
                  <p class="cat-desc">{cat.description}</p>

                  <ul class="guide-item-list">
                    {articlesInCat.map((art) => (
                      <li>
                        <a href={`/docs/${art.slug}`} class="guide-item-link">
                          <span class="link-label">{art.title}</span>
                          <span class="link-meta">{art.readTime}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            );
          })}
        </div>
      </section>

      <!-- Contact Support Banner (Attio Style) -->
      <section class="attio-support-banner border-t border-subtle">
        <div class="banner-inner">
          <div class="banner-text">
            <h3 class="banner-title">Need specialized integration assistance?</h3>
            <p class="banner-desc">Our healthcare systems engineers help enterprise dental and aesthetic clinic groups configure dedicated multi-workstation clusters.</p>
          </div>
          <div class="banner-cta">
            <a href="/contact" class="attio-primary-btn">Talk to an Engineer</a>
          </div>
        </div>
      </section>

    </div>
  </div>

  <CtaBanner />
</Layout>

<style>
  /* Attio Outer Gutters & Frame */
  .attio-outer-gutter {
    background-color: #fafafa;
    background-image: repeating-linear-gradient(
      125deg,
      #e2e8f0 0,
      #e2e8f0 1px,
      transparent 1px,
      transparent 8px
    );
    min-height: 100vh;
  }
  .attio-container {
    max-width: 1200px;
    margin: 0 auto;
    background-color: #ffffff;
  }
  .border-subtle { border-color: #e2e8f0; }

  /* Hero Section */
  .attio-hero-section {
    position: relative;
    padding: 3.5rem 1.5rem 3rem;
    background-color: #ffffff;
    text-align: center;
    border-bottom: 1px solid #e2e8f0;
  }
  .hero-top-strip {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 44px;
    border-bottom: 1px solid #f1f5f9;
    pointer-events: none;
  }
  .strip-tick {
    position: absolute;
    width: 1px;
    height: 100%;
    background-color: #f1f5f9;
  }
  .strip-tick.left { left: 44px; }
  .strip-tick.right { right: 44px; }

  .hero-inner {
    max-width: 820px;
    margin: 0 auto 2.5rem;
    position: relative;
    z-index: 2;
  }
  .attio-eyebrow-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    border: 1px solid #e2e8f0;
    background: #ffffff;
    margin-bottom: 1.5rem;
  }
  .attio-eyebrow-pill h1 {
    font-size: 0.75rem;
    font-weight: 500;
    color: #1c1d1f;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .status-indicator-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #10b981;
    display: inline-block;
  }
  .attio-display-headline {
    font-size: clamp(2.5rem, 5vw, 4.25rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    color: #1c1d1f;
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }
  .attio-subtext {
    font-size: 1.125rem;
    line-height: 1.5;
    color: #6f7988;
    font-weight: 400;
    max-width: 680px;
    margin: 0 auto 1.75rem;
  }

  /* Search Wrap */
  .docs-search-bar-wrap {
    max-width: 580px;
    margin: 0 auto;
  }
  .search-input-box {
    position: relative;
    display: flex;
    align-items: center;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
    padding: 0.25rem 0.75rem;
    transition: all 0.15s ease;
  }
  .search-input-box:focus-within {
    border-color: #1c1d1f;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.08);
  }
  .search-icon {
    width: 18px;
    height: 18px;
    color: #94a3b8;
    margin-right: 0.65rem;
    flex-shrink: 0;
  }
  .search-field {
    width: 100%;
    border: none;
    outline: none;
    font-size: 0.95rem;
    color: #1c1d1f;
    background: transparent;
    padding: 0.5rem 0;
  }
  .search-shortcut {
    font-family: ui-monospace, monospace;
    font-size: 0.75rem;
    color: #94a3b8;
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
  }

  /* Hero Diagram Frame & Dot Matrix Canvas */
  .hero-diagram-frame {
    margin: 0 auto;
    max-width: 1000px;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    background: #ffffff;
    box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.04);
    overflow: hidden;
  }
  .diagram-canvas {
    position: relative;
    width: 100%;
    height: 480px;
    background-color: #ffffff;
    background-image: radial-gradient(#cbd5e1 1.2px, transparent 1.2px);
    background-size: 24px 24px;
    overflow: hidden;
  }
  .diagram-svg-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  /* Node Card Positioning */
  .schema-card {
    position: absolute;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.06);
    padding: 0.75rem 0.85rem;
    text-align: left;
    z-index: 2;
  }
  .node-docs-nw { top: 40px; left: 35px; width: 220px; }
  .node-docs-sw { bottom: 65px; left: 35px; width: 220px; }
  .node-docs-center { top: 50%; left: 50%; transform: translate(-50%, -50%); width: 260px; border-color: #cbd5e1; }
  .node-docs-ne { top: 40px; right: 35px; width: 220px; }
  .node-docs-se { bottom: 65px; right: 35px; width: 220px; }

  .card-head {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.5rem;
    padding-bottom: 0.45rem;
    border-bottom: 1px solid #f1f5f9;
  }
  .entity-icon {
    width: 22px;
    height: 22px;
    border-radius: 5px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .bg-purple { background: #f3e8ff; color: #7e22ce; }
  .bg-emerald { background: #d1fae5; color: #047857; }
  .bg-blue { background: #dbeafe; color: #1d4ed8; }
  .bg-amber { background: #fef3c7; color: #b45309; }

  .entity-name { font-size: 0.75rem; font-weight: 600; color: #1c1d1f; flex: 1; }
  .entity-badge { font-size: 0.6rem; font-weight: 600; font-family: ui-monospace, monospace; padding: 0.1rem 0.35rem; border-radius: 4px; }
  .badge-blue { background: #eff6ff; color: #2563eb; }
  .badge-green { background: #ecfdf5; color: #059669; }

  .card-attrs { display: flex; flex-direction: column; gap: 0.3rem; }
  .attr-row { display: flex; align-items: center; gap: 0.4rem; font-size: 0.7rem; color: #334155; }
  .attr-bullet { width: 4px; height: 4px; border-radius: 50%; background: #94a3b8; }
  .attr-bullet.active { background: #10b981; }
  .attr-more { font-size: 0.65rem; color: #94a3b8; font-family: ui-monospace, monospace; margin-top: 0.2rem; }

  /* Floating Query Pill */
  .floating-query-pill {
    position: absolute;
    bottom: 16px;
    left: 50%;
    transform: translateX(-50%);
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 9999px;
    padding: 0.4rem 1rem;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.08);
    display: flex;
    align-items: center;
    gap: 0.6rem;
    z-index: 3;
    white-space: nowrap;
  }
  .pill-sparkle { color: #6366f1; display: flex; }
  .pill-text { font-size: 0.75rem; color: #475569; font-weight: 500; font-family: ui-monospace, monospace; }
  .pill-status-dot { width: 6px; height: 6px; border-radius: 50%; background: #10b981; }

  /* Sections */
  .attio-section-standard {
    padding: 3.5rem 2rem;
    background: #ffffff;
  }
  .attio-section-shaded {
    padding: 3.5rem 2rem;
    background: #fafafa;
  }
  .section-label-header {
    margin-bottom: 2rem;
  }
  .attio-section-h2 {
    font-size: 1.75rem;
    line-height: 1.25;
    margin-top: 0.35rem;
  }
  .h2-lead { color: #1c1d1f; font-weight: 600; margin-right: 0.5rem; }
  .h2-muted { color: #6f7988; font-weight: 400; }

  /* Hairline Grid Architecture */
  .attio-hairline-grid {
    display: grid;
    gap: 1px;
    background-color: #e2e8f0;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    overflow: hidden;
  }
  .grid-3 { grid-template-columns: repeat(3, 1fr); }
  .grid-2 { grid-template-columns: repeat(2, 1fr); }

  .attio-grid-card {
    background-color: #ffffff;
    text-decoration: none;
    color: inherit;
    transition: background 0.15s ease;
  }
  .attio-grid-card:hover { background-color: #fcfcfd; }
  .card-inner { padding: 1.5rem; height: 100%; display: flex; flex-direction: column; }
  .card-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; }
  .category-chip { font-size: 0.7rem; font-weight: 600; color: #2563eb; background: #eff6ff; padding: 0.2rem 0.5rem; border-radius: 4px; }
  .meta-tag { font-size: 0.7rem; color: #94a3b8; font-family: ui-monospace, monospace; }
  .card-title { font-size: 1.1rem; font-weight: 600; color: #1c1d1f; line-height: 1.35; margin-bottom: 0.5rem; }
  .card-desc { font-size: 0.85rem; color: #6f7988; line-height: 1.5; flex: 1; margin-bottom: 1rem; }
  .card-footer { display: flex; justify-content: space-between; align-items: center; padding-top: 0.75rem; border-top: 1px solid #f1f5f9; font-size: 0.75rem; }
  .read-link { font-weight: 600; color: #1c1d1f; }
  .meta-time { color: #94a3b8; }

  /* Category Module Cards */
  .cat-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; }
  .cat-badge-wrap { display: flex; align-items: center; gap: 0.5rem; }
  .mono-badge { font-size: 0.7rem; color: #64748b; font-family: ui-monospace, monospace; }
  .cat-title { font-size: 1.15rem; font-weight: 600; color: #1c1d1f; margin: 0; }
  .article-count-tag { font-size: 0.7rem; color: #64748b; background: #f1f5f9; padding: 0.15rem 0.45rem; border-radius: 4px; }
  .cat-desc { font-size: 0.85rem; color: #6f7988; margin-bottom: 1.25rem; }

  .guide-item-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .guide-item-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.55rem 0.75rem;
    border-radius: 6px;
    background: #f8fafc;
    border: 1px solid #f1f5f9;
    text-decoration: none;
    font-size: 0.8rem;
    color: #1c1d1f;
    transition: all 0.15s ease;
  }
  .guide-item-link:hover {
    background: #ffffff;
    border-color: #cbd5e1;
    transform: translateX(2px);
  }
  .link-meta { color: #94a3b8; font-size: 0.75rem; }

  /* Support Banner */
  .attio-support-banner {
    padding: 2.5rem 2rem;
    background: #ffffff;
  }
  .banner-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    background: #fafafa;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 1.75rem 2rem;
  }
  .banner-title { font-size: 1.15rem; font-weight: 600; color: #1c1d1f; margin-bottom: 0.35rem; }
