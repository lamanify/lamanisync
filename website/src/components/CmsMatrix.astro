---
const systems = [
  {
    name: "Dentrix Ascend",
    category: "Dental Cloud Software",
    status: "Certified Adapter",
    features: [
      "Operatory & Chair slot reading",
      "Direct appointment card booking",
      "Patient chart & phone lookup",
      "Immediate readback confirmation"
    ]
  },
  {
    name: "eClinicalWorks",
    category: "Medical & Specialist EHR",
    status: "Certified Adapter",
    features: [
      "Doctor roster & block time sync",
      "Outpatient visit scheduling",
      "Automated insurance/ID match",
      "Two-way cancellation updates"
    ]
  },
  {
    name: "LamaniPulse EHR",
    category: "Modern Cloud Clinic ERP",
    status: "Native Adapter",
    features: [
      "Sub-second sync latency",
      "Multi-branch clinic routing",
      "Doctor queue & WhatsApp triage",
      "Full deposit & invoice linking"
    ]
  },
  {
    name: "Custom Clinic EHR / Portal",
    category: "Proprietary & Web Portals",
    status: "Adapter on Request",
    features: [
      "Compatible with any web-based CMS",
      "Zero modifications to clinic software",
      "Custom adapter built in 48 hours",
      "Strict audited action isolation"
    ]
  }
];
---

<section id="supported-cms" class="section cms-section">
  <div class="container">
    <div class="section-head">
      <div class="attio-badge blue">
        <svg style="width:12px; height:12px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 7h10M7 12h10M7 17h10"/></svg>
        <span>CMS Ecosystem</span>
      </div>
      <h2 class="section-title">
        <span class="heading-dark">Compatible with</span>
        <span class="heading-muted">your clinic's software.</span>
      </h2>
      <p class="section-desc">
        Whether your practice uses leading dental software, specialist EHRs, or proprietary hospital portals, LamaniSync provides secure, certified adapters built to run seamlessly on your workstation.
      </p>
    </div>

    <div class="cms-grid">
      {systems.map((sys) => (
        <div class="cms-card">
          <div class="cms-header">
            <div>
              <h3 class="cms-name">{sys.name}</h3>
              <div class="cms-cat">{sys.category}</div>
            </div>
            <span class={`status-tag ${sys.status === 'Native Adapter' ? 'native' : sys.status === 'Certified Adapter' ? 'certified' : 'custom'}`}>
              {sys.status}
            </span>
          </div>

          <div class="cms-divider"></div>

          <ul class="cms-features">
            {sys.features.map((feat) => (
              <li>
                <svg style="width:14px; height:14px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                <span>{feat}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Need another CMS banner -->
    <div class="custom-cms-banner">
      <div class="custom-cms-content">
        <h4>Using a different Clinic Management System?</h4>
        <p>
          We add certified adapter support for new clinic portals within 48 hours. Connect with our team through LamaniHub to verify your clinic's setup.
        </p>
      </div>
      <a href="https://lamanihub.com" target="_blank" rel="noopener noreferrer" class="btn-secondary">
        <span>Request CMS Compatibility</span>
        <svg style="width:14px; height:14px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .cms-section {
    padding: 6rem 0;
    background: #ffffff;
    border-top: 1px solid var(--border-hairline);
  }

  .section-head {
    text-align: center;
    max-width: 840px;
    margin: 0 auto 3.5rem auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .section-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 800;
    line-height: 1.22;
    letter-spacing: -0.025em;
    margin-top: 1.25rem;
    margin-bottom: 1.2rem;
  }

  .section-desc {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .cms-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem;
    margin-bottom: 2.75rem;
  }

  .cms-card {
    background: #ffffff;
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-card);
    padding: 2rem;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.02);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s, box-shadow 0.2s;
    min-width: 0;
  }

  .cms-card:hover {
    transform: translateY(-2px);
    border-color: #cbd5e1;
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.05);
  }

  .cms-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .cms-name {
    font-size: 1.25rem;
    font-weight: 700;
    color: #0f172a;
    letter-spacing: -0.01em;
  }

  .cms-cat {
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-top: 0.2rem;
  }

  .status-tag {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.22rem 0.6rem;
    border-radius: 6px;
    white-space: nowrap;
    border: 1px solid transparent;
  }

  .status-tag.certified {
    background: #f8fafc;
    color: #0f172a;
    border-color: var(--border-hairline);
  }

  .status-tag.native {
    background: #fff1f3;
    color: var(--primary);
    border-color: #fecdd6;
  }

  .status-tag.custom {
    background: #f8fafc;
    color: #64748b;
    border-color: var(--border-hairline);
  }

  .cms-divider {
    height: 1px;
    background: var(--border-hairline);
    margin: 1.3rem 0;
  }

  .cms-features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .cms-features li {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.88rem;
    color: #334155;
  }

  .cms-features li svg {
    color: var(--primary);
    flex-shrink: 0;
  }

  .custom-cms-banner {
    background: #fafafa;
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-card);
    padding: 2rem 2.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .custom-cms-content h4 {
    font-size: 1.15rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 0.35rem;
  }

  .custom-cms-content p {
    font-size: 0.88rem;
    color: var(--text-muted);
    max-width: 620px;
    line-height: 1.5;
  }

  @media (max-width: 820px) {
    .cms-grid {
      grid-template-columns: 1fr;
    }
    .custom-cms-banner {
      flex-direction: column;
      align-items: flex-start;
      padding: 1.75rem;
    }
  }

  @media (max-width: 600px) {
    .cms-section {
      padding: 4rem 0;
    }
    .cms-card {
      padding: 1.5rem 1rem;
    }
    .custom-cms-banner {
      padding: 1.5rem 1rem;
    }
    .custom-cms-banner .btn-secondary {
      width: 100%;
      min-height: 44px;
      justify-content: center;
    }
  }
</style>
