---
const systems = [
  {
    name: "Dentrix Ascend",
    category: "Dental Cloud Software",
    status: "Certified Adapter",
    features: [
      "Operatory & Chair slot reading",
      "Direct appointment card booking",
      "Patient chart & phone lookup",
      "Immediate readback confirmation"
    ]
  },
  {
    name: "eClinicalWorks",
    category: "Medical & Specialist EHR",
    status: "Certified Adapter",
    features: [
      "Doctor roster & block time sync",
      "Outpatient visit scheduling",
      "Automated insurance/ID match",
      "Two-way cancellation updates"
    ]
  },
  {
    name: "LamaniPulse EHR",
    category: "Modern Cloud Clinic ERP",
    status: "Native Adapter",
    features: [
      "Sub-second sync latency",
      "Multi-branch clinic routing",
      "Doctor queue & WhatsApp triage",
      "Full deposit & invoice linking"
    ]
  },
  {
    name: "Custom Clinic EHR / Portal",
    category: "Proprietary & Web Portals",
    status: "Adapter on Request",
    features: [
      "Compatible with any web-based CMS",
      "Zero modifications to clinic software",
      "Custom adapter built in 48 hours",
      "Strict audited action isolation"
    ]
  }
];
---

<section id="supported-cms" class="section cms-section">
  <div class="container">
    <div class="section-head">
      <div class="badge-pill">
        <svg style="width:12px; height:12px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 7h10"/><path d="M7 12h10"/><path d="M7 17h10"/></svg>
        <span>CMS Ecosystem</span>
      </div>
      <h2 class="section-title">
        Compatible with <span class="gradient-text">your clinic's software</span>.
      </h2>
      <p class="section-desc">
        Whether your practice uses leading dental software, specialist EHRs, or proprietary hospital portals, LamaniSync provides secure, certified adapters built to run seamlessly on your workstation.
      </p>
    </div>

    <div class="cms-grid">
      {systems.map((sys) => (
        <div class="cms-card">
          <div class="cms-header">
            <div>
              <h3 class="cms-name">{sys.name}</h3>
              <div class="cms-cat">{sys.category}</div>
            </div>
            <span class={`status-tag ${sys.status === 'Native Adapter' ? 'native' : sys.status === 'Certified Adapter' ? 'certified' : 'custom'}`}>
              {sys.status}
            </span>
          </div>

          <div class="cms-divider"></div>

          <ul class="cms-features">
            {sys.features.map((feat) => (
              <li>
                <svg style="width:15px; height:15px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                <span>{feat}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Need another CMS banner -->
    <div class="custom-cms-banner">
      <div class="custom-cms-content">
        <h4>Using a different Clinic Management System?</h4>
        <p>
          We add certified adapter support for new clinic portals within 48 hours. Connect with our team through LamaniHub to verify your clinic's setup.
        </p>
      </div>
      <a href="https://lamanihub.com" target="_blank" rel="noopener noreferrer" class="btn-secondary">
        <span>Request CMS Compatibility</span>
        <svg style="width:14px; height:14px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .cms-section {
    padding: 6rem 0;
    background: #ffffff;
    border-top: 1px solid #f1f5f9;
  }

  .section-head {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 3.5rem auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .section-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.025em;
    color: var(--text-main);
    margin-top: 1rem;
    margin-bottom: 1.2rem;
  }

  .section-desc {
    font-size: 1.1rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .cms-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.8rem;
    margin-bottom: 3rem;
  }

  .cms-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    padding: 2rem;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.03);
    transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
  }

  .cms-card:hover {
    transform: translateY(-3px);
    border-color: var(--primary-border);
    box-shadow: 0 12px 28px rgba(15, 23, 42, 0.06);
  }

  .cms-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .cms-name {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--text-main);
    letter-spacing: -0.01em;
  }

  .cms-cat {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-top: 0.2rem;
  }

  .status-tag {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    white-space: nowrap;
  }

  .status-tag.certified {
    background: #eff6ff;
    color: #1d4ed8;
  }

  .status-tag.native {
    background: var(--primary-subtle);
    color: var(--primary);
  }

  .status-tag.custom {
    background: #f1f5f9;
    color: #475569;
  }

  .cms-divider {
    height: 1px;
    background: #f1f5f9;
    margin: 1.4rem 0;
  }

  .cms-features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .cms-features li {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.92rem;
    color: #334155;
  }

  .cms-features li svg {
    color: var(--primary);
    flex-shrink: 0;
  }

  .custom-cms-banner {
    background: linear-gradient(135deg, #f8fafc 0%, var(--primary-subtle) 100%);
    border: 1px solid var(--primary-border);
    border-radius: 16px;
    padding: 2rem 2.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .custom-cms-content h4 {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 0.4rem;
  }

  .custom-cms-content p {
    font-size: 0.92rem;
    color: var(--text-muted);
    max-width: 620px;
    line-height: 1.5;
  }

  @media (max-width: 820px) {
    .cms-grid {
      grid-template-columns: 1fr;
    }
    .custom-cms-banner {
      flex-direction: column;
      align-items: flex-start;
      padding: 1.8rem;
    }
  }
</style>
