---
const systems = [
  {
    num: "01",
    name: "Dentrix Ascend",
    category: "Dental Cloud EHR",
    status: "Certified",
    features: [
      "Operatory & Chair slot reading",
      "Direct appointment card booking",
      "Patient chart & phone lookup",
      "Immediate readback confirmation"
    ]
  },
  {
    num: "02",
    name: "eClinicalWorks",
    category: "Medical & Specialist Portal",
    status: "Certified",
    features: [
      "Doctor roster & block time sync",
      "Outpatient visit scheduling",
      "Automated insurance/ID match",
      "Two-way cancellation updates"
    ]
  },
  {
    num: "03",
    name: "LamaniPulse EHR",
    category: "Modern Cloud Clinic ERP",
    status: "Native",
    features: [
      "Sub-second sync latency",
      "Multi-branch clinic routing",
      "Doctor queue & WhatsApp triage",
      "Full deposit & invoice linking"
    ]
  },
  {
    num: "04",
    name: "Custom Clinic EHR / Portal",
    category: "Proprietary & Web Portals",
    status: "Adapter on Request",
    features: [
      "Compatible with any web-based CMS",
      "Zero modifications to clinic software",
      "Custom adapter built in 48 hours",
      "Strict audited action isolation"
    ]
  }
];
---

<section id="supported-cms" class="attio-section border-t border-subtle">
  <div class="attio-container border-x border-subtle">

    <header class="attio-section-head">
      <div class="attio-head-inner">
        <h2 class="attio-h2-inline">
          <span class="text-primary">Compatible with your clinic's software.</span>
          <span class="text-muted font-normal"> Certified adapters for leading dental, medical, and proprietary EHRs.</span>
        </h2>
        <p class="attio-lead-desc">
          Whether your practice operates dental chairs, outpatient specialist EHRs, or proprietary portals, LamaniSync provides certified adapters built to run seamlessly on your workstation.
        </p>
      </div>
    </header>

    <div class="attio-separator-wrap">
      <div class="attio-dashed-line"></div>
    </div>

    <!-- 2x2 Clean 1px Gap Architectural Matrix -->
    <div class="attio-matrix-canvas">
      <div class="attio-dot-bg"></div>

      <div class="attio-matrix-grid">
        {systems.map((sys) => (
          <div class="attio-matrix-cell">
            <div class="matrix-cell-head">
              <div class="cell-overline">[{sys.num}] {sys.category}</div>
              <span class={`status-pill ${sys.status === 'Native' ? 'native' : sys.status === 'Certified' ? 'certified' : 'custom'}`}>
                {sys.status}
              </span>
            </div>

            <h3 class="sys-name">{sys.name}</h3>

            <div class="sys-divider"></div>

            <ul class="sys-feature-list">
              {sys.features.map((feat) => (
                <li>
                  <span class="feat-check">&#x2713;</span>
                  <span>{feat}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="attio-separator-wrap">
      <div class="attio-dashed-line"></div>
    </div>

    <!-- Bottom Request Bar (Framed Strip) -->
    <div class="attio-request-strip">
      <div class="request-content">
        <span class="request-overline">[COMPATIBILITY GUARANTEE]</span>
        <h4 class="request-title">Using a different Clinic Management System?</h4>
        <p class="request-desc">We add certified adapter support for new web-based clinic portals within 48 hours.</p>
      </div>
      <a href="/contact" class="attio-pill-btn">
        <span>Request CMS compatibility</span>
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2.5 6H9.5M9.5 6L6.5 3M9.5 6L6.5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>

  </div>
</section>

<style>
  .border-t { border-top: 1px solid #e2e8f0; }
  .border-x { border-left: 1px solid #e2e8f0; border-right: 1px solid #e2e8f0; }
  .border-subtle { border-color: #e2e8f0; }
  .attio-section { background: #ffffff; position: relative; }
  .attio-container { max-width: 1200px; margin: 0 auto; position: relative; background: #ffffff; }

  .attio-section-head { padding: 6rem 3.5rem 3rem 3.5rem; background: #ffffff; }
  .attio-head-inner { max-width: 860px; }
  .attio-h2-inline {
    font-size: clamp(2rem, 3.8vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0 0 1.25rem 0;
    text-wrap: balance;
  }
  .text-primary { color: #1c1d1f; }
  .text-muted { color: #6f7988; }
  .attio-lead-desc { font-size: 1.0625rem; color: #6f7988; line-height: 1.6; margin: 0; max-width: 680px; }

  .attio-separator-wrap { position: relative; width: 100%; height: 1px; background: #e2e8f0; }
  .attio-dashed-line {
    width: 100%;
    height: 1px;
    background-image: linear-gradient(to right, #cbd5e1 50%, transparent 50%);
    background-size: 8px 1px;
  }

  .attio-matrix-canvas { position: relative; background: #fafafa; overflow: hidden; }
  .attio-dot-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(#cbd5e1 1px, transparent 1px);
    background-size: 20px 20px;
    opacity: 0.55;
  }

  .attio-matrix-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: #e2e8f0;
  }

  .attio-matrix-cell {
    background: #ffffff;
    padding: 3.5rem 3rem;
    display: flex;
    flex-direction: column;
    transition: background 0.15s ease;
  }
  .attio-matrix-cell:hover { background: #fafafa; }

  .matrix-cell-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.25rem; }
  .cell-overline {
    font-size: 0.75rem;
    font-weight: 600;
    color: #94a3b8;
    letter-spacing: 0.08em;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  .status-pill {
    font-size: 0.6875rem;
    font-weight: 500;
    padding: 0.2rem 0.55rem;
    border-radius: 9999px;
    border: 1px solid #e2e8f0;
    background: #ffffff;
    color: #475569;
  }
  .status-pill.certified { background: #f8fafc; color: #1c1d1f; border-color: #cbd5e1; font-weight: 600; }
  .status-pill.native { background: #fff1f3; color: #e11d48; border-color: #fecdd6; font-weight: 600; }
  .status-pill.custom { background: #f8fafc; color: #64748b; }

  .sys-name { font-size: 1.35rem; font-weight: 500; color: #1c1d1f; letter-spacing: -0.02em; margin: 0 0 1.25rem 0; }
  .sys-divider { width: 100%; height: 1px; background: #f1f5f9; margin-bottom: 1.5rem; }

  .sys-feature-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.85rem; }
  .sys-feature-list li { display: flex; align-items: center; gap: 0.65rem; font-size: 0.88rem; color: #334155; }
  .feat-check { color: #10b981; font-weight: 700; font-size: 0.8rem; }

  /* Request Strip */
  .attio-request-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 3rem 3.5rem;
    background: #ffffff;
    border-bottom: 1px solid #e2e8f0;
    flex-wrap: wrap;
    gap: 2rem;
  }
  .request-overline {
    font-size: 0.72rem;
    font-weight: 600;
    color: #94a3b8;
    letter-spacing: 0.08em;
    font-family: ui-monospace, SFMono-Regular, monospace;
    display: block;
    margin-bottom: 0.35rem;
  }
  .request-title { font-size: 1.15rem; font-weight: 500; color: #1c1d1f; margin: 0 0 0.25rem 0; }
  .request-desc { font-size: 0.88rem; color: #6f7988; margin: 0; }

  .attio-pill-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: #1c1d1f;
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.55rem 1.25rem;
    border-radius: 9999px;
    text-decoration: none;
    transition: background 0.15s ease;
    white-space: nowrap;
  }
  .attio-pill-btn:hover { background: #000000; }

  @media (max-width: 900px) {
    .attio-matrix-grid { grid-template-columns: 1fr; }
    .attio-section-head { padding: 4rem 1.5rem 2.5rem 1.5rem; }
    .attio-matrix-cell { padding: 2.25rem 1.5rem; }
    .attio-request-strip { flex-direction: column; align-items: flex-start; padding: 2rem 1.5rem; }
    .attio-pill-btn { width: 100%; justify-content: center; }
  }
</style>
