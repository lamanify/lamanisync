---
const securityPillars = [
  {
    num: "01",
    title: "Zero Raw PHI Workstation Storage",
    desc: "LamaniSync processes appointments in memory only. Patient data is never stored locally in Chrome storage or unencrypted disk caches, safeguarding against local device extraction."
  },
  {
    num: "02",
    title: "No Password or Cookie Sharing",
    desc: "Your clinic credentials and session tokens stay strictly within your CMS tab. LamaniSync never transmits login passwords, cookies, or CSRF secrets to LamaniHub servers."
  },
  {
    num: "03",
    title: "Hardware WebCrypto Ed25519 Keys",
    desc: "Pairing uses non-exportable asymmetric cryptographic keypairs generated directly on your workstation hardware. Every message is cryptographically signed and authenticated."
  },
  {
    num: "04",
    title: "Strict Action Whitelist Execution",
    desc: "LamaniSync strictly executes pre-compiled, immutable adapter action IDs. Arbitrary remote code or unverified external scripts are strictly blocked by MV3 policy."
  },
  {
    num: "05",
    title: "Two-Step Readback Verification",
    desc: "An appointment is never marked confirmed in LamaniHub until LamaniSync re-queries your clinic database and reads back the newly booked slot, guaranteeing zero phantom records."
  },
  {
    num: "06",
    title: "Exact Origin Scoping",
    desc: "Host permissions are restricted strictly to your paired clinic portal origin and the secure LamaniHub WebSocket endpoint, protecting your other browsing activity entirely."
  }
];
---

<section id="security" class="attio-section border-t border-subtle">
  <div class="attio-container border-x border-subtle">
    
    <!-- Attio Left-Aligned Structural Header (no badges, tight typography) -->
    <header class="attio-section-head">
      <div class="attio-head-inner">
        <h2 class="attio-h2-inline">
          <span class="text-primary">Engineered for healthcare compliance.</span>
          <span class="text-muted font-normal"> Uncompromising data privacy with hardware-isolated WebCrypto keys.</span>
        </h2>
        <p class="attio-lead-desc">
          Designed from the ground up to comply with medical data privacy principles (PDPA & HIPAA-aligned architectures). Your patient records and clinic credentials remain protected at all times.
        </p>
      </div>
    </header>

    <!-- Structural Hairline Separator with Dashed Connector Line -->
    <div class="attio-separator-wrap">
      <div class="attio-dashed-line"></div>
    </div>

    <!-- 1px Gap Grid on Subtle Stroke Canvas (Attio Architectural Layout) -->
    <div class="attio-grid-canvas">
      <div class="attio-dot-bg"></div>
      <div class="attio-pillars-grid">
        {securityPillars.map((item) => (
          <div class="attio-cell">
            <div class="cell-overline">[{item.num}]</div>
            <h3 class="cell-title">{item.title}</h3>
            <p class="cell-desc">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
  .border-t {
    border-top: 1px solid #e2e8f0;
  }
  .border-x {
    border-left: 1px solid #e2e8f0;
    border-right: 1px solid #e2e8f0;
  }
  .border-subtle {
    border-color: #e2e8f0;
  }

  .attio-section {
    background: #ffffff;
    position: relative;
  }

  .attio-container {
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
    background: #ffffff;
  }

  /* Attio Left-Aligned Structural Header (no badges, tight typography) */
  .attio-section-head {
    padding: 6rem 3.5rem 3rem 3.5rem;
    background: #ffffff;
  }

  .attio-head-inner {
    max-width: 860px;
  }

  .attio-h2-inline {
    font-size: clamp(2rem, 3.8vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0 0 1.25rem 0;
    text-wrap: balance;
  }

  .text-primary {
    color: #1c1d1f;
  }

  .text-muted {
    color: #6f7988;
  }

  .attio-lead-desc {
    font-size: 1.0625rem;
    color: #6f7988;
    line-height: 1.6;
    margin: 0;
    max-width: 680px;
  }

  /* Dashed Divider Line */
  .attio-separator-wrap {
    position: relative;
    width: 100%;
    height: 1px;
    background: #e2e8f0;
  }

  .attio-dashed-line {
    width: 100%;
    height: 1px;
    background-image: linear-gradient(to right, #cbd5e1 50%, transparent 50%);
    background-size: 8px 1px;
  }

  /* Canvas with Dotted Pattern & 1px Gap Border Grid */
  .attio-grid-canvas {
    position: relative;
    background: #fafafa;
    overflow: hidden;
  }

  /* Attio Signature Dotted Matrix */
  .attio-dot-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(#cbd5e1 1px, transparent 1px);
    background-size: 20px 20px;
    opacity: 0.55;
  }

  /* Attio Border Gap Grid: 1px gap background creates perfect hairlines */
  .attio-pillars-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: #e2e8f0;
    border-bottom: 1px solid #e2e8f0;
  }

  .attio-cell {
    background: #ffffff;
    padding: 3rem 2.25rem;
    display: flex;
    flex-direction: column;
    transition: background 0.15s ease;
  }

  .attio-cell:hover {
    background: #fafafa;
  }

  .cell-overline {
    font-size: 0.75rem;
    font-weight: 600;
    color: #94a3b8;
    letter-spacing: 0.08em;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    margin-bottom: 1.75rem;
  }

  .cell-title {
    font-size: 1.125rem;
    font-weight: 500;
    color: #1c1d1f;
    letter-spacing: -0.015em;
    line-height: 1.35;
    margin: 0 0 0.85rem 0;
  }

  .cell-desc {
    font-size: 0.875rem;
    color: #6f7988;
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 960px) {
    .attio-section-head {
      padding: 4rem 1.5rem 2.5rem 1.5rem;
    }
    .attio-pillars-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .attio-cell {
      padding: 2.25rem 1.5rem;
    }
  }

  @media (max-width: 640px) {
    .attio-pillars-grid {
      grid-template-columns: 1fr;
    }
    .border-x {
      border-left: none;
      border-right: none;
    }
    .attio-section-head {
      padding: 3.5rem 1.25rem 2rem 1.25rem;
    }
  }
</style>
