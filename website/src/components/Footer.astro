---
<footer class="footer">
  <div class="container footer-container">
    <div class="footer-top">
      <div class="footer-brand">
        <img src="https://res.cloudinary.com/lamanify/image/upload/v1790242929/LamaniSync_Logo.png" alt="LamaniSync Logo" class="footer-logo" />
        <p class="footer-desc">
          The dedicated, zero-knowledge clinic synchronizer engineered exclusively to connect LamaniHub WhatsApp bookings with web-based Clinic Management Systems.
        </p>
      </div>

      <div class="footer-links-group">
        <h5 class="links-title">Product</h5>
        <a href="/what-is-synchronizer" class="footer-link">What is Synchronizer?</a>
        <a href="/features" class="footer-link">Features & Capabilities</a>
        <a href="/docs" class="footer-link">Documentation Hub</a>
        <a href="/#platform" class="footer-link">Platform Overview</a>
        <a href="/#topology" class="footer-link">Workstation Topology</a>
        <a href="/#supported-cms" class="footer-link">Supported CMS Matrix</a>
      </div>

      <div class="footer-links-group">
        <h5 class="links-title">Manifesto & Resources</h5>
        <a href="/why-we-dont-partner" class="footer-link">Why We Don't Partner</a>
        <a href="/docs/installation-guide" class="footer-link">Installation Guide</a>
        <a href="/blog" class="footer-link">Engineering Blog</a>
        <a href="/#security" class="footer-link">Zero-Knowledge Security</a>
        <a href="/privacy" class="footer-link">Privacy Policy</a>
      </div>

      <div class="footer-links-group">
        <h5 class="links-title">Ecosystem & Support</h5>
        <a href="https://lamanihub.com" target="_blank" rel="noopener noreferrer" class="footer-link">LamaniHub Platform</a>
        <a href="/docs/installation-guide" class="footer-link">Workstation Setup</a>
        <a href="/docs/faq" class="footer-link">Knowledge Base & FAQ</a>
        <a href="/contact" class="footer-link">Contact Support</a>
        <a href="https://lamanify.com" target="_blank" rel="noopener noreferrer" class="footer-link">Lamanify</a>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="copyright">
        © {new Date().getFullYear()} LamaniSync. All rights reserved. Built by <a href="https://lamanify.com" target="_blank" rel="noopener noreferrer">Lamanify</a> exclusively for <a href="https://lamanihub.com" target="_blank" rel="noopener noreferrer">LamaniHub</a> clinics.
      </p>
      <div class="compliance-tags">
        <span>Manifest V3</span>
        <span>HIPAA Ready</span>
        <span>Malaysian PDPA</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: #fafafa;
    border-top: 1px solid var(--border-hairline);
    padding: 4.5rem 0 2.5rem 0;
    margin-top: auto;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 2.5rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--border-hairline);
  }

  .footer-logo {
    height: 38px;
    width: auto;
    object-fit: contain;
    margin-bottom: 1.25rem;
  }

  .footer-desc {
    font-size: 0.88rem;
    color: var(--text-muted);
    max-width: 400px;
    line-height: 1.6;
  }

  .links-title {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #0a0a0a;
    margin-bottom: 1.25rem;
  }

  .footer-link {
    display: block;
    font-size: 0.88rem;
    color: var(--text-muted);
    text-decoration: none;
    margin-bottom: 0.65rem;
    transition: color 0.15s ease;
  }

  .footer-link:hover {
    color: var(--primary);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 2rem;
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .copyright a {
    color: #0a0a0a;
    font-weight: 600;
    text-decoration: none;
  }

  .copyright a:hover {
    color: var(--primary);
  }

  .compliance-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .compliance-tags span {
    background: #ffffff;
    border: 1px solid var(--border-hairline);
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--text-muted);
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .footer {
      padding: 3.5rem 0 2rem 0;
    }
    .footer-top {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding-bottom: 2rem;
    }
    .footer-link {
      padding: 0.5rem 0;
      min-height: 44px;
      display: inline-flex;
      align-items: center;
      margin-bottom: 0.25rem;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 1.25rem;
      text-align: center;
    }
    .compliance-tags {
      justify-content: center;
    }
  }
</style>
