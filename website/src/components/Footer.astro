---
---
<footer class="footer">
  <div class="container footer-container">
    <div class="footer-top">
      <div class="footer-brand">
        <img src="https://res.cloudinary.com/lamanify/image/upload/v1790242929/LamaniSync_Logo.png" alt="LamaniSync Logo" class="footer-logo">
        <p class="footer-desc">
          The dedicated, zero-knowledge clinic synchronizer engineered exclusively to connect LamaniHub and Sara AI WhatsApp bookings with various web-based Clinic Management Systems.
        </p>
      </div>

      <div class="footer-links-group">
        <h5 class="links-title">Product</h5>
        <a href="/#what-is-it" class="footer-link">What is it?</a>
        <a href="/#how-it-works" class="footer-link">How it works</a>
        <a href="/#supported-cms" class="footer-link">Supported CMS Matrix</a>
        <a href="/#security" class="footer-link">Zero-Knowledge Security</a>
      </div>

      <div class="footer-links-group">
        <h5 class="links-title">Ecosystem & Support</h5>
        <a href="https://lamanihub.com" target="_blank" rel="noopener noreferrer" class="footer-link">LamaniHub Platform</a>
        <a href="/contact" class="footer-link">Contact Support</a>
        <a href="/privacy" class="footer-link">Privacy Policy</a>
        <a href="https://lamanify.com" target="_blank" rel="noopener noreferrer" class="footer-link">Lamanify</a>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="copyright">
        © {new Date().getFullYear()} LamaniSync. All rights reserved. Built by <a href="https://lamanify.com" target="_blank" rel="noopener noreferrer">Lamanify</a> exclusively for <a href="https://lamanihub.com" target="_blank" rel="noopener noreferrer">LamaniHub</a> clinics.
      </p>
      <div class="compliance-tags">
        <span>Manifest V3</span>
        <span>HIPAA Ready</span>
        <span>Malaysian PDPA</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: #f8fafc;
    border-top: 1px solid var(--primary-border);
    padding: 5rem 0 2.5rem 0;
    margin-top: auto;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 4rem;
    padding-bottom: 3.5rem;
    border-bottom: 1px solid #e2e8f0;
  }

  .footer-logo {
    height: 42px;
    width: auto;
    object-fit: contain;
    margin-bottom: 1.25rem;
  }

  .footer-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    max-width: 420px;
    line-height: 1.6;
  }

  .links-title {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-main);
    margin-bottom: 1.25rem;
  }

  .footer-link {
    display: block;
    font-size: 0.9rem;
    color: var(--text-muted);
    text-decoration: none;
    margin-bottom: 0.75rem;
    transition: color 0.15s;
  }

  .footer-link:hover {
    color: var(--primary);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 2rem;
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .copyright a {
    color: var(--text-main);
    font-weight: 600;
    text-decoration: none;
  }

  .copyright a:hover {
    color: var(--primary);
  }

  .compliance-tags {
    display: flex;
    gap: 0.75rem;
  }

  .compliance-tags span {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    padding: 0.2rem 0.65rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 1.25rem;
      text-align: center;
    }
  }
</style>
