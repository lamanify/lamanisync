---
// CtaBanner.astro - Minimalist Attio Dark Theme CTA with dense micro-pinstripes
---
<section class="dark-cta-section" id="cta">
  <!-- Top White Architectural Strip with vertical grid ticks -->
  <div class="top-strip">
    <div class="top-strip-inner">
      <div class="tick"></div>
      <div class="tick"></div>
      <div class="tick"></div>
      <div class="tick"></div>
    </div>
  </div>

  <!-- Dark Main Field -->
  <div class="dark-canvas-container">
    <div class="dark-box">
      <!-- Dense vertical micro-pinstripes texture -->
      <div class="dark-pinstripes" aria-hidden="true"></div>

      <div class="dark-cta-content">
        <h2 class="dark-cta-title">
          Clinic synchronization<br />runs on LamaniSync.
        </h2>

        <div class="dark-cta-actions">
          <a href="https://lamanihub.com" target="_blank" rel="noopener noreferrer" class="btn-dark-primary">
            Start for free
          </a>
          <a href="/contact" class="btn-dark-secondary">
            Talk to sales
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .dark-cta-section {
    background: #0b0c0e;
    position: relative;
    overflow: hidden;
  }

  /* Top White Architectural Strip */
  .top-strip {
    background: #ffffff;
    height: 44px;
    border-top: 1px solid #e2e8f0;
    border-bottom: 1px solid #1c1d1f;
    position: relative;
  }

  .top-strip-inner {
    max-width: 1200px;
    height: 100%;
    margin: 0 auto;
    border-left: 1px solid #e2e8f0;
    border-right: 1px solid #e2e8f0;
    display: flex;
    justify-content: space-around;
  }

  .top-strip-inner .tick {
    width: 1px;
    height: 100%;
    background: #f1f5f9;
  }

  /* Dark Canvas Container */
  .dark-canvas-container {
    max-width: 1200px;
    margin: 0 auto;
    border-left: 1px solid rgba(255, 255, 255, 0.08);
    border-right: 1px solid rgba(255, 255, 255, 0.08);
    position: relative;
    background: #0b0c0e;
  }

  .dark-box {
    position: relative;
    padding: 7.5rem 2rem 8.5rem 2rem;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
  }

  /* Dense vertical micro-pinstripes (4px pitch, 1px white line at 3% opacity) */
  .dark-pinstripes {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: repeating-linear-gradient(
      to right,
      rgba(255, 255, 255, 0.04) 0px,
      rgba(255, 255, 255, 0.04) 1px,
      transparent 1px,
      transparent 5px
    );
    mask-image: radial-gradient(ellipse at 50% 50%, black 50%, transparent 85%);
    -webkit-mask-image: radial-gradient(ellipse at 50% 50%, black 50%, transparent 85%);
  }

  .dark-cta-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .dark-cta-title {
    font-size: clamp(2.5rem, 5.2vw, 4rem);
    font-weight: 600;
    color: #ffffff;
    letter-spacing: -0.035em;
    line-height: 1.1;
    margin: 0 0 2rem 0;
    text-wrap: balance;
  }

  .dark-cta-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .btn-dark-primary {
    background: #25272c;
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.55rem 1.15rem;
    border-radius: 6px;
    text-decoration: none;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .btn-dark-primary:hover {
    background: #32353c;
    border-color: rgba(255, 255, 255, 0.28);
  }

  .btn-dark-secondary {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.55rem 1.15rem;
    border-radius: 6px;
    text-decoration: none;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .btn-dark-secondary:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.28);
  }

  @media (max-width: 640px) {
    .dark-box {
      padding: 5rem 1.25rem 6rem 1.25rem;
    }
    .dark-cta-title {
      font-size: 2.15rem;
      line-height: 1.15;
    }
    .dark-cta-actions {
      flex-direction: column;
      width: 100%;
    }
    .btn-dark-primary, .btn-dark-secondary {
      width: 100%;
      text-align: center;
      padding: 0.65rem 1rem;
    }
    .dark-canvas-container {
      border-left: none;
      border-right: none;
    }
  }
</style>
