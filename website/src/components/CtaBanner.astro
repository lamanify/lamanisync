---
---
<section class="section cta-section">
  <div class="container">
    <div class="cta-box">
      <div class="cta-glow"></div>
      
      <div class="badge-pill cta-badge">
        <svg style="width:12px; height:12px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        <span>Instant Activation</span>
      </div>

      <h2 class="cta-title">
        Ready to put your clinic appointments on <span class="gradient-text">autopilot</span>?
      </h2>

      <p class="cta-desc">
        Connect your Clinic Management System with LamaniHub today. Let Sara AI handle 24/7 patient WhatsApp inquiries, triage, and booking directly into your calendar.
      </p>

      <div class="cta-actions">
        <a href="https://lamanihub.com" target="_blank" rel="noopener noreferrer" class="btn-primary cta-btn-lg">
          <span>Go to LamaniHub to Get Started</span>
          <svg style="width:16px; height:16px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>

      <div class="cta-trust-items">
        <div class="trust-item">
          <svg style="width:15px; height:15px; color:#10b981;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          <span>Zero Server Setup</span>
        </div>
        <div class="trust-item">
          <svg style="width:15px; height:15px; color:#10b981;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          <span>100% Readback Verified</span>
        </div>
        <div class="trust-item">
          <svg style="width:15px; height:15px; color:#10b981;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          <span>Healthcare Privacy Compliant</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding: 5rem 0 7rem 0;
    background: #ffffff;
  }

  .cta-box {
    position: relative;
    background: linear-gradient(180deg, #ffffff 0%, var(--primary-subtle) 100%);
    border: 1px solid var(--primary-border);
    border-radius: 28px;
    padding: 4.5rem 2rem;
    text-align: center;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(233, 36, 81, 0.08);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cta-glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 300px;
    background: radial-gradient(circle, rgba(233, 36, 81, 0.12) 0%, transparent 70%);
    pointer-events: none;
  }

  .cta-badge {
    margin-bottom: 1.5rem;
  }

  .cta-title {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--text-main);
    max-width: 760px;
    line-height: 1.2;
    margin-bottom: 1.2rem;
    position: relative;
  }

  .cta-desc {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 640px;
    line-height: 1.6;
    margin-bottom: 2.5rem;
    position: relative;
  }

  .cta-actions {
    position: relative;
    margin-bottom: 2.5rem;
  }

  .cta-btn-lg {
    padding: 0.95rem 2.2rem;
    font-size: 1.05rem;
  }

  .cta-trust-items {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    flex-wrap: wrap;
    position: relative;
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: #475569;
  }

  @media (max-width: 640px) {
    .cta-box {
      padding: 3rem 1.5rem;
    }
    .cta-trust-items {
      gap: 1rem;
      flex-direction: column;
    }
  }
</style>
