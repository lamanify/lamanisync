---
---
<section class="section cta-section">
  <div class="container">
    <div class="cta-box">
      <div class="cta-glow"></div>
      
      <div class="attio-badge crimson">
        <svg style="width:12px; height:12px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        <span>Instant Activation</span>
      </div>

      <h2 class="cta-title">
        <span class="heading-dark">Ready to put your clinic appointments</span><br />
        <span class="heading-muted">on complete autopilot?</span>
      </h2>

      <p class="cta-desc">
        Connect your Clinic Management System with LamaniHub today. Let Sara AI handle 24/7 patient WhatsApp inquiries, triage, and booking directly into your calendar.
      </p>

      <div class="cta-actions">
        <a href="https://lamanihub.com" target="_blank" rel="noopener noreferrer" class="btn-primary cta-btn-lg">
          <span>Go to LamaniHub to Get Started</span>
          <svg style="width:14px; height:14px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

      <div class="cta-trust-items">
        <div class="trust-item">
          <svg style="width:14px; height:14px; color:#10b981;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          <span>Zero Server Setup</span>
        </div>
        <div class="trust-item">
          <svg style="width:14px; height:14px; color:#10b981;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          <span>100% Readback Verified</span>
        </div>
        <div class="trust-item">
          <svg style="width:14px; height:14px; color:#10b981;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          <span>Healthcare Privacy Compliant</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding: 5rem 0 6rem 0;
    background: #ffffff;
  }

  .cta-box {
    position: relative;
    background: #fafafa;
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-container);
    padding: 4.5rem 2rem;
    text-align: center;
    overflow: hidden;
    box-shadow: 0 16px 40px -10px rgba(15, 23, 42, 0.04);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cta-glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: min(600px, 100%);
    max-width: 100%;
    height: 300px;
    background: radial-gradient(circle, rgba(15, 23, 42, 0.02) 0%, transparent 70%);
    pointer-events: none;
  }

  .cta-title {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    max-width: 800px;
    line-height: 1.18;
    margin-top: 1.25rem;
    margin-bottom: 1.2rem;
    position: relative;
  }

  .cta-desc {
    font-size: 1.1rem;
    color: var(--text-muted);
    max-width: 640px;
    line-height: 1.6;
    margin-bottom: 2.5rem;
    position: relative;
  }

  .cta-actions {
    position: relative;
    margin-bottom: 2.5rem;
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .cta-btn-lg {
    padding: 0.85rem 1.8rem;
    font-size: 0.98rem;
    min-height: 44px;
  }

  .cta-trust-items {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    flex-wrap: wrap;
    position: relative;
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.84rem;
    font-weight: 600;
    color: #475569;
  }

  @media (max-width: 640px) {
    .cta-section {
      padding: 3.5rem 0 4rem 0;
    }
    .cta-box {
      padding: 2.5rem 1rem;
    }
    .cta-title {
      font-size: 1.75rem;
    }
    .cta-desc {
      font-size: 0.95rem;
      margin-bottom: 2rem;
    }
    .cta-btn-lg {
      width: 100%;
    }
    .cta-trust-items {
      gap: 0.85rem;
      flex-direction: column;
    }
  }
</style>
