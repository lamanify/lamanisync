---
// PlatformShowcase.astro - Attio 3-Column Shaded Feature Grid with Dotted Lines & Diagonal Hatch Gutters
---
<section class="attio-section shaded-bg border-t border-subtle" id="platform">
  <div class="attio-container border-x border-subtle">

    <!-- Header with Attio Two-Tone Title -->
    <header class="attio-section-head">
      <div class="attio-head-inner">
        <h2 class="attio-h2-inline">
          <span class="text-primary">Automatic synchronization, automatic advantage.</span>
          <span class="text-muted font-normal"> Connecting every clinic booking to your software with zero manual entry.</span>
        </h2>
        <p class="attio-lead-desc">
          Get the clinical context you need for every patient appointment, automatically synchronized from WhatsApp into your doctor's chair in real time.
        </p>
      </div>
    </header>

    <!-- Structural Hairline Separator with Dashed Connector Line & SVG Ticks -->
    <div class="attio-separator-wrap">
      <div class="attio-dashed-line"></div>
    </div>

    <!-- 3-Column Attio Feature Showcase with Diagonal Hatch Framing Gutters -->
    <div class="attio-hatch-container">
      <!-- Diagonal Hatch Background filling the outer gutter -->
      <div class="attio-hatch-bg" aria-hidden="true"></div>

      <!-- Inner Grid Inset showing the diagonal hatch gutters on left & right -->
      <div class="attio-grid-wrap">
        <div class="attio-3col-grid">

          <!-- Column 1: Record Enrichment -->
          <div class="attio-feature-card">
            <!-- Shaded Visual Preview Box with Dot Matrix Pattern -->
            <div class="card-visual-box">
              <div class="dot-matrix-canvas"></div>
              
              <!-- Mockup UI: Field Mapper Dropdown -->
              <div class="ui-mockup-panel">
                <div class="mockup-header">
                  <div class="mockup-add-btn">
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M6 2.5V9.5M2.5 6H9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                  </div>
                  <span class="mockup-title">Enriched Booking Payload</span>
                </div>

                <div class="mockup-fields-list">
                  <div class="field-row">
                    <div class="field-left">
                      <span class="field-icon user"></span>
                      <span class="field-label">Patient Name</span>
                    </div>
                    <span class="sparkle-icon">✨</span>
                  </div>

                  <div class="field-row">
                    <div class="field-left">
                      <span class="field-icon phone"></span>
                      <span class="field-label">WhatsApp Contact</span>
                    </div>
                    <span class="sparkle-icon">✨</span>
                  </div>

                  <div class="field-row hovered">
                    <div class="field-left">
                      <span class="field-icon pin"></span>
                      <span class="field-label">Clinic Branch</span>
                    </div>
                    <span class="sparkle-icon">✨</span>
                    <span class="cursor-pointer"></span>
                  </div>

                  <div class="field-row">
                    <div class="field-left">
                      <span class="field-icon chair"></span>
                      <span class="field-label">Doctor / Operatory</span>
                    </div>
                    <span class="sparkle-icon">✨</span>
                  </div>

                  <div class="field-row">
                    <div class="field-left">
                      <span class="field-icon badge"></span>
                      <span class="field-label">Procedure Type</span>
                    </div>
                    <span class="sparkle-icon">✨</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Card Bottom Copy -->
            <div class="card-text-box">
              <h3 class="card-title">Every appointment, enriched.</h3>
              <p class="card-desc">Patient contact, clinic branch, chair allocation, and treatment history synchronized automatically.</p>
            </div>
          </div>

          <!-- Column 2: Contextual Activity Feed -->
          <div class="attio-feature-card">
            <!-- Shaded Visual Preview Box with Dot Matrix Pattern -->
            <div class="card-visual-box">
              <div class="dot-matrix-canvas"></div>

              <!-- Mockup UI: Activity Timeline Feed -->
              <div class="ui-mockup-panel timeline-panel">
                <!-- Timeline Event 1 -->
                <div class="timeline-card">
                  <div class="timeline-meta">
                    <div class="avatar-icon calendar"></div>
                    <div class="timeline-header-text">
                      <span class="meta-actor">Dr. Maya blocked schedule</span>
                      <span class="meta-time">· 15 mins ago</span>
                    </div>
                  </div>
                  <div class="nested-event-box">
                    <div class="event-status-row">
                      <span class="status-chip success">✓ Confirmed</span>
                      <div class="avatar-stack">
                        <span class="mini-avatar blue">M</span>
                        <span class="mini-avatar orange">A</span>
                      </div>
                    </div>
                    <div class="event-title">Dr. Maya Lee — Pediatric Dental Checkup</div>
                    <div class="event-time">02:00 PM - 02:45 PM</div>
                  </div>
                  <div class="timeline-toggle">
                    <span>Show 4 more events</span>
                    <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><path d="M2.5 3.75L5 6.25L7.5 3.75" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
                  </div>
                </div>

                <!-- Timeline Event 2 -->
                <div class="timeline-card compact">
                  <div class="timeline-meta">
                    <div class="avatar-icon profile"></div>
                    <div class="timeline-header-text">
                      <span class="meta-actor">WhatsApp triage completed</span>
                      <span class="meta-time">· 1 hr ago</span>
                    </div>
                  </div>
                  <div class="nested-event-box compact">
                    <div class="event-status-row">
                      <span class="status-chip purple">Dentrix Ascend</span>
                    </div>
                    <div class="event-title">Ahmad Zulkifli — New Patient Intake</div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Card Bottom Copy -->
            <div class="card-text-box">
              <h3 class="card-title">Clinical conversations in context.</h3>
              <p class="card-desc">Your team gets live schedule context from every WhatsApp booking, chair block, and doctor change.</p>
            </div>
          </div>

          <!-- Column 3: Visual Workflow Engine -->
          <div class="attio-feature-card">
            <!-- Shaded Visual Preview Box with Dot Matrix Pattern -->
            <div class="card-visual-box">
              <div class="dot-matrix-canvas"></div>

              <!-- Mockup UI: Node-Based Automation Workflow -->
              <div class="ui-mockup-panel workflow-panel">
                <!-- Root Node -->
                <div class="workflow-node root">
                  <div class="node-status-bar">
                    <span class="status-chip success">✓ Completed</span>
                  </div>
                  <div class="node-body">
                    <div class="node-logo-wrap whatsapp">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-5.46-4.45-9.92-9.91-9.92z"/></svg>
                    </div>
                    <div class="node-text">
                      <div class="node-title">WhatsApp Booking Inbound</div>
                      <div class="node-sub">Patient requests slot via 24/7 AI chat</div>
                    </div>
                  </div>
                </div>

                <!-- Branching Connector -->
                <div class="node-branch-connector">
                  <div class="branch-line left">
                    <span class="branch-label success">Chair Available</span>
                  </div>
                  <div class="branch-line right">
                    <span class="branch-label muted">Slot Conflict</span>
                  </div>
                </div>

                <!-- Downstream Child Nodes -->
                <div class="child-nodes-row">
                  <div class="workflow-node child active">
                    <span class="status-chip blue">In progress</span>
                    <div class="child-title">Write to CMS Calendar</div>
                    <div class="child-sub">Dentrix / eClinicalWorks</div>
                  </div>
                  <div class="workflow-node child muted">
                    <div class="child-title">Alternate Slot Offer</div>
                    <div class="child-sub">Dispatches options</div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Card Bottom Copy -->
            <div class="card-text-box">
              <h3 class="card-title">Data-powered clinic workflows.</h3>
              <p class="card-desc">Automate your appointment bookings and calendar rules with verified two-way sync.</p>
            </div>
          </div>

        </div>
      </div>
    </div>

    <!-- Structural Hairline Separator with Dashed Connector Line -->
    <div class="attio-separator-wrap">
      <div class="attio-dashed-line"></div>
    </div>

    <!-- Speed to booking section: 4 Live Metrics in 1px Hairline Grid -->
    <div class="speed-section">
      <div class="speed-head">
        <h3 class="speed-title">
          <span class="text-primary">Speed to booking, every time.</span>
          <span class="text-muted font-normal"> New appointments get verified and written before the patient puts their phone down.</span>
        </h3>
      </div>

      <div class="speed-metrics-canvas">
        <div class="speed-metrics-grid">
          <div class="speed-card">
            <div class="speed-number">&lt; 1.2s</div>
            <div class="speed-label">Sub-Second Writeback</div>
            <p class="speed-sub">Synchronized from WhatsApp chat to your clinic calendar</p>
          </div>
          <div class="speed-card">
            <div class="speed-number">100%</div>
            <div class="speed-label">Readback Verification</div>
            <p class="speed-sub">Dual-phase re-query guarantees zero phantom bookings</p>
          </div>
          <div class="speed-card">
            <div class="speed-number">0</div>
            <div class="speed-label">Open Firewall Ports</div>
            <p class="speed-sub">Operates over secure outbound HTTPS/WSS tunnels</p>
          </div>
          <div class="speed-card">
            <div class="speed-number">Zero PHI</div>
            <div class="speed-label">Local Workstation Storage</div>
            <p class="speed-sub">Data processed in memory; zero patient info saved to disk</p>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .border-t { border-top: 1px solid #e2e8f0; }
  .border-x { border-left: 1px solid #e2e8f0; border-right: 1px solid #e2e8f0; }
  .border-subtle { border-color: #e2e8f0; }

  .attio-section { background: #ffffff; position: relative; }
  .attio-section.shaded-bg { background: #fafafa; }
  .attio-container { max-width: 1200px; margin: 0 auto; position: relative; background: #ffffff; }

  .attio-section-head { padding: 6rem 3.5rem 3rem 3.5rem; background: #ffffff; }
  .attio-head-inner { max-width: 860px; }
  .attio-h2-inline {
    font-size: clamp(2rem, 3.8vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0 0 1.25rem 0;
    text-wrap: balance;
  }
  .text-primary { color: #1c1d1f; }
  .text-muted { color: #6f7988; }
  .attio-lead-desc { font-size: 1.0625rem; color: #6f7988; line-height: 1.6; margin: 0; max-width: 680px; }

  /* Dashed Divider Line */
  .attio-separator-wrap { position: relative; width: 100%; height: 1px; background: #e2e8f0; }
  .attio-dashed-line {
    width: 100%;
    height: 1px;
    background-image: linear-gradient(to right, #cbd5e1 50%, transparent 50%);
    background-size: 8px 1px;
  }

  /* Diagonal Hatch Container & Inset Grid */
  .attio-hatch-container {
    position: relative;
    background-color: #fafafa;
    overflow: hidden;
    padding: 0 2rem;
  }

  .attio-hatch-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: repeating-linear-gradient(125deg, transparent, transparent 6px, rgba(15, 23, 42, 0.035) 6px, rgba(15, 23, 42, 0.035) 7px);
  }

  .attio-grid-wrap {
    position: relative;
    z-index: 1;
    border-left: 1px solid #e2e8f0;
    border-right: 1px solid #e2e8f0;
  }

  .attio-3col-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: #e2e8f0;
  }

  .attio-feature-card {
    background: #ffffff;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* Card Visual Viewport with Dot Matrix Background */
  .card-visual-box {
    position: relative;
    height: 290px;
    background-color: #fafafa;
    border-bottom: 1px solid #e2e8f0;
    padding: 1.75rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .dot-matrix-canvas {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(#cbd5e1 1px, transparent 1px);
    background-size: 16px 16px;
    opacity: 0.65;
  }

  /* Mockup Panels */
  .ui-mockup-panel {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 280px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);
    padding: 0.85rem;
  }

  /* Mockup 1: Field Mapper */
  .mockup-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid #f1f5f9;
    margin-bottom: 0.5rem;
  }
  .mockup-add-btn {
    width: 20px;
    height: 20px;
    border-radius: 5px;
    background: #f1f5f9;
    color: #64748b;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .mockup-title { font-size: 0.75rem; font-weight: 600; color: #1c1d1f; }

  .mockup-fields-list { display: flex; flex-direction: column; gap: 0.25rem; }
  .field-row {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.35rem 0.5rem;
    border-radius: 6px;
    font-size: 0.75rem;
    color: #334155;
    transition: background 0.1s ease;
  }
  .field-row.hovered { background: #f8fafc; border: 1px solid #e2e8f0; }
  .field-left { display: flex; align-items: center; gap: 0.45rem; }
  .field-icon { width: 14px; height: 14px; border-radius: 3px; background: #e2e8f0; }
  .field-icon.user { background: #e0f2fe; }
  .field-icon.phone { background: #dcfce7; }
  .field-icon.pin { background: #fef08a; }
  .field-icon.chair { background: #f3e8ff; }
  .field-icon.badge { background: #fee2e2; }
  .sparkle-icon { font-size: 0.72rem; color: #8b5cf6; }
  .cursor-pointer {
    position: absolute;
    right: -6px;
    bottom: -6px;
    width: 14px;
    height: 14px;
    background: #1c1d1f;
    clip-path: polygon(0 0, 0 100%, 35% 70%, 70% 100%, 100% 70%, 55% 45%, 100% 0);
  }

  /* Mockup 2: Activity Feed */
  .timeline-panel { max-width: 290px; padding: 0.85rem; }
  .timeline-card { margin-bottom: 0.65rem; }
  .timeline-meta { display: flex; align-items: center; gap: 0.45rem; margin-bottom: 0.35rem; }
  .avatar-icon { width: 18px; height: 18px; border-radius: 4px; }
  .avatar-icon.calendar { background: #3b82f6; }
  .avatar-icon.profile { background: #6366f1; }
  .timeline-header-text { font-size: 0.7rem; color: #1c1d1f; font-weight: 500; }
  .meta-time { color: #94a3b8; }
  .nested-event-box {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 0.5rem 0.65rem;
  }
  .event-status-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.25rem; }
  .status-chip {
    font-size: 0.625rem;
    font-weight: 600;
    padding: 0.1rem 0.4rem;
    border-radius: 9999px;
  }
  .status-chip.success { background: #dcfce7; color: #15803d; }
  .status-chip.purple { background: #f3e8ff; color: #7e22ce; }
  .status-chip.blue { background: #dbeafe; color: #1d4ed8; }
  .avatar-stack { display: flex; }
  .mini-avatar {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    font-size: 0.55rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    border: 1px solid #ffffff;
  }
  .mini-avatar.blue { background: #3b82f6; }
  .mini-avatar.orange { background: #f97316; margin-left: -4px; }
  .event-title { font-size: 0.72rem; font-weight: 600; color: #0f172a; margin-bottom: 0.15rem; }
  .event-time { font-size: 0.65rem; color: #64748b; }
  .timeline-toggle {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.65rem;
    color: #64748b;
    margin-top: 0.45rem;
    padding-left: 0.25rem;
  }

  /* Mockup 3: Workflow Canvas */
  .workflow-panel { max-width: 290px; padding: 0.85rem; }
  .workflow-node {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 0.5rem 0.65rem;
  }
  .workflow-node.root { margin-bottom: 0.4rem; }
  .node-status-bar { margin-bottom: 0.35rem; }
  .node-body { display: flex; align-items: center; gap: 0.5rem; }
  .node-logo-wrap.whatsapp {
    width: 24px;
    height: 24px;
    border-radius: 6px;
    background: #25d366;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .node-title { font-size: 0.72rem; font-weight: 600; color: #1c1d1f; line-height: 1.2; }
  .node-sub { font-size: 0.625rem; color: #64748b; }
  .node-branch-connector {
    display: flex;
    justify-content: space-between;
    padding: 0 0.5rem;
    margin: 0.35rem 0;
  }
  .branch-label { font-size: 0.58rem; font-weight: 600; padding: 0.05rem 0.3rem; border-radius: 4px; }
  .branch-label.success { background: #dcfce7; color: #15803d; }
  .branch-label.muted { background: #f1f5f9; color: #64748b; }
  .child-nodes-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.4rem; }
  .workflow-node.child { padding: 0.4rem; }
  .workflow-node.child.active { border-color: #3b82f6; background: #f8fafc; }
  .child-title { font-size: 0.65rem; font-weight: 600; color: #1c1d1f; margin-top: 0.2rem; }
  .child-sub { font-size: 0.58rem; color: #64748b; }

  /* Card Bottom Copy Box */
  .card-text-box {
    background: #ffffff;
    padding: 2.25rem 2rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }
  .card-title {
    font-size: 1.15rem;
    font-weight: 500;
    color: #1c1d1f;
    letter-spacing: -0.015em;
    margin: 0 0 0.5rem 0;
    line-height: 1.3;
  }
  .card-desc { font-size: 0.88rem; color: #6f7988; line-height: 1.55; margin: 0; }

  /* Speed Section */
  .speed-section { padding: 4.5rem 3.5rem 5rem 3.5rem; background: #ffffff; }
  .speed-head { max-width: 860px; margin-bottom: 2.75rem; }
  .speed-title {
    font-size: clamp(1.6rem, 2.8vw, 2.25rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.25;
    margin: 0;
    text-wrap: balance;
  }

  .speed-metrics-canvas {
    background: #fafafa;
    border: 1px solid #e2e8f0;
    overflow: hidden;
  }
  .speed-metrics-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: #e2e8f0;
  }
  .speed-card {
    background: #ffffff;
    padding: 2.5rem 1.5rem;
    text-align: center;
    transition: background 0.15s ease;
  }
  .speed-card:hover { background: #fafafa; }
  .speed-number {
    font-size: 2rem;
    font-weight: 700;
    color: #1c1d1f;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 0.5rem;
  }
  .speed-label { font-size: 0.82rem; font-weight: 600; color: #1c1d1f; margin-bottom: 0.35rem; }
  .speed-sub { font-size: 0.75rem; color: #6f7988; line-height: 1.45; margin: 0; }

  @media (max-width: 960px) {
    .attio-3col-grid { grid-template-columns: 1fr; }
    .speed-metrics-grid { grid-template-columns: repeat(2, 1fr); }
    .attio-hatch-container { padding: 0 1rem; }
    .attio-section-head { padding: 4rem 1.5rem 2.5rem 1.5rem; }
    .speed-section { padding: 3rem 1.5rem 3.5rem 1.5rem; }
  }

  @media (max-width: 600px) {
    .speed-metrics-grid { grid-template-columns: 1fr; }
    .attio-hatch-container { padding: 0; }
    .attio-grid-wrap { border-left: none; border-right: none; }
  }
</style>
