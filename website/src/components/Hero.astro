---
---

<section class="attio-hero-section border-t border-subtle">
  <div class="attio-container border-x border-subtle">
    <!-- Hero Copy Header -->
    <header class="hero-header">
      <!-- Eyebrow (H1 - the Title) -->
      <div class="eyebrow-wrapper">
        <h1 class="hero-eyebrow">
          <span class="eyebrow-dot"></span>
          <span>Universal Clinic Sync</span>
        </h1>
      </div>

      <!-- Headline (Short Punchy - Max 4 Words) -->
      <h2 class="hero-headline">
        One schedule. Every system.
      </h2>

      <!-- 2 Lines of Description -->
      <p class="hero-description">
        <span>The right booking is always in front of your doctors. Front-desk calendars,</span>
        <br class="hidden sm:inline" />
        <span>WhatsApp AI bots, and patient charts run on one verified picture.</span>
      </p>

      <!-- CTA Group: Contact or Learn More (Scroll Down) -->
      <div class="hero-cta-group">
        <a href="/contact" class="btn-attio-primary">
          <span>Contact for integration</span>
        </a>
        <a href="#showcase" class="btn-attio-secondary">
          <span>Learn more</span>
          <svg class="down-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none">
            <path d="M6 2.5V9.5M6 9.5L2.5 6M6 9.5L9.5 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </header>

    <!-- Attio Interactive Animated Contextual Diagram -->
    <div class="hero-diagram-frame">
      <div class="diagram-canvas" id="interactive-diagram">
        <!-- SVG Connecting Flow Lines -->
        <svg class="diagram-svg-layer" viewBox="0 0 960 480" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet">
          <!-- Flow Line 1: WhatsApp Booking -> Clinic CMS Core -->
          <path id="path-wa-cms" class="flow-line" d="M 230 110 C 340 110, 360 230, 480 230" stroke="#cbd5e1" stroke-width="1.5" stroke-dasharray="4 4" />
          <circle class="pulse-particle p-fast" r="3.5" fill="#10b981">
            <animateMotion dur="2.8s" repeatCount="indefinite" path="M 230 110 C 340 110, 360 230, 480 230" />
          </circle>

          <!-- Flow Line 2: Appointment Slot -> Clinic CMS Core -->
          <path id="path-slot-cms" class="flow-line" d="M 730 110 C 620 110, 600 230, 480 230" stroke="#cbd5e1" stroke-width="1.5" stroke-dasharray="4 4" />
          <circle class="pulse-particle p-med" r="3.5" fill="#6366f1">
            <animateMotion dur="3.2s" repeatCount="indefinite" path="M 730 110 C 620 110, 600 230, 480 230" />
          </circle>

          <!-- Flow Line 3: Clinic CMS Core -> Patient Record -->
          <path id="path-cms-pat" class="flow-line" d="M 480 250 C 370 250, 340 370, 230 370" stroke="#cbd5e1" stroke-width="1.5" stroke-dasharray="4 4" />
          <circle class="pulse-particle p-slow" r="3.5" fill="#3b82f6">
            <animateMotion dur="3.6s" repeatCount="indefinite" path="M 480 250 C 370 250, 340 370, 230 370" />
          </circle>

          <!-- Flow Line 4: Clinic CMS Core -> Audit Verification Receipt -->
          <path id="path-cms-audit" class="flow-line" d="M 480 250 C 590 250, 620 370, 730 370" stroke="#cbd5e1" stroke-width="1.5" stroke-dasharray="4 4" />
          <circle class="pulse-particle p-fast" r="3.5" fill="#f59e0b">
            <animateMotion dur="3.0s" repeatCount="indefinite" path="M 480 250 C 590 250, 620 370, 730 370" />
          </circle>

          <!-- Central Connection Node Circle -->
          <circle cx="480" cy="240" r="5" fill="#ffffff" stroke="#1c1d1f" stroke-width="2" />
        </svg>

        <!-- Node 1: WhatsApp Inbound Booking (Top-Left) -->
        <div class="schema-card node-top-left" data-node="whatsapp">
          <div class="card-head">
            <div class="entity-icon bg-emerald">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
            </div>
            <span class="entity-name">WhatsApp Chat</span>
            <span class="entity-badge badge-blue">Inbound AI</span>
          </div>
          <div class="card-attrs">
            <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Patient WhatsApp</span></div>
            <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Triage Consultation</span></div>
            <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Preferred Time Slot</span></div>
            <div class="attr-more">+ 4 More Attributes</div>
          </div>
        </div>

        <!-- Node 2: Appointment Calendar Slot (Top-Right) -->
        <div class="schema-card node-top-right" data-node="appointment">
          <div class="card-head">
            <div class="entity-icon bg-indigo">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </div>
            <span class="entity-name">Appointment Slot</span>
            <span class="entity-badge badge-gray">Standard</span>
          </div>
          <div class="card-attrs">
            <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Practitioner Roster</span></div>
            <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Operatory Chair ID</span></div>
            <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Duration (30 Mins)</span></div>
            <div class="attr-more">+ 8 More Attributes</div>
          </div>
        </div>

        <!-- Node 3: Clinic CMS Core (Center Hub) -->
        <div class="schema-card node-center-hub" data-node="cms">
          <div class="card-head">
            <div class="entity-icon bg-purple">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
            </div>
            <span class="entity-name">Clinic CMS (Kreloses / Dentrix)</span>
            <span class="entity-badge badge-green">Connected</span>
          </div>
          <div class="card-attrs">
            <div class="attr-row highlight-row"><span class="attr-bullet active"></span><span class="attr-label">Schedule Mutex Lock</span></div>
            <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Master Patient Ledger</span></div>
            <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Front-Desk Roster</span></div>
            <div class="attr-more">+ 14 More Attributes</div>
          </div>
        </div>

        <!-- Node 4: Patient Medical Record (Bottom-Left) -->
        <div class="schema-card node-bottom-left" data-node="patient">
          <div class="card-head">
            <div class="entity-icon bg-blue">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </div>
            <span class="entity-name">Patient File</span>
            <span class="entity-badge badge-gray">Standard</span>
          </div>
          <div class="card-attrs">
            <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">National ID / MRN</span></div>
            <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Encrypted Phone Number</span></div>
            <div class="attr-more">+ 6 More Attributes</div>
          </div>
        </div>

        <!-- Node 5: Verification Receipt (Bottom-Right) -->
        <div class="schema-card node-bottom-right" data-node="receipt">
          <div class="card-head">
            <div class="entity-icon bg-amber">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
            </div>
            <span class="entity-name">Readback Receipt</span>
            <span class="entity-badge badge-blue">Cryptographic</span>
          </div>
          <div class="card-attrs">
            <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">SHA-256 State Hash</span></div>
            <div class="attr-row"><span class="attr-bullet"></span><span class="attr-label">Sync Latency (0.8s)</span></div>
            <div class="attr-more">+ 5 More Attributes</div>
          </div>
        </div>

        <!-- Floating Contextual Bottom Bar (Attio Input Pill Standard) -->
        <div class="floating-query-pill">
          <div class="pill-sparkle">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m4.93 4.93 4.24 4.24"/><path d="m14.83 9.17 4.24-4.24"/></svg>
          </div>
          <span class="pill-text" id="query-ticker">Is Chair 2 open for Dr. Siti at 3:00 PM?</span>
          <button class="pill-submit" aria-label="Simulate Query" id="query-btn">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M6 9.5V2.5M6 2.5L2.5 6M6 2.5L9.5 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Dynamic ticker for the contextual query pill
  const queries = [
    "Is Chair 2 open for Dr. Siti at 3:00 PM?",
    "Sync WhatsApp booking #4819 to Kreloses schedule",
    "Verified write: Dr. Lee (Dental Operatory 1) at 4:30 PM",
    "Locking slot mutex: 0 phantom bookings detected"
  ];
  let qIdx = 0;
  const tickerEl = document.getElementById('query-ticker');
  const queryBtn = document.getElementById('query-btn');

  function rotateQuery() {
    if (!tickerEl) return;
    qIdx = (qIdx + 1) % queries.length;
    tickerEl.style.opacity = '0';
    setTimeout(() => {
      tickerEl.innerText = queries[qIdx];
      tickerEl.style.opacity = '1';
    }, 200);
  }

  setInterval(rotateQuery, 4000);
  if (queryBtn) {
    queryBtn.addEventListener('click', rotateQuery);
  }
</script>

<style>
  .border-t { border-top: 1px solid #e2e8f0; }
  .border-x { border-left: 1px solid #e2e8f0; border-right: 1px solid #e2e8f0; }
  .border-subtle { border-color: #e2e8f0; }

  .attio-hero-section {
    background: #ffffff;
    position: relative;
    overflow: hidden;
  }
  .attio-container {
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
    background: #ffffff;
  }

  /* Hero Header Copy */
  .hero-header {
    padding: 6.5rem 2rem 4rem 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Eyebrow Pill (H1) */
  .eyebrow-wrapper {
    margin-bottom: 1.5rem;
  }
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    padding: 0.35rem 0.95rem;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: #475569;
    letter-spacing: -0.01em;
    margin: 0;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
  }
  .eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10b981;
  }

  /* Headline (Max 4 words) */
  .hero-headline {
    font-size: clamp(2.5rem, 5.5vw, 4.25rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.1;
    color: #1c1d1f;
    margin: 0 0 1.25rem 0;
    text-wrap: balance;
  }

  /* Description (2 lines) */
  .hero-description {
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    font-weight: 400;
    color: #6f7988;
    line-height: 1.5;
    margin: 0 0 2.25rem 0;
    max-width: 680px;
    text-wrap: balance;
  }

  /* CTA Buttons */
  .hero-cta-group {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
  }
  .btn-attio-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #1c1d1f;
    color: #ffffff;
    font-size: 0.9375rem;
    font-weight: 500;
    padding: 0.65rem 1.4rem;
    border-radius: 9999px;
    text-decoration: none;
    border: 1px solid #1c1d1f;
    transition: background-color 0.15s ease;
  }
  .btn-attio-primary:hover { background-color: #000000; }

  .btn-attio-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    background-color: #ffffff;
    color: #1c1d1f;
    font-size: 0.9375rem;
    font-weight: 500;
    padding: 0.65rem 1.4rem;
    border-radius: 9999px;
    text-decoration: none;
    border: 1px solid #e2e8f0;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }
  .btn-attio-secondary:hover { background-color: #f8fafc; border-color: #cbd5e1; }
  .down-arrow { transition: transform 0.15s ease; }
  .btn-attio-secondary:hover .down-arrow { transform: translateY(2px); }

  /* Diagram Frame & Dot Matrix Canvas */
  .hero-diagram-frame {
    position: relative;
    padding: 0 2rem 5rem 2rem;
  }

  .diagram-canvas {
    position: relative;
    width: 100%;
    min-height: 520px;
    background-color: #ffffff;
    background-image: radial-gradient(#cbd5e1 1.2px, transparent 1.2px);
    background-size: 24px 24px;
    background-position: center center;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    overflow: hidden;
  }

  /* SVG Routing Flow Layer */
  .diagram-svg-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }
  .flow-line {
    opacity: 0.75;
  }

  /* Schema Cards Styling */
  .schema-card {
    position: absolute;
    z-index: 2;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05);
    width: 230px;
    padding: 0.85rem 1rem;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .schema-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
    border-color: #cbd5e1;
  }

  /* Layout Card Anchors */
  .node-top-left { top: 45px; left: 45px; }
  .node-top-right { top: 45px; right: 45px; }
  .node-center-hub {
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 250px;
    border-color: #cbd5e1;
    box-shadow: 0 6px 20px rgba(15, 23, 42, 0.07);
  }
  .node-center-hub:hover {
    transform: translate(-50%, calc(-50% - 2px));
  }
  .node-bottom-left { bottom: 65px; left: 60px; }
  .node-bottom-right { bottom: 65px; right: 60px; }

  /* Card Head */
  .card-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #f1f5f9;
  }
  .entity-icon {
    width: 24px;
    height: 24px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .bg-emerald { background: #dcfce7; color: #15803d; }
  .bg-indigo { background: #e0e7ff; color: #4338ca; }
  .bg-purple { background: #f3e8ff; color: #7e22ce; }
  .bg-blue { background: #dbeafe; color: #1d4ed8; }
  .bg-amber { background: #fef3c7; color: #b45309; }

  .entity-name {
    font-size: 0.8125rem;
    font-weight: 600;
    color: #1c1d1f;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex: 1;
  }

  .entity-badge {
    font-size: 0.65rem;
    font-weight: 500;
    padding: 0.15rem 0.45rem;
    border-radius: 9999px;
  }
  .badge-blue { background: #eff6ff; color: #2563eb; }
  .badge-gray { background: #f1f5f9; color: #64748b; }
  .badge-green { background: #f0fdf4; color: #166534; }

  /* Card Attributes */
  .card-attrs {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .attr-row {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.72rem;
    color: #475569;
  }
  .attr-bullet {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #cbd5e1;
  }
  .attr-bullet.active { background: #10b981; }
  .attr-label {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .highlight-row { font-weight: 600; color: #1e293b; }
  .attr-more {
    font-size: 0.68rem;
    color: #94a3b8;
    font-weight: 500;
    margin-top: 0.2rem;
  }

  /* Floating Bottom Query Pill */
  .floating-query-pill {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    padding: 0.4rem 0.5rem 0.4rem 0.85rem;
    border-radius: 9999px;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.08);
    max-width: 440px;
    width: calc(100% - 2rem);
  }
  .pill-sparkle { color: #8b5cf6; display: flex; align-items: center; }
  .pill-text {
    font-size: 0.8125rem;
    color: #64748b;
    font-weight: 400;
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: opacity 0.2s ease;
  }
  .pill-submit {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
    color: #1c1d1f;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }
  .pill-submit:hover { background: #e2e8f0; }

  @media (max-width: 900px) {
    .diagram-canvas {
      min-height: 700px;
    }
    .schema-card { width: 190px; padding: 0.65rem 0.75rem; }
    .node-top-left { top: 20px; left: 20px; }
    .node-top-right { top: 20px; right: 20px; }
    .node-bottom-left { bottom: 80px; left: 20px; }
    .node-bottom-right { bottom: 80px; right: 20px; }
    .hero-header { padding: 4.5rem 1.5rem 2.5rem 1.5rem; }
    .hero-diagram-frame { padding: 0 1rem 3rem 1rem; }
  }

  @media (max-width: 640px) {
    .diagram-canvas {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      padding: 1.5rem 1rem 4.5rem 1rem;
      min-height: auto;
    }
    .diagram-svg-layer { display: none; }
    .schema-card {
      position: relative;
      top: auto !important;
      left: auto !important;
      right: auto !important;
      bottom: auto !important;
      transform: none !important;
      width: 100%;
    }
    .hero-cta-group {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }
  }
</style>
