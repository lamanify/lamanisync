---
---
<section class="hero-section" id="topology">
  <div class="bg-grid-pattern"></div>
  <div class="hero-glow"></div>

  <div class="container hero-container">
    <!-- Attio-Style Pill Badge -->
    <a href="/#platform" class="hero-pill">
      <span class="pill-bold">Agentic Operations</span>
      <span class="pill-sep">•</span>
      <span class="pill-text">for modern clinics and EHRs</span>
      <span class="pill-arrow">›</span>
    </a>

    <!-- Attio Signature H1 -->
    <h1 class="hero-title">
      Welcome to agentic clinic operations.
    </h1>

    <!-- Attio Hero Subtitle -->
    <p class="hero-subtitle">
      LamaniSync is the bridge that synchronizes schedules, advances patient bookings, and guards clinic workflows around the clock.
    </p>

    <!-- Attio 8px Radius Dual CTAs -->
    <div class="hero-actions">
      <a href="/#how-it-works" class="btn-secondary hero-btn">
        <span>Workstation Setup</span>
      </a>
      <a href="https://lamanihub.com" target="_blank" rel="noopener noreferrer" class="btn-primary hero-btn">
        <span>Go to LamaniHub</span>
        <svg style="width:14px; height:14px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>

    <!-- Attio Framed Showcase Container -->
    <div class="sync-canvas">
      <div class="sync-canvas-header">
        <div class="sync-canvas-dots">
          <span class="mac-dot red"></span>
          <span class="mac-dot yellow"></span>
          <span class="mac-dot green"></span>
        </div>
        <div class="sync-canvas-title">
          <svg style="width:14px; height:14px; color: var(--primary);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          <span>Live Synchronizer Topology</span>
        </div>
        <div class="sync-canvas-status">
          <span class="ping-circle"></span>
          <span>Active Tunnel</span>
        </div>
      </div>

      <div class="sync-flow-grid">
        <!-- Node 1: WhatsApp Patient -->
        <div class="node-card">
          <div class="node-icon-box whatsapp">
            <svg style="width:22px; height:22px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
          </div>
          <div class="node-label">1. WhatsApp / Patient</div>
          <div class="node-sub">Patient books appointment 24/7 via natural chat</div>
          <div class="node-tag">WhatsApp Channel</div>
        </div>

        <div class="sync-connector">
          <div class="pulse-line"></div>
          <span class="connector-badge">Direct Event</span>
        </div>

        <!-- Node 2: LamaniHub Cloud -->
        <div class="node-card highlight">
          <div class="node-icon-box lamanihub">
            <svg style="width:22px; height:22px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m4.93 4.93 4.24 4.24"/><path d="m14.83 9.17 4.24-4.24"/><path d="m14.83 14.83 4.24 4.24"/><path d="m9.17 14.83-4.24 4.24"/></svg>
          </div>
          <div class="node-label">2. LamaniHub Cloud</div>
          <div class="node-sub">Dispatches signed job queue via WebCrypto Ed25519</div>
          <div class="node-tag primary">Orchestration Hub</div>
        </div>

        <div class="sync-connector">
          <div class="pulse-line"></div>
          <span class="connector-badge">Zero Ports</span>
        </div>

        <!-- Node 3: LamaniSync Extension -->
        <div class="node-card active-bridge">
          <div class="node-icon-box sync">
            <svg style="width:22px; height:22px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
          </div>
          <div class="node-label">3. LamaniSync (Workstation)</div>
          <div class="node-sub">Runs securely inside clinic browser, 0 local server needed</div>
          <div class="node-tag active">MV3 Bridge</div>
        </div>

        <div class="sync-connector">
          <div class="pulse-line"></div>
          <span class="connector-badge">DOM / API</span>
        </div>

        <!-- Node 4: Clinic CMS -->
        <div class="node-card">
          <div class="node-icon-box cms">
            <svg style="width:22px; height:22px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/><path d="m9 16 2 2 4-4"/></svg>
          </div>
          <div class="node-label">4. Your Clinic CMS</div>
          <div class="node-sub">Dentrix, eClinicalWorks, LamaniPulse appointment booked!</div>
          <div class="node-tag success">Verified Write</div>
        </div>
      </div>

      <div class="sync-canvas-footer">
        <div class="sync-metric">
          <span class="metric-val">100%</span>
          <span class="metric-lbl">Readback Verified</span>
        </div>
        <div class="sync-metric-divider"></div>
        <div class="sync-metric">
          <span class="metric-val">&lt; 1.2s</span>
          <span class="metric-lbl">Average Sync Speed</span>
        </div>
        <div class="sync-metric-divider"></div>
        <div class="sync-metric">
          <span class="metric-val">0</span>
          <span class="metric-lbl">Open Firewall Ports</span>
        </div>
        <div class="sync-metric-divider"></div>
        <div class="sync-metric">
          <span class="metric-val">Zero PHI</span>
          <span class="metric-lbl">Stored on Workstation</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding: 6.5rem 0 5.5rem 0;
    overflow: hidden;
    background: #ffffff;
  }

  .hero-glow {
    position: absolute;
    top: -20%;
    left: 50%;
    transform: translateX(-50%);
    width: min(900px, 100%);
    max-width: 100%;
    height: 520px;
    background: radial-gradient(circle, rgba(15, 23, 42, 0.025) 0%, rgba(255, 255, 255, 0) 70%);
    pointer-events: none;
    z-index: 0;
  }

  .hero-container {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-pill {
    margin-bottom: 2rem;
  }

  .pill-sep {
    color: #cbd5e1;
    font-size: 0.75rem;
  }

  .hero-title {
    font-size: clamp(2.6rem, 5.5vw, 4.5rem);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.035em;
    max-width: 920px;
    color: var(--text-main);
    margin-bottom: 1.25rem;
  }

  .hero-subtitle {
    font-size: clamp(1.05rem, 1.9vw, 1.2rem);
    font-weight: 400;
    color: var(--text-muted);
    max-width: 660px;
    line-height: 1.6;
    margin-bottom: 2.25rem;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    margin-bottom: 4rem;
  }

  .hero-btn {
    padding: 0.75rem 1.6rem;
    font-size: 0.95rem;
  }

  /* Hairline Framed Topology Canvas (20px geometry) */
  .sync-canvas {
    width: 100%;
    max-width: 1140px;
    background: #ffffff;
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-container);
    box-shadow: 0 20px 45px -15px rgba(15, 23, 42, 0.05);
    overflow: hidden;
    text-align: left;
  }

  .sync-canvas-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1.4rem;
    background: #fafafa;
    border-bottom: 1px solid var(--border-hairline);
  }

  .sync-canvas-dots {
    display: flex;
    gap: 6px;
  }

  .mac-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .mac-dot.red { background: #ff5f56; }
  .mac-dot.yellow { background: #ffbd2e; }
  .mac-dot.green { background: #27c93f; }

  .sync-canvas-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: #334155;
  }

  .sync-canvas-status {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.76rem;
    font-weight: 600;
    color: #059669;
  }

  .ping-circle {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10b981;
    position: relative;
  }

  .ping-circle::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 2px solid #10b981;
    animation: ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes ping {
    75%, 100% {
      transform: scale(2);
      opacity: 0;
    }
  }

  .sync-flow-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
    align-items: center;
    padding: 2.5rem 1.8rem;
    gap: 0.65rem;
    background: #ffffff;
  }

  /* Clean Minimalist Node Cards (12px radius, hairline border) */
  .node-card {
    background: #ffffff;
    border: 1px solid var(--border-hairline);
    border-radius: 12px;
    padding: 1.3rem 1.1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.03);
  }

  .node-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.06);
    border-color: #cbd5e1;
  }

  .node-card.highlight {
    border-color: var(--border-hairline);
    background: #fafafa;
  }

  .node-card.active-bridge {
    border-color: var(--primary);
    box-shadow: 0 4px 16px rgba(233, 36, 81, 0.08);
  }

  .node-icon-box {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.85rem;
    background: #f8fafc;
    border: 1px solid var(--border-hairline);
    color: var(--text-main);
  }

  .node-icon-box.whatsapp {
    background: #f8fafc;
    color: #0f172a;
  }

  .node-icon-box.lamanihub {
    background: #f8fafc;
    color: #0f172a;
  }

  .node-icon-box.sync {
    background: var(--primary);
    border-color: var(--primary);
    color: #ffffff;
    box-shadow: 0 2px 8px rgba(233, 36, 81, 0.25);
  }

  .node-icon-box.cms {
    background: #f8fafc;
    color: #0f172a;
  }

  .node-label {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 0.35rem;
  }

  .node-sub {
    font-size: 0.76rem;
    color: var(--text-muted);
    line-height: 1.45;
    margin-bottom: 0.75rem;
    min-height: 2.6rem;
  }

  .node-tag {
    font-size: 0.66rem;
    font-weight: 600;
    padding: 0.18rem 0.55rem;
    border-radius: 6px;
    background: #f8fafc;
    border: 1px solid var(--border-hairline);
    color: #475569;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .node-tag.primary {
    background: #f8fafc;
    border-color: var(--border-hairline);
    color: var(--text-main);
  }

  .node-tag.active {
    background: #fff1f3;
    border-color: #fecdd6;
    color: var(--primary);
  }

  .node-tag.success {
    background: #f0fdf4;
    border-color: #dcfce7;
    color: #166534;
  }

  /* 1px Pulse Connectors */
  .sync-connector {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    position: relative;
    padding: 0 0.2rem;
  }

  .pulse-line {
    width: 44px;
    height: 1px;
    background: var(--border-hairline);
    position: relative;
  }

  .pulse-line::after {
    content: '';
    position: absolute;
    top: -1.5px;
    left: 0;
    width: 6px;
    height: 4px;
    border-radius: 2px;
    background: var(--primary);
    animation: flowPulse 2s ease-in-out infinite;
  }

  @keyframes flowPulse {
    0% { left: 0; opacity: 0; }
    30% { opacity: 1; }
    70% { opacity: 1; }
    100% { left: 38px; opacity: 0; }
  }

  .connector-badge {
    font-size: 0.62rem;
    font-weight: 600;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: #ffffff;
    border: 1px solid var(--border-hairline);
    padding: 0.12rem 0.4rem;
    border-radius: 4px;
    white-space: nowrap;
  }

  .sync-canvas-footer {
    display: flex;
    align-items: center;
    justify-content: space-around;
    padding: 1.25rem 1.8rem;
    background: #fafafa;
    border-top: 1px solid var(--border-hairline);
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .sync-metric {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .metric-val {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--primary);
    letter-spacing: -0.02em;
  }

  .metric-lbl {
    font-size: 0.76rem;
    color: #64748b;
    font-weight: 500;
    margin-top: 0.15rem;
  }

  .sync-metric-divider {
    width: 1px;
    height: 30px;
    background: var(--border-hairline);
  }

  @media (max-width: 992px) {
    .sync-flow-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .sync-connector {
      transform: none;
      flex-direction: column;
      gap: 0.35rem;
      padding: 0.25rem 0;
    }
    .pulse-line {
      width: 1px;
      height: 28px;
    }
    .pulse-line::after {
      width: 4px;
      height: 6px;
      top: 0;
      left: -1.5px;
      animation: flowPulseVertical 2s ease-in-out infinite;
    }
    .sync-canvas-footer {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
      padding: 1.25rem 1rem;
    }
    .sync-metric-divider {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .hero-section {
      padding: 4.5rem 0 3.5rem 0;
    }
    .hero-actions {
      flex-direction: column;
      width: 100%;
      gap: 0.65rem;
    }
    .hero-btn {
      width: 100%;
    }
    .sync-flow-grid {
      padding: 1.5rem 1rem;
    }
    .sync-canvas-footer {
      grid-template-columns: 1fr 1fr;
      gap: 0.85rem;
      padding: 1rem 0.6rem;
    }
    .metric-val {
      font-size: 1.15rem;
    }
    .metric-lbl {
      font-size: 0.7rem;
    }
  }

  @keyframes flowPulseVertical {
    0% { top: 0; opacity: 0; }
    30% { opacity: 1; }
    70% { opacity: 1; }
    100% { top: 22px; opacity: 0; }
  }
</style>
