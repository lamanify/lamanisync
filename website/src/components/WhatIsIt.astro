---
const valueItems = [
  {
    num: "01",
    tag: "Native Architecture",
    title: "Dedicated to LamaniHub",
    desc: "Not a generic Zapier connector. LamaniSync is purpose-built to orchestrate with LamaniHub WhatsApp booking pipelines, triages, and calendar slots."
  },
  {
    num: "02",
    tag: "Bidirectional Flow",
    title: "Real-Time Two-Way Sync",
    desc: "Doctor shifts, blocked lunch hours, and booked chairs update continuously so LamaniHub never offers a slot that has already been taken."
  },
  {
    num: "03",
    tag: "Zero Footprint",
    title: "No Server or Daemon Needed",
    desc: "Runs entirely inside the workstation browser your team already keeps open. Zero terminal commands, zero background daemons, zero open ports."
  }
];
---

<section id="what-is-it" class="attio-section border-t border-subtle">
  <div class="attio-container border-x border-subtle">

    <header class="attio-section-head">
      <div class="attio-head-inner">
        <h2 class="attio-h2-inline">
          <span class="text-primary">The missing link for clinical automation.</span>
          <span class="text-muted font-normal"> Connecting your clinic software directly to WhatsApp booking.</span>
        </h2>
        <p class="attio-lead-desc">
          Clinics lose thousands monthly from missed calls and delayed replies. LamaniHub answers patient inquiries 24/7 on WhatsApp, while LamaniSync bridges the chat directly to your doctor's chair.
        </p>
      </div>
    </header>

    <div class="attio-separator-wrap">
      <div class="attio-dashed-line"></div>
    </div>

    <!-- Architectural Comparison Panel (1px Gap Split) -->
    <div class="attio-split-canvas">
      <div class="attio-dot-bg"></div>
      
      <div class="attio-split-grid">
        <!-- Col 1: Old Problem -->
        <div class="attio-split-cell">
          <div class="cell-overline">[LEGACY]</div>
          <h3 class="cell-title text-destructive">Locked-down clinic systems</h3>
          <p class="cell-desc mb-6">Traditional EHRs lock down APIs, forcing expensive IT integration or risky manual workarounds.</p>
          
          <ul class="attio-feature-list">
            <li>
              <span class="list-bullet error">&#x2715;</span>
              <span>Staff retyping WhatsApp chat info into software by hand</span>
            </li>
            <li>
              <span class="list-bullet error">&#x2715;</span>
              <span>Double bookings when doctors modify schedules internally</span>
            </li>
            <li>
              <span class="list-bullet error">&#x2715;</span>
              <span>Dangerous firewall port forwarding and expensive IT contracts</span>
            </li>
          </ul>
        </div>

        <!-- Col 2: LamaniSync Solution -->
        <div class="attio-split-cell highlight">
          <div class="cell-overline text-accent">[LAMANISYNC]</div>
          <h3 class="cell-title">Universal front-desk workstation bridge</h3>
          <p class="cell-desc mb-6">Runs securely inside the receptionist's browser, synchronizing appointments in real time.</p>

          <ul class="attio-feature-list">
            <li>
              <span class="list-bullet success">&#x2713;</span>
              <span><strong>Instant automated entry:</strong> WhatsApp bookings appear directly on your calendar</span>
            </li>
            <li>
              <span class="list-bullet success">&#x2713;</span>
              <span><strong>Zero open ports:</strong> Operates entirely inside outbound HTTPS/WSS tunnels</span>
            </li>
            <li>
              <span class="list-bullet success">&#x2713;</span>
              <span><strong>Readback verification:</strong> Re-queries schedule to verify before confirming</span>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="attio-separator-wrap">
      <div class="attio-dashed-line"></div>
    </div>

    <!-- 3-Column Pillar Grid (1px gap) -->
    <div class="attio-pillars-canvas">
      <div class="attio-pillars-grid">
        {valueItems.map((item) => (
          <div class="attio-pillar-cell">
            <div class="cell-overline">[{item.num}]</div>
            <h4 class="pillar-title">{item.title}</h4>
            <p class="pillar-desc">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
  .border-t { border-top: 1px solid #e2e8f0; }
  .border-x { border-left: 1px solid #e2e8f0; border-right: 1px solid #e2e8f0; }
  .border-subtle { border-color: #e2e8f0; }
  .attio-section { background: #ffffff; position: relative; }
  .attio-container { max-width: 1200px; margin: 0 auto; position: relative; background: #ffffff; }

  .attio-section-head { padding: 6rem 3.5rem 3rem 3.5rem; background: #ffffff; }
  .attio-head-inner { max-width: 860px; }
  .attio-h2-inline {
    font-size: clamp(2rem, 3.8vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0 0 1.25rem 0;
    text-wrap: balance;
  }
  .text-primary { color: #1c1d1f; }
  .text-muted { color: #6f7988; }
  .attio-lead-desc { font-size: 1.0625rem; color: #6f7988; line-height: 1.6; margin: 0; max-width: 680px; }

  .attio-separator-wrap { position: relative; width: 100%; height: 1px; background: #e2e8f0; }
  .attio-dashed-line {
    width: 100%;
    height: 1px;
    background-image: linear-gradient(to right, #cbd5e1 50%, transparent 50%);
    background-size: 8px 1px;
  }

  .attio-split-canvas { position: relative; background: #fafafa; overflow: hidden; }
  .attio-dot-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(#cbd5e1 1px, transparent 1px);
    background-size: 20px 20px;
    opacity: 0.55;
  }

  .attio-split-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: #e2e8f0;
  }

  .attio-split-cell { background: #ffffff; padding: 3.5rem 3rem; display: flex; flex-direction: column; }
  .attio-split-cell.highlight { background: #ffffff; }

  .cell-overline {
    font-size: 0.75rem;
    font-weight: 600;
    color: #94a3b8;
    letter-spacing: 0.08em;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    margin-bottom: 1.5rem;
  }
  .cell-title {
    font-size: 1.35rem;
    font-weight: 500;
    color: #1c1d1f;
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin: 0 0 0.85rem 0;
  }
  .cell-desc { font-size: 0.95rem; color: #6f7988; line-height: 1.55; margin: 0 0 1.5rem 0; }

  .attio-feature-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1rem; }
  .attio-feature-list li { display: flex; align-items: flex-start; gap: 0.85rem; font-size: 0.9rem; color: #334155; line-height: 1.45; }
  .list-bullet {
    width: 20px;
    height: 20px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }
  .list-bullet.error { background: #fef2f2; color: #ef4444; border: 1px solid #fee2e2; }
  .list-bullet.success { background: #f0fdf4; color: #16a34a; border: 1px solid #dcfce7; }

  /* 3 Pillars */
  .attio-pillars-canvas { background: #ffffff; }
  .attio-pillars-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: #e2e8f0; border-bottom: 1px solid #e2e8f0; }
  .attio-pillar-cell { background: #ffffff; padding: 2.75rem 2.25rem; transition: background 0.15s ease; }
  .attio-pillar-cell:hover { background: #fafafa; }
  .pillar-title { font-size: 1.1rem; font-weight: 500; color: #1c1d1f; margin: 0 0 0.65rem 0; letter-spacing: -0.015em; }
  .pillar-desc { font-size: 0.875rem; color: #6f7988; line-height: 1.6; margin: 0; }

  @media (max-width: 900px) {
    .attio-split-grid { grid-template-columns: 1fr; }
    .attio-pillars-grid { grid-template-columns: 1fr; }
    .attio-section-head { padding: 4rem 1.5rem 2.5rem 1.5rem; }
    .attio-split-cell { padding: 2.5rem 1.5rem; }
    .attio-pillar-cell { padding: 2.25rem 1.5rem; }
  }
</style>
