---
// Navbar.astro - Attio-inspired modern navigation with dismissible announcement banner & mobile drawer
---
<div class="announcement-bar" id="announcement-bar">
  <script is:inline>
    if (typeof sessionStorage !== 'undefined' && sessionStorage.getItem('ls_banner_dismissed') === 'true') {
      var bar = document.getElementById('announcement-bar');
      if (bar) bar.style.display = 'none';
    }
  </script>
  <a href="/#platform" class="announcement-link">
    <span>Orchestrate agentic clinic operations with LamaniSync</span>
    <svg class="announcement-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
      <path d="M5 12h14M12 5l7 7-7 7"/>
    </svg>
  </a>
  <button id="close-announcement" class="announcement-close" aria-label="Dismiss banner">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>
</div>

<header class="navbar">
  <div class="container nav-container">
    <a href="/" class="brand-link" aria-label="LamaniSync Home">
      <img src="https://res.cloudinary.com/lamanify/image/upload/v1790242929/LamaniSync_Logo.png" alt="LamaniSync Logo" class="brand-logo" />
    </a>

    <!-- Desktop Nav Links -->
    <nav class="nav-links">
      <div class="nav-item has-dropdown">
        <a href="/what-is-synchronizer" class="nav-link">
          <span>Platform</span>
          <svg class="dropdown-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </a>
        <div class="dropdown-menu">
          <a href="/what-is-synchronizer" class="dropdown-item">
            <div class="item-title">What is Synchronizer?</div>
            <div class="item-desc">Universal translation layer for clinic CMS</div>
          </a>
          <a href="/features" class="dropdown-item">
            <div class="item-title">Features & Capabilities</div>
            <div class="item-desc">Sub-second sync, chair routing, verified write</div>
          </a>
          <a href="/#platform" class="dropdown-item">
            <div class="item-title">Intelligent Scheduler</div>
            <div class="item-desc">Reads clinic slots & writes bookings 24/7</div>
          </a>
          <a href="/#topology" class="dropdown-item">
            <div class="item-title">Workstation Topology</div>
            <div class="item-desc">MV3 secure bridge architecture</div>
          </a>
        </div>
      </div>

      <a href="/why-we-dont-partner" class="nav-link">Why We Don't Partner</a>

      <div class="nav-item has-dropdown">
        <a href="/#supported-cms" class="nav-link">
          <span>Ecosystem</span>
          <svg class="dropdown-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </a>
        <div class="dropdown-menu">
          <a href="/#supported-cms" class="dropdown-item">
            <div class="item-title">Supported CMS</div>
            <div class="item-desc">Dentrix, eClinicalWorks, LamaniPulse</div>
          </a>
          <a href="/#how-it-works" class="dropdown-item">
            <div class="item-title">How It Works</div>
            <div class="item-desc">Zero open ports, pure memory execution</div>
          </a>
          <a href="/#security" class="dropdown-item">
            <div class="item-title">Security & Zero-Knowledge</div>
            <div class="item-desc">WebCrypto Ed25519 & MV3 sandboxing</div>
          </a>
        </div>
      </div>

      <a href="/blog" class="nav-link">Blog</a>
      <a href="/contact" class="nav-link">Contact</a>
    </nav>

    <!-- Right Action CTAs -->
    <div class="nav-cta">
      <a href="/#how-it-works" class="btn-secondary nav-btn-ghost">
        <span>Workstation Setup</span>
      </a>
      <a href="https://lamanihub.com" target="_blank" rel="noopener noreferrer" class="btn-primary nav-btn-primary">
        <span>Go to LamaniHub</span>
        <svg style="width:13px; height:13px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/></svg>
      </a>
      <!-- Mobile Menu Toggle Button -->
      <button id="mobile-menu-toggle" class="mobile-menu-btn" aria-label="Toggle navigation menu" aria-expanded="false">
        <svg class="hamburger-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg class="close-menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Navigation -->
  <div id="mobile-nav-drawer" class="mobile-nav-drawer">
    <div class="mobile-nav-content">
      <a href="/what-is-synchronizer" class="mobile-link">What is Synchronizer?</a>
      <a href="/features" class="mobile-link">Features & Capabilities</a>
      <a href="/why-we-dont-partner" class="mobile-link">Why We Don't Partner (Manifesto)</a>
      <a href="/#platform" class="mobile-link">Platform Overview</a>
      <a href="/#topology" class="mobile-link">Workstation Topology</a>
      <a href="/#supported-cms" class="mobile-link">Supported CMS Matrix</a>
      <a href="/#how-it-works" class="mobile-link">How It Works</a>
      <a href="/#security" class="mobile-link">Security & Privacy</a>
      <a href="/blog" class="mobile-link">Engineering Blog</a>
      <a href="/contact" class="mobile-link">Contact Support</a>
      <div class="mobile-divider"></div>
      <a href="/#how-it-works" class="btn-secondary mobile-cta-btn">Workstation Setup</a>
      <a href="https://lamanihub.com" target="_blank" rel="noopener noreferrer" class="btn-primary mobile-cta-btn">
        <span>Go to LamaniHub</span>
        <svg style="width:13px; height:13px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/></svg>
      </a>
    </div>
  </div>
</header>

<script>
  // Banner dismiss handler
  const banner = document.getElementById('announcement-bar');
  const closeBtn = document.getElementById('close-announcement');
  if (closeBtn && banner) {
    closeBtn.addEventListener('click', () => {
      banner.style.display = 'none';
      sessionStorage.setItem('ls_banner_dismissed', 'true');
    });
  }

  // Mobile drawer toggle handler
  const menuToggle = document.getElementById('mobile-menu-toggle');
  const mobileDrawer = document.getElementById('mobile-nav-drawer');
  if (menuToggle && mobileDrawer) {
    menuToggle.addEventListener('click', () => {
      const isOpen = mobileDrawer.classList.toggle('open');
      menuToggle.classList.toggle('active', isOpen);
      menuToggle.setAttribute('aria-expanded', String(isOpen));
    });

    // Close when clicking any mobile link
    mobileDrawer.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        mobileDrawer.classList.remove('open');
        menuToggle.classList.remove('active');
        menuToggle.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>

<style>
  /* Sleek Minimal Black Announcement Ribbon */
  .announcement-bar {
    background: #0f172a;
    color: #ffffff;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 0.45rem 2.8rem 0.45rem 1.25rem;
    font-size: 0.8rem;
    font-weight: 500;
    z-index: 110;
    text-align: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .announcement-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    gap: 0.45rem;
    color: #e2e8f0;
    text-decoration: none;
    transition: color 0.15s ease;
    flex-wrap: wrap;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .announcement-link:hover {
    color: #ffffff;
  }

  .announcement-arrow {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
    transition: transform 0.15s ease;
  }

  .announcement-link:hover .announcement-arrow {
    transform: translateX(3px);
  }

  .announcement-close {
    position: absolute;
    right: 0.25rem;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: none;
    color: #94a3b8;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0;
    border-radius: 4px;
    transition: color 0.15s;
  }

  .announcement-close svg {
    width: 15px;
    height: 15px;
  }

  .announcement-close:hover {
    color: #ffffff;
  }

  /* Sleek Modern Navbar with Razor-Thin Hairline Border */
  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-hairline);
    transition: all 0.2s ease;
  }

  .nav-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-height);
  }

  .brand-link {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  .brand-logo {
    height: 34px;
    width: auto;
    object-fit: contain;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: #475569;
    font-size: 0.88rem;
    font-weight: 500;
    text-decoration: none;
    padding: 0.5rem 0.25rem;
    transition: color 0.15s ease;
  }

  .nav-link:hover {
    color: var(--primary);
  }

  .dropdown-caret {
    width: 11px;
    height: 11px;
    color: #94a3b8;
    transition: transform 0.2s ease, color 0.15s ease;
  }

  .nav-item:hover .dropdown-caret {
    transform: rotate(180deg);
    color: var(--primary);
  }

  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    width: 280px;
    background: #ffffff;
    border: 1px solid var(--border-hairline);
    border-radius: 12px;
    box-shadow: 0 10px 25px rgba(15, 23, 42, 0.06);
    padding: 0.5rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .nav-item:hover .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-item {
    padding: 0.6rem 0.75rem;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.15s;
  }

  .dropdown-item:hover {
    background: #f8fafc;
  }

  .item-title {
    font-size: 0.86rem;
    font-weight: 600;
    color: #0f172a;
  }

  .item-desc {
    font-size: 0.74rem;
    color: #64748b;
    margin-top: 0.15rem;
  }

  .nav-cta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .nav-btn-ghost {
    font-size: 0.86rem;
    padding: 0.55rem 1rem;
    background: #ffffff;
    border: 1px solid var(--border-hairline);
    color: #0f172a;
  }

  .nav-btn-primary {
    font-size: 0.86rem;
    padding: 0.55rem 1.15rem;
  }

  /* Mobile menu button */
  .mobile-menu-btn {
    display: none;
    background: transparent;
    border: 1px solid var(--border-hairline);
    border-radius: 8px;
    padding: 0.5rem;
    min-width: 44px;
    min-height: 44px;
    color: #0a0a0a;
    cursor: pointer;
    align-items: center;
    justify-content: center;
  }

  .mobile-menu-btn svg {
    width: 22px;
    height: 22px;
  }

  .mobile-menu-btn .close-menu-icon {
    display: none;
  }

  .mobile-menu-btn.active .hamburger-icon {
    display: none;
  }

  .mobile-menu-btn.active .close-menu-icon {
    display: block;
  }

  /* Mobile Drawer */
  .mobile-nav-drawer {
    display: none;
    background: #ffffff;
    border-bottom: 1px solid var(--border-hairline);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mobile-nav-drawer.open {
    max-height: calc(100vh - var(--nav-height) - 40px);
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .mobile-nav-content {
    display: flex;
    flex-direction: column;
    padding: 1.25rem 1.5rem;
    gap: 0.5rem;
  }

  .mobile-link {
    font-size: 0.95rem;
    font-weight: 500;
    color: #0f172a;
    text-decoration: none;
    padding: 0.6rem 0.5rem;
    min-height: 44px;
    display: flex;
    align-items: center;
    border-radius: 8px;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .mobile-link:hover,
  .mobile-link:active {
    background: #f8fafc;
    color: var(--primary);
  }

  .mobile-divider {
    height: 1px;
    background: var(--border-hairline);
    margin: 0.4rem 0;
  }

  .mobile-cta-btn {
    width: 100%;
    text-align: center;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  @media (max-width: 860px) {
    .nav-links {
      display: none;
    }
    .announcement-bar {
      font-size: 0.76rem;
      padding: 0.45rem 2.8rem 0.45rem 0.75rem;
    }
    .nav-btn-ghost {
      display: none;
    }
    .mobile-menu-btn {
      display: inline-flex;
    }
    .mobile-nav-drawer {
      display: block;
    }
  }

  @media (max-width: 640px) {
    .nav-btn-primary {
      display: none;
    }
    .announcement-bar {
      font-size: 0.72rem;
      padding: 0.45rem 2.8rem 0.45rem 0.75rem;
      word-break: break-word;
    }
  }
</style>
