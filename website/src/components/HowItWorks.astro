---
const steps = [
  {
    num: "01",
    time: "15 Seconds",
    title: "Add LamaniSync to Google Chrome",
    desc: "Install LamaniSync on the front-desk workstation staff already use to open your clinic management portal. Operates within the browser toolbar with zero impact on PC performance."
  },
  {
    num: "02",
    time: "30 Seconds",
    title: "Enter Your LamaniHub Workstation Key",
    desc: "Generate your one-time clinic pairing code in LamaniHub. LamaniSync establishes a hardware-isolated WebCrypto Ed25519 encrypted tunnel. Zero server setup."
  },
  {
    num: "03",
    time: "Autopilot",
    title: "WhatsApp Bookings Sync Automatically",
    desc: "Open your clinic management system as usual. When a patient books via LamaniHub WhatsApp, LamaniSync reads schedule availability, writes the appointment, and readback verifies."
  }
];
---

<section id="how-it-works" class="attio-section shaded-bg border-t border-subtle">
  <div class="attio-container border-x border-subtle">

    <header class="attio-section-head">
      <div class="attio-head-inner">
        <h2 class="attio-h2-inline">
          <span class="text-primary">How it works.</span>
          <span class="text-muted font-normal"> Up and running on your front-desk workstation in under 2 minutes.</span>
        </h2>
        <p class="attio-lead-desc">
          No IT consultants or server deployments required. If your reception team can use Google Chrome, they can set up LamaniSync for your entire clinic practice.
        </p>
      </div>
    </header>

    <div class="attio-separator-wrap">
      <div class="attio-dashed-line"></div>
    </div>

    <!-- Outer Diagonal Hatch Gutters -->
    <div class="attio-hatch-container">
      <div class="attio-hatch-bg" aria-hidden="true"></div>

      <div class="attio-grid-wrap">
        <div class="attio-steps-grid">
          {steps.map((step) => (
            <div class="attio-step-cell">
              <div class="step-meta">
                <span class="step-num">[{step.num}]</span>
                <span class="step-time">{step.time}</span>
              </div>
              <h3 class="step-title">{step.title}</h3>
              <p class="step-desc">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Live Status Console Ribbon (Attio Architectural Terminal Bar) -->
    <div class="attio-console-strip">
      <div class="console-item">
        <span class="console-dot green"></span>
        <span class="console-label">Handshake:</span>
        <span class="console-val">WebCrypto Ed25519 Active</span>
      </div>
      <div class="console-item">
        <span class="console-dot blue"></span>
        <span class="console-label">Channel:</span>
        <span class="console-val">WSS Encrypted Tunnel</span>
      </div>
      <div class="console-item">
        <span class="console-dot purple"></span>
        <span class="console-label">Verification:</span>
        <span class="console-val">Two-Step Readback Guarantee</span>
      </div>
    </div>

  </div>
</section>

<style>
  .border-t { border-top: 1px solid #e2e8f0; }
  .border-x { border-left: 1px solid #e2e8f0; border-right: 1px solid #e2e8f0; }
  .border-subtle { border-color: #e2e8f0; }
  .attio-section { background: #ffffff; position: relative; }
  .attio-section.shaded-bg { background: #fafafa; }
  .attio-container { max-width: 1200px; margin: 0 auto; position: relative; background: #ffffff; }

  .attio-section-head { padding: 6rem 3.5rem 3rem 3.5rem; background: #ffffff; }
  .attio-head-inner { max-width: 860px; }
  .attio-h2-inline {
    font-size: clamp(2rem, 3.8vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0 0 1.25rem 0;
    text-wrap: balance;
  }
  .text-primary { color: #1c1d1f; }
  .text-muted { color: #6f7988; }
  .attio-lead-desc { font-size: 1.0625rem; color: #6f7988; line-height: 1.6; margin: 0; max-width: 680px; }

  .attio-separator-wrap { position: relative; width: 100%; height: 1px; background: #e2e8f0; }
  .attio-dashed-line {
    width: 100%;
    height: 1px;
    background-image: linear-gradient(to right, #cbd5e1 50%, transparent 50%);
    background-size: 8px 1px;
  }

  /* Diagonal Hatch Gutters Container */
  .attio-hatch-container {
    position: relative;
    background-color: #fafafa;
    overflow: hidden;
    padding: 0 2rem;
  }

  .attio-hatch-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: repeating-linear-gradient(125deg, transparent, transparent 6px, rgba(15, 23, 42, 0.035) 6px, rgba(15, 23, 42, 0.035) 7px);
  }

  .attio-grid-wrap {
    position: relative;
    z-index: 1;
    border-left: 1px solid #e2e8f0;
    border-right: 1px solid #e2e8f0;
  }

  .attio-steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: #e2e8f0;
  }

  .attio-step-cell {
    background: #ffffff;
    padding: 3.5rem 2.5rem;
    display: flex;
    flex-direction: column;
    transition: background 0.15s ease;
  }
  .attio-step-cell:hover { background: #fafafa; }

  .step-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.75rem;
  }
  .step-num {
    font-size: 0.75rem;
    font-weight: 600;
    color: #94a3b8;
    letter-spacing: 0.08em;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }
  .step-time {
    font-size: 0.72rem;
    font-weight: 500;
    color: #64748b;
    background: #f1f5f9;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    border: 1px solid #e2e8f0;
  }

  .step-title {
    font-size: 1.18rem;
    font-weight: 500;
    color: #1c1d1f;
    letter-spacing: -0.015em;
    line-height: 1.35;
    margin: 0 0 0.85rem 0;
  }
  .step-desc { font-size: 0.88rem; color: #6f7988; line-height: 1.6; margin: 0; }

  /* Console ribbon */
  .attio-console-strip {
    display: flex;
    align-items: center;
    justify-content: space-around;
    padding: 1.25rem 2rem;
    background: #ffffff;
    border-top: 1px solid #e2e8f0;
    border-bottom: 1px solid #e2e8f0;
    flex-wrap: wrap;
    gap: 1.5rem;
  }
  .console-item { display: flex; align-items: center; gap: 0.5rem; font-size: 0.8125rem; font-family: ui-monospace, SFMono-Regular, monospace; }
  .console-dot { width: 7px; height: 7px; border-radius: 50%; }
  .console-dot.green { background: #10b981; }
  .console-dot.blue { background: #3b82f6; }
  .console-dot.purple { background: #8b5cf6; }
  .console-label { color: #94a3b8; font-weight: 500; }
  .console-val { color: #334155; font-weight: 600; }

  @media (max-width: 900px) {
    .attio-steps-grid { grid-template-columns: 1fr; }
    .attio-section-head { padding: 4rem 1.5rem 2.5rem 1.5rem; }
    .attio-step-cell { padding: 2.25rem 1.5rem; }
    .attio-console-strip { flex-direction: column; align-items: flex-start; gap: 0.75rem; padding: 1.25rem 1.5rem; }
    .attio-hatch-container { padding: 0 1rem; }
  }

  @media (max-width: 600px) {
    .attio-hatch-container { padding: 0; }
    .attio-grid-wrap { border-left: none; border-right: none; }
  }
</style>
