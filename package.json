{
  "name": "lamanisync-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Secure bridge between authenticated cloud CMS tabs and LamaniHub",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:manifests": "node scripts/build-manifests.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:contract": "node scripts/test-contract.js",
    "test:e2e": "node scripts/test-e2e.js",
    "scan:phi": "node scripts/scan-phi.js",
    "package": "node scripts/package.js",
    "mock:cms": "node test-harness/mock-cms/server.js",
    "mock:sync": "node test-harness/mock-sync-api/server.js",
    "mocks": "node test-harness/run-all.js"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.2.0",
    "@types/chrome": "^0.3.0",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  },
  "packageManager": "pnpm@11.2.2+sha512.36e6621fad506178936455e70247b8808ef4ec25797a9f437a93281a020484e2607f6a469a22e982987c3dbb8866e3071514ab10a4a1749e06edcd1ec118436f"
}
